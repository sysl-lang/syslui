module sh.sysl.ui

import sysl.buf.{Buf, buf}

// A row of titles along the top of something, each opening a dropdown of actions.
//
//     val open = signal(NO_MENU)
//
//     menu_bar([
//         menu("File", [
//             item("New", new_file, "Ctrl+N"),
//             item("Save", save, "Ctrl+S", enabled = dirty.read()),
//             separator(),
//             item("Quit", quit)
//         ]),
//         menu("Edit", [item("Undo", undo, "Ctrl+Z")])
//     ], open)
//
// **Which menu is open is the application's**, like which tab is chosen: a bar keeping its own would
// lose it the first time anything else was written. The rest is decided while painting, because only
// then is it known where a title landed.
//
// **The bar goes above the catcher, and that one ordering is the whole of how a menu bar differs from
// a row of popovers.** A popover's catcher has to beat its anchor, so that a click on the anchor closes
// it once rather than toggling it twice; a bar wants the opposite, because its titles stay live while a
// menu is open. So while one is open the bar is raised rather than painted: the catcher goes up first,
// then the bar, then the dropdown, and last-wins does the rest. An agent reading a snapshot sees the
// titles as uncovered for the same reason a click reaches them.
//
// **Moving onto another title is read from the pointer rather than from a hit region**, because
// `Canvas.hovered` is geometry: a catcher takes taps and has no say over where the pointer is.

// No menu is open: what the application's signal starts at.
const NO_MENU: int = -1

// One row of a menu.
enum MenuItem
    Action(label: string, run: &Fn() -> unit, shortcut: string, enabled: bool, checked: Option[bool])
    Separator
end MenuItem

// A row that does something when chosen.
//
// **`shortcut` is only a label.** Which keys do what is the application's, for the reason ⌘C is not in
// `key.sysl`: only the application knows what its shortcuts are.
item(label: string, run: &Fn() -> unit, shortcut: string = "", enabled: bool = true) -> MenuItem =
    MenuItem.Action(label, run, shortcut, enabled, None)

// A row that does something when chosen and says whether it is on: View -> Grid, with a tick beside it
// while the grid is showing.
//
// **`on` is what the tick shows; `run` is what flips it**, so the application keeps the state, as it
// does for every other row. **A menu with any `toggle` reserves a column for the tick on every row**,
// the way a Mac menu does, so the labels line up and do not move when `on` changes; a menu with none
// is drawn exactly as it always was. That is why this is a constructor of its own rather than a
// `checked` flag on `item`: a flag that defaults to false cannot tell "off" from "not a toggle".
toggle(label: string, run: &Fn() -> unit, on: bool, shortcut: string = "", enabled: bool = true) -> MenuItem =
    MenuItem.Action(label, run, shortcut, enabled, Some(on))

// A rule between two groups of rows. It is drawn where it is written, first or last included.
separator() -> MenuItem = MenuItem.Separator

// A title and what it opens.
struct Menu
    title: string
    items: Buf[MenuItem]

menu(title: string, items: []const MenuItem) -> Menu
    var b: Buf[MenuItem] = buf()

    b.extend(items)
    Menu(title, b)
end menu

// The bar. `open` holds the index of the open menu, or `NO_MENU`; a value naming no menu reads as
// closed. A snapshot reports each title as `menu.<title>` and each row as `menu.<title>.<label>`.
menu_bar(menus: []const Menu, open: &Signal[int]) -> &View
    var b: Buf[Menu] = buf()

    b.extend(menus)
    MenuBar(b, open)
end menu_bar

private struct MenuBar
    menus: Buf[Menu]
    open: &Signal[int]

    // The titles and the rule under them, with the title at `at` lit and reported as chosen.
    //
    // **Square whatever the theme rounds by**, since a bar runs edge to edge. The flexible gap keeps
    // the titles at the left, as it does for `tabs`.
    private bar(&self, at: int) -> &View
        var titles: Buf[&View] = buf()
        val v = self.menus.view()

        for i in 0..<v.len
            titles.push(menu_title(v[i].title, int(i), at == int(i), self.open))

        titles.push(spacer())

        column([row(titles.view(), 0), divider()], 0)
            .panel()
            .restyle(t -> t with { radius = 0 })
    end bar

    // Where the title at `at` lands in a bar painted at `r`.
    private title_at(&self, c: *Canvas, r: Rect, at: int) -> Rect
        val v = self.menus.view()
        var x = r.x
        var w = 0

        for i in 0..at
            w = menu_title(v[i].title, i, false, self.open).measure(c, Size(r.w, r.h)).w

            if i < at then x += w

        Rect(x, r.y, w, r.h)
    end title_at

    // Which menu is showing this frame, having let Escape and the pointer move it.
    //
    // **The signal is written only when the answer changes**, as the slider's is, and the frame paints
    // the new answer rather than waiting for the next one. A snapshot only reports, so it moves nothing.
    private showing(&self, c: *Canvas, r: Rect) -> int
        val now = self.open.read()
        val n = int(self.menus.view().len)

        if now < 0 || now >= n then return NO_MENU

        c.survey() match
            Some(_) -> return now
            None -> ()

        for p in c.keys()
            if p.key == Key.Escape
                self.open.set(NO_MENU)

                return NO_MENU

        // **The pointer itself, not `hovered`**: the bar being painted here is in the tree, and the
        // titles the pointer is moving between are the raised copy above this bar's own catcher.
        val (x, y) = c.pointer()

        for i in 0..<n
            if i != now && self.title_at(c, r, i).holds(x, y)
                self.open.set(i)

                return i

        now
    end showing

impl View for MenuBar
    // **The bar's own size and never a dropdown's**, as a popover measures to its anchor.
    measure(&self, c: *Canvas, avail: Size) -> Size = self.bar(NO_MENU).measure(c, avail)

    // **As tall as it measures, whatever it was given**: a bar handed the whole window as the root of a
    // tree must not paint a panel over all of it, and its dropdowns open under the rule, not the window.
    paint(&self, c: *Canvas, given: Rect)
        val r = given with { h = self.bar(NO_MENU).measure(c, Size(given.w, given.h)).h }
        val at = self.showing(c, r)

        if at == NO_MENU
            self.bar(NO_MENU).paint(c, r)

            return

        val shut = self.open
        val chosen = self.menus.view()[at]

        val up = any_open(shut, int(self.menus.view().len))

        c.raise_above(up_while(spacer().on_tap(() -> shut.set(NO_MENU)), up), EVERYWHERE)
        c.raise_above(up_while(self.bar(at), up), r)

        if chosen.items.view().len == 0 then return

        val title = self.title_at(c, r, at)

        val drop = dropdown(chosen, () -> shut.set(NO_MENU), c.theme())
        val s = drop.measure(c, Size(1_000_000, 1_000_000))
        val w = if s.w > title.w then s.w else title.w
        val place = Rect(kept_inside(title.x, w, r), r.bottom(), w, s.h)

        // **A second catcher, the dropdown's own size, that does nothing**: it is what keeps a tap on a
        // disabled row, a separator or the margin from reaching the catcher that closes.
        c.raise_above(up_while(spacer().on_tap(() -> ()), up), place)
        c.raise_above(up_while(drop, up), place)
    end paint

// Whether any menu is open, rather than this one: moving between titles must not uncover the page.
private any_open(open: &Signal[int], n: int) -> &Fn() -> bool =
    () -> open.read() >= 0 && open.read() < n

// Slide a dropdown left until it ends where the bar ends, and never past where the bar starts.
//
// **The bar stands in for the window**, because a canvas does not know how big its surface is and a
// bar runs edge to edge. One narrower than its window keeps its dropdowns over itself.
private kept_inside(x: int, w: int, r: Rect) -> int
    val over = x + w - r.right()
    val moved = if over > 0 then x - over else x

    if moved < r.x then r.x else moved
end kept_inside

private menu_title(title: string, at: int, on: bool, open: &Signal[int]) -> &View =
    Named(Tappable(reactive((i, t) -> title_face(t, title, on, i)),
                   () -> open.set(if open.read() == at then NO_MENU else at), MENU_TITLE, on),
          s"menu.${title}")

private title_face(t: Theme, title: string, on: bool, i: Interaction) -> &View =
    text(title)
        .foreground(t.ink)
        .padding(t.pad)
        .background(mix(t.panel, t.table.hover, if on then 100 else int(i.hover * 100.0)))

// The rows of a menu in their panel. `shut` closes whatever opened it, a bar's menu or a context
// menu, and runs before the row's action.
private[ui] dropdown(m: Menu, shut: &Fn() -> unit, t: Theme) -> &View
    var rows: Buf[&View] = buf()

    var column_for_ticks = false

    for it in m.items.view()
        it match
            Action(_, _, _, _, checked) -> if checked.is_some() then column_for_ticks = true
            Separator -> ()

    for it in m.items.view()
        rows.push(menu_row(m.title, it, shut, t, column_for_ticks))

    column(rows.view(), 0)
        .pad(top = t.pad / 2, bottom = t.pad / 2)
        .panel()
        .border(t.edge, 1, t.radius)
end dropdown

private menu_row(title: string, it: MenuItem, shut: &Fn() -> unit, t: Theme, ticks: bool) -> &View =
    it match
        Separator -> divider().pad(top = t.pad / 2, bottom = t.pad / 2)
        Action(label, run, shortcut, enabled, checked) ->
            val face = reactive((i, th) -> row_face(th, label, shortcut, enabled, i, ticks, checked))
            val name = s"menu.${title}.${label}"

            // Closed first, so an action that opens something else is not undone by the closing.
            val pick: &Fn() -> unit = () ->
                shut()
                run()

            if enabled then Named(Tappable(face, pick, MENU_ROW, false), name)
            else Named(DisabledRow(face), name)

private row_face(t: Theme, label: string, shortcut: string, enabled: bool, i: Interaction, ticks: bool,
                       checked: Option[bool]) -> &View
    val ink = if enabled then t.ink else mix(t.ink, t.panel, MENU_DIM)
    val words = text(label).foreground(ink)

    // **Two gaps of `pad` between a label and its shortcut**, one each side of the flexible one, so
    // the widest row still separates them and every shortcut ends at the same right edge.
    val inside = if shortcut.len == 0 then words else row([
        words,
        spacer(),
        text(shortcut).foreground(if enabled then mix(t.ink, t.panel, MENU_QUIET) else ink)
    ], t.pad)

    val lined = if ticks then row([Tick(checked.unwrap_or(false), ink), inside], 0) else inside

    lined
        .pad(top = t.pad / 2, right = t.pad, bottom = t.pad / 2, left = t.pad)
        .background(mix(t.panel, t.table.hover, if enabled then int(i.hover * 100.0) else 0))
end row_face

// The tick column of a row in a menu that has toggles: a check mark when `on`, and the same room
// when not, so a row's label sits where it does either way.
//
// **Drawn from squares**, since the canvas has rectangles and no paths, and so it does not depend on
// the font having a check glyph. Its measured height is nothing, so it never makes a row taller.
private struct Tick
    on: bool
    ink: u32

impl View for Tick
    measure(&self, c: *Canvas, avail: Size) -> Size = Size(TICK_COLUMN, 0)

    paint(&self, c: *Canvas, r: Rect)
        if !self.on then return

        c.survey() match
            Some(n) -> n.mark("checked")
            None -> ()

        val top = r.y + (r.h - TICK_H) / 2

        // Down and right three steps, then up and right five: each step a two-pixel square.
        val steps: [8][2]int = [[0, 3], [1, 4], [2, 5], [3, 4], [4, 3], [5, 2], [6, 1], [7, 0]]

        for s in steps
            c.fill(Rect(r.x + s[0], top + s[1], 2, 2), self.ink)
    end paint

// The tick's width and the room reserved for it, and its height.
private const TICK_COLUMN: int = 16
private const TICK_H: int = 7

// A row that is reported and takes no tap of its own, so the tap falls to the dropdown's catcher.
private struct DisabledRow
    child: &View

impl View for DisabledRow
    measure(&self, c: *Canvas, avail: Size) -> Size = self.child.measure(c, avail)

    paint(&self, c: *Canvas, r: Rect)
        c.survey() match
            Some(s) ->
                s.open(MENU_ROW, r, Words.Label, "", "disabled")
                self.child.paint(c, r)
                s.close()
            None -> self.child.paint(c, r)
    end paint

// A view whose right-click opens a menu where the pointer is.
//
//     val at: &Signal[Option[(int, int)]] = signal(None)
//
//     board.context_menu(at, [
//         item("Rotate", rotate, "R"),
//         item("Delete", delete, "⌫"),
//     ])
//
// **Where it is open is the application's**, as which menu of a bar is open is: `None` is closed, and
// `Some((x, y))` is open at that point in the view's coordinates. A right-click (the secondary button)
// inside the view writes the point it went down at, and closing writes `None`. An application that
// opens it from a key, or wants to know what was under the click, reads and writes the same signal,
// and the items can be built from it: the tree is built again each frame.
//
// **It closes the ways a menu closes**: choosing a row, a tap anywhere else, `Escape`, and a right-click
// outside the view. A right-click elsewhere inside the view moves it there, as it does on every desktop.
// **It is kept inside the view it is attached to**, opening left of the point or above it where it
// would cross the view's edge, because a canvas does not know how big its window is. Attached to the
// root, that is the window. A snapshot reports each row as `menu.<title>.<label>`.
private[ui] struct ContextMenu
    child: &View
    at: &Signal[Option[(int, int)]]
    items: Buf[MenuItem]
    title: string

impl View for ContextMenu
    measure(&self, c: *Canvas, avail: Size) -> Size = self.child.measure(c, avail)

    paint(&self, c: *Canvas, r: Rect)
        self.child.paint(c, r)

        val shut = self.at
        val surveying = c.survey().is_some()

        if !surveying && c.tapped_by(r, PointerButton.Secondary)
            shut.set(Some(c.tap_point_by(PointerButton.Secondary)))

        val (x, y) = shut.read() match
            Some(p) -> p
            None -> return

        if !surveying
            for p in c.keys()
                if p.key == Key.Escape
                    shut.set(None)

                    return

        val up: &Fn() -> bool = () -> shut.read().is_some()
        val drop = dropdown(Menu(self.title, self.items), () -> shut.set(None), c.theme())
        val s = drop.measure(c, Size(1_000_000, 1_000_000))
        val place = Rect(opened_at(x, s.w, r.x, r.right()), opened_at(y, s.h, r.y, r.bottom()), s.w, s.h)

        c.raise_above(up_while(Dismisser(spacer().on_tap(() -> shut.set(None)), shut, r), up), EVERYWHERE)

        // **A second catcher, the dropdown's own size, that does nothing**, as a bar's menu has: a tap
        // on a disabled row, a separator or the margin must not reach the one that closes.
        c.raise_above(up_while(spacer().on_tap(() -> ()), up), place)
        c.raise_above(up_while(drop, up), place)
    end paint

// Where a menu `size` long opens from a point at `p`, between `lo` and `hi`: from the point where it
// fits, ending at it where it does not, and never before `lo`.
private[ui] opened_at(p: int, size: int, lo: int, hi: int) -> int
    val at = if p + size <= hi then p else p - size

    if at < lo then lo else at
end opened_at

// The catcher under an open context menu: a tap closes it, as `tap` does, and a right-click moves it
// to where it went down if that is inside the view it belongs to, and closes it if not. **Raised above
// the view**, so the view's own right-click is covered while the menu is up and this is what hears it.
private struct Dismisser
    tap: &View
    at: &Signal[Option[(int, int)]]
    within: Rect

impl View for Dismisser
    measure(&self, c: *Canvas, avail: Size) -> Size = self.tap.measure(c, avail)

    paint(&self, c: *Canvas, r: Rect)
        self.tap.paint(c, r)

        if c.survey().is_some() || !c.tapped_by(r, PointerButton.Secondary) then return

        val (x, y) = c.tap_point_by(PointerButton.Secondary)

        self.at.set(if self.within.holds(x, y) then Some((x, y)) else None)
    end paint

// What a snapshot calls a title and a row.
private const MENU_TITLE: string = "menu"
private const MENU_ROW: string = "menu_item"

// How far a disabled row's text and an enabled row's shortcut are mixed toward the panel.
private const MENU_DIM: int = 55
private const MENU_QUIET: int = 30
