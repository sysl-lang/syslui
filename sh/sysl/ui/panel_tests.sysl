module sh.sysl.ui
@tests

import sh.sysl.plutovg

// ## `panel(radius)`, `ground` and `ground_role`

private const WINDOW: u32 = 0x010203

private argb(s: &plutovg.Surface, x: int, y: int) -> u32
    val d = s.data()
    val at = usize(y * s.stride() + x * 4)

    u32(d[at]) | (u32(d[at + 1]) << 8) | (u32(d[at + 2]) << 16) | (u32(d[at + 3]) << 24)

private opaque(c: u32) -> u32 = 0xFF000000u32 | c

// Paints `v` into a 40x30 point area over a window ground, under `t`, at density `k`, and answers
// the pixel at point (x, y).
private pixel(v: &View, t: Theme, k: int, x: int, y: int) -> u32
    val surf = plutovg.surface(40 * k, 30 * k).unwrap()
    var c = pluto_canvas(plutovg.canvas(surf).unwrap(), some_face(), 15.0)

    c.vg.scale(f32(k), f32(k))
    c.fill(Rect(0, 0, 40, 30), WINDOW, 0)
    v.restyle(_ -> t).paint(&c, Rect(0, 0, 40, 30))
    argb(surf, x * k, y * k)
end pixel

private themes() -> [2]Theme = [dark(), light()]

private some_face() -> &plutovg.Font
    val found = ["/System/Library/Fonts/Supplemental/Arial.ttf",
                 "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf"]
    var face: Option[&plutovg.Font] = None

    for i in 0..<found.len
        if face.is_none() then face = plutovg.font(found[i])

    assert(face.is_some(), "a face to measure with")
    face.unwrap()
end some_face

private recorded_panel(v: &View) -> string
    var c = recorder()

    v.paint(&c, Rect(0, 0, 40, 20))
    c.dump()
end recorded_panel

@test
private a_default_panel_draws_exactly_as_before()
    assert(recorded_panel(spacer().panel()).contains(s"fill 0,0 40x20 #${dark().panel} r6"), "dark")
    assert(recorded_panel(spacer().panel(-1)) == recorded_panel(spacer().panel()), "-1 is the default")
    assert(recorded_panel(spacer().panel(3)).contains(s"#${dark().panel} r3"), "an explicit radius")
end a_default_panel_draws_exactly_as_before

@test
private a_square_panel_has_no_radius_and_follows_the_theme()
    assert(recorded_panel(spacer().panel(0)).contains(s"fill 0,0 40x20 #${dark().panel}"), "flat")
    assert(!recorded_panel(spacer().panel(0)).contains(" r"), "no radius")
    assert(recorded_panel(spacer().panel(0).restyle(t -> light())).contains(s"#${light().panel}"), "light")
end a_square_panel_has_no_radius_and_follows_the_theme

@test
private the_corner_pixel_of_a_square_panel_is_the_panel_colour_under_both_themes_at_both_densities()
    val ts = themes()

    for k in 1..<3
        for i in 0..<ts.len
            val t = ts[i]

            assert(pixel(spacer().panel(0), t, k, 0, 0) == opaque(t.panel), s"square top-left, theme ${i}, scale ${k}")
            assert(pixel(spacer().panel(0), t, k, 39, 29) == opaque(t.panel), s"square bottom-right, theme ${i}, scale ${k}")

            // And the default panel's corner really is the window ground, so the check can fail.
            assert(pixel(spacer().panel(), t, k, 0, 0) == opaque(WINDOW), s"rounded corner shows the window, theme ${i}, scale ${k}")
            assert(pixel(spacer().panel(), t, k, 20, 15) == opaque(t.panel), s"rounded middle, theme ${i}, scale ${k}")
end the_corner_pixel_of_a_square_panel_is_the_panel_colour_under_both_themes_at_both_densities

@test
private a_square_panel_nested_in_a_split_row_is_flat_at_the_window_edge()
    val v = split_row([sized(spacer().panel(0), signal(20), 5, 30), flexed(spacer().panel(0))])

    for k in 1..<3
        assert(pixel(v, dark(), k, 0, 0) == opaque(dark().panel), s"left pane corner, scale ${k}")
        assert(pixel(v, dark(), k, 0, 29) == opaque(dark().panel), s"left pane bottom corner, scale ${k}")
        assert(pixel(v, dark(), k, 39, 0) == opaque(dark().panel), s"right pane corner, scale ${k}")
end a_square_panel_nested_in_a_split_row_is_flat_at_the_window_edge

@test
private a_zero_size_panel_paints_without_trouble()
    var c = recorder()

    spacer().panel(0).paint(&c, Rect(0, 0, 0, 0))
    spacer().panel(1000).paint(&c, Rect(0, 0, 4, 4))
    assert(c.dump().contains("fill"), "painted")
end a_zero_size_panel_paints_without_trouble

@test
private ground_resolves_through_the_current_theme()
    val v = spacer().ground(t -> t.edge)

    assert(recorded_panel(v).contains(s"#${dark().edge}"), "dark")
    assert(recorded_panel(v.restyle(t -> light())).contains(s"#${light().edge}"), "light")
    assert(recorded_panel(spacer().ground(t -> t.alt, 4)).contains(s"#${dark().alt} r4"), "radius")
end ground_resolves_through_the_current_theme

@test
private ground_role_resolves_through_the_current_theme()
    val v = spacer().ground_role(Role.Accent)

    assert(recorded_panel(v).contains(s"#${dark().accent}"), "dark")
    assert(recorded_panel(v.restyle(t -> light())).contains(s"#${light().accent}"), "light")
    assert(pixel(v, light(), 2, 0, 0) == opaque(light().accent), "pixels at scale 2")
end ground_role_resolves_through_the_current_theme

// ## `outline` and `outline_role`

// The pixel `x` points in along the top edge of a 40x30 area outlined by `v`, under `t`.
@test
private outline_matches_border_draw_for_draw()
    val a = recorded_panel(spacer().outline(t -> t.edge, 2, 5, 3))
    val b = recorded_panel(spacer().border(dark().edge, 2, 5, 3))

    assert(a == b, s"${a} vs ${b}")
    assert(recorded_panel(spacer().outline(t -> t.edge)) == recorded_panel(spacer().border(dark().edge)), "defaults")
end outline_matches_border_draw_for_draw

@test
private outline_resolves_through_the_current_theme_light_and_dark()
    val v = spacer().outline(t -> t.edge)

    assert(recorded_panel(v).contains(s"stroke 0,0 40x20 #${dark().edge} w1"), "dark")
    assert(recorded_panel(v.restyle(t -> light())).contains(s"#${light().edge} w1"), "light")
    assert(dark().edge != light().edge, "the two themes have distinct separators")
end outline_resolves_through_the_current_theme_light_and_dark

@test
private outline_follows_the_nearest_restyle_above_it()
    val v = spacer().outline(t -> t.edge).restyle(t -> light()).restyle(t -> dark())

    assert(recorded_panel(v).contains(s"#${light().edge} w1"), "the nearest restyle wins")
    assert(recorded_panel(spacer().outline(t -> t.edge).restyle(t -> t with { edge = 0x123456 }))
               .contains(s"#${u32(0x123456)} w1"), "a changed field")
end outline_follows_the_nearest_restyle_above_it

@test
private outline_role_resolves_through_the_current_theme()
    val v = spacer().outline_role(Role.Accent, 3, 2)

    assert(recorded_panel(v).contains(s"#${dark().accent} w3 r2"), "dark")
    assert(recorded_panel(v.restyle(t -> light())).contains(s"#${light().accent} w3 r2"), "light")
end outline_role_resolves_through_the_current_theme

@test
private outline_is_drawn_over_the_child_and_measures_as_it_does()
    val v = spacer().ground(t -> t.alt).outline(t -> t.edge)
    val d = recorded_panel(v)

    assert(d.index_of("fill").unwrap() < d.index_of("stroke").unwrap(), "stroke after fill")
    var c = recorder()
    assert(v.measure(&c, Size(30, 20)) == spacer().measure(&c, Size(30, 20)), "measure unchanged")
end outline_is_drawn_over_the_child_and_measures_as_it_does

@test
private a_zero_size_or_zero_width_outline_paints_without_trouble()
    var c = recorder()

    spacer().outline(t -> t.edge).paint(&c, Rect(0, 0, 0, 0))
    spacer().outline(t -> t.edge, 0).paint(&c, Rect(0, 0, 10, 10))
    spacer().outline(t -> t.edge, 1000, 1000).paint(&c, Rect(0, 0, 4, 4))
    assert(c.dump().contains("stroke"), "painted")
end a_zero_size_or_zero_width_outline_paints_without_trouble

@test
private outline_pixels_are_the_theme_colour_at_both_densities()
    val v = spacer().outline(t -> t.edge, 2)
    val ts = themes()

    for k in 1..<3
        for i in 0..<2
            assert(pixel(v, ts[i], k, 0, 15) == opaque(ts[i].edge), s"left edge theme ${i} scale ${k} got ${pixel(v, ts[i], k, 0, 15)}")
            assert(pixel(v, ts[i], k, 20, 0) == opaque(ts[i].edge), s"top edge theme ${i} scale ${k}")
            assert(pixel(v, ts[i], k, 20, 15) == WINDOW | 0xFF000000u32, s"interior untouched theme ${i} scale ${k}")
end outline_pixels_are_the_theme_colour_at_both_densities

// ## A border's ink lies wholly inside its rectangle, at any width and density

@test
private a_border_is_whole_pixels_at_widths_one_and_three_in_both_themes_and_densities()
    val ts = themes()

    for k in 1..<3
        for i in 0..<2
            for w in [1, 3]
                val v = spacer().outline(t -> t.edge, w)
                val e = opaque(ts[i].edge)
                val win = opaque(WINDOW)

                for j in 0..<w
                    assert(pixel(v, ts[i], k, j, 15) == e, s"left col ${j} w${w} theme ${i} scale ${k}")
                    assert(pixel(v, ts[i], k, 39 - j, 15) == e, s"right col ${j} w${w} theme ${i} scale ${k}")
                    assert(pixel(v, ts[i], k, 20, j) == e, s"top row ${j} w${w} theme ${i} scale ${k}")
                    assert(pixel(v, ts[i], k, 20, 29 - j) == e, s"bottom row ${j} w${w} theme ${i} scale ${k}")

                assert(pixel(v, ts[i], k, w, 15) == win, s"inside of w${w} untouched theme ${i} scale ${k}")
end a_border_is_whole_pixels_at_widths_one_and_three_in_both_themes_and_densities

@test
private a_rounded_and_a_dashed_border_keep_their_shape_on_the_real_canvas()
    val ts = themes()

    for k in 1..<3
        for i in 0..<2
            val e = opaque(ts[i].edge)
            val round = spacer().outline(t -> t.edge, 1, 8)

            assert(pixel(round, ts[i], k, 20, 0) == e, s"round top edge scale ${k}")
            assert(pixel(round, ts[i], k, 0, 15) == e, s"round left edge scale ${k}")
            assert(pixel(round, ts[i], k, 0, 0) == opaque(WINDOW), s"corner is cut by the curve scale ${k}")

            val dashed = spacer().outline(t -> t.edge, 2, 0, 4)

            var inked = 0
            var bare = 0

            for y in 4..<26
                if pixel(dashed, ts[i], k, 0, y) == e then inked += 1 else bare += 1

            assert(inked > 0 && bare > 0, s"dashes and gaps along the left edge scale ${k}: ${inked}/${bare}")
end a_rounded_and_a_dashed_border_keep_their_shape_on_the_real_canvas
