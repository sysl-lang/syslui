module sh.sysl.ui

import sysl.math.Float
import sysl.seq.{Sequence, generate}

// The controls, and what they are all made of.
//
// **Every widget here is the same four things**: a size it asks for, some filled rounded rectangles,
// a question put to the canvas about the pointer, and -- where the answer should not arrive all at
// once -- a phase easing toward it. There is nothing else, because `Canvas` offers nothing else, and
// that is the constraint the whole toolkit was designed around rather than a shortage to apologise
// for: a switch drawn as two rounded rectangles is a switch on a phone, on a desktop, and on
// anything else that can fill a span of pixels.
//
// **A control owns no state and the application owns all of it**, which is `scroll.sysl`'s finding
// applied everywhere: a `&Signal[bool]` is passed in, the widget reads it while painting and writes
// it when tapped, and a rebuild between those two moments changes nothing because the widget was
// never where the value lived. That is what makes a control safe to throw away and build again sixty
// times a second.
//
// **The action closure is made once, at build, not once per frame.** A control that wrote
// `c.hit(r, () -> on.set(!on.read()))` inside `paint` would allocate a box every frame per widget,
// which is exactly the churn card 0203 was filed to measure; making it in the constructor and
// storing it costs one field and turns a per-frame allocation into a per-rebuild one.

// The sizes, which a theme would own.
//
// They are constants for the same reason `style.sysl`'s three lifts are: naming them is most of the
// work of gaining a theme, and until there is one, a number with a name is worth more than the same
// number written into four paint methods.
const SWITCH_W: int = 44
const SWITCH_H: int = 24
const BOX_SIDE: int = 18
const TRACK_H: int = 6
const KNOB: int = 16
const METER_H: int = 20
const NEEDLE_W: int = 4
const TICK_W: int = 2

// Which animation on a control is which, in the canvas's store.
//
// **A slot is only ever compared against others on the same rectangle**, so these could have started
// at zero and collided with `style.sysl`'s two harmlessly -- no `Reactive` and no control ever share
// a rectangle. They start past them anyway, because a number that cannot collide is worth more to
// somebody debugging than one that merely does not.
private const SWITCH_SLOT: int = 2
private const CHECK_SLOT: int = 3
private const KNOB_SLOT: int = 4
private const FILL_SLOT: int = 5
private const DOT_SLOT: int = 6
private const NEEDLE_SLOT: int = 7

// Which grabbable thing a slider is, in the canvas's single grab. Slots are a namespace of their
// own here rather than shared with the animation slots above, because they are stored apart.
private const DRAG_SLOT: int = 0

// How fast each settles. A switch and a checkbox are direct responses to a tap, so they move at the
// press rate; a progress bar is reporting on something else's pace and should not look hurried.
private const FLIP_RATE: real = 14.0
private const PROGRESS_RATE: real = 4.0

// A meter's needle is reporting a reading that may change every frame, so it settles faster than a
// progress bar -- quick enough to follow, slow enough that a jittery input reads as a needle
// settling rather than a needle shaking.
private const NEEDLE_RATE: real = 6.0

// Where a control of this size sits in the rectangle it was actually handed.
//
// **A view may be given more than it measured for, and every control here has to say what it does
// about that.** A `Row` gives each child the height of the tallest one and a `Column` gives each
// child the column's full width, so a slider sixteen pixels tall sitting beside a label twenty-six
// tall is handed twenty-six -- and a knob drawn at `r.y` then sits three pixels above the track it
// is supposed to run along, which is exactly the sort of thing no recording-based test notices and
// a person spots immediately.
//
// Centred vertically and leading horizontally: a control is a thing on a line of other things, so
// the axis it shares with its neighbours is the one it lines up on, and the other is where it
// starts. It never draws larger than it was given, whatever it asked for.
private inside(r: Rect, w: int, h: int) -> Rect =
    Rect(r.x, r.y + (r.h - h) / 2, if r.w < w then r.w else w, if r.h < h then r.h else h)

// ## The switch

// A two-state control that slides, drawn as a pill with a circle in it.
//
// **The circle is a rounded rectangle whose radius is half its side**, which is the whole reason
// `fill` took a radius rather than a shape: a backend that can round a corner can draw every control
// in this file, and one that could not would need a path API before it could draw the first.
struct Switch
    on: &Signal[bool]

    // **A role rather than a colour, because a caller cannot see the theme.** Every control here
    // takes one, so a form of green switches is `switch(a, .Success)` a line rather than a colour
    // repeated and then stranded when the theme changes.
    role: Role

    // Made once, at build. See the note at the top of the file.
    flip: &Fn() -> unit

impl View for Switch
    measure(&self, c: *Canvas, avail: Size) -> Size = Size(SWITCH_W, SWITCH_H)

    paint(&self, c: *Canvas, r: Rect)
        // **The knob's position and the track's colour are one number**, so the two cannot disagree
        // half way through: a switch caught mid-slide has its knob exactly as far across as its
        // track is coloured, because both read the same phase.
        val look = c.theme()
        val t = c.phase(r, SWITCH_SLOT, if self.on.read() then 1.0 else 0.0, FLIP_RATE)
        val lit = c.phase(r, KNOB_SLOT, if c.hovered(r) then 1.0 else 0.0, HOVER_RATE)

        val b = inside(r, SWITCH_W, SWITCH_H)
        val pad = 3
        val d = b.h - 2 * pad
        val travel = b.w - 2 * pad - d

        c.fill(b, mix(look.inert, look.color(self.role), int(t * 100.0)), b.h / 2)
        c.fill(Rect(b.x + pad + int(t * real(travel)), b.y + pad, d, d),
               darken(WHITE, int((1.0 - lit) * 8.0)), d / 2)

        // **The whole of what it was given answers to a tap, not just the pill.** A control given
        // more room than it draws in is still the thing at that place on the line.
        c.hit(r, self.flip)
    end paint

// A switch bound to a boolean the application owns.
switch(on: &Signal[bool], role: Role = Role.Primary) -> &View =
    Switch(on, role, () -> on.set(!on.read()))

// ## The checkbox

// The box half of a checkbox: an outline that fills in when the value is true.
//
// **The tick is a square that grows rather than a check mark**, and that is a limit of `Canvas`
// stated rather than hidden: two strokes at an angle need a path, and the surface has rectangles. A
// square that scales from nothing to nearly the whole box reads as "this one" at every size a
// control is drawn at, which is what the mark is for.
//
// It takes the `Interaction` as a field because it is rebuilt by a `Reactive` on every paint -- the
// hover it draws is the *row's*, so that pointing at the label lights the box.
struct Box
    on: &Signal[bool]
    role: Role
    i: Interaction

impl View for Box
    measure(&self, c: *Canvas, avail: Size) -> Size = Size(BOX_SIDE, BOX_SIDE)

    paint(&self, c: *Canvas, r: Rect)
        val look = c.theme()
        val color = look.color(self.role)
        val b = inside(r, BOX_SIDE, BOX_SIDE)
        val t = c.phase(b, CHECK_SLOT, if self.on.read() then 1.0 else 0.0, FLIP_RATE)
        val edge = mix(look.inert, color, int(t * 100.0))

        c.fill(b, mix(look.ground, color, int(t * 100.0)), 4)
        c.stroke(b, lighten(edge, int(self.i.hover * 20.0)), 2, 4)

        // The mark, inset by however much of the way in it has got. At rest it has no area at all,
        // which is what makes an unchecked box an outline and nothing else.
        val inset = int((1.0 - t) * real(b.w) / 2.0) + 5
        val side = b.w - 2 * inset

        if side > 0 then c.fill(Rect(b.x + inset, b.y + inset, side, side), look.on_fill, 2)
    end paint

// A checkbox and its label, tappable as one thing.
//
// **The whole row is the `Reactive`, so pointing anywhere on it lights the box** -- which is what
// makes the label part of the control rather than text sitting beside one. That is the composition
// `style.sysl` was written for, arriving somewhere other than a button: a state-dependent view
// wrapping a container wrapping a state-dependent leaf, and no widget had to be told about another.
checkbox(on: &Signal[bool], label: string, role: Role = Role.Primary) -> &View
    val flip: &Fn() -> unit = () -> on.set(!on.read())

    reactive((i, t) -> row([Box(on, role, i), text(label)], 8)).on_tap(flip)

// ## The radio button

// The circle half of a radio button: a ring that fills with a dot when its option is the chosen one.
//
// **It is `Box` with two radii changed, and that is the argument for these being two views rather
// than one with a shape field.** A checkbox and a radio differ in one thing a person can see --
// square or round -- and in one they cannot: a checkbox owns its value, and a radio owns only
// *which* value, so the state it draws from is a comparison rather than a flag. Folding them
// together would mean a signal that was sometimes a `bool` and sometimes an `int`, which is two
// controls wearing one name.
//
// **Which option is chosen is read while painting rather than captured at build**, exactly as a
// checkbox's value is. `tabs.sysl` does the opposite deliberately, because a tab bar builds a panel
// beside its headers and the two must agree on the same frame; a radio builds nothing but itself, so
// a live read has nothing to get out of step with.
struct Dot
    chosen: &Signal[int]
    at: int
    role: Role
    i: Interaction

impl View for Dot
    measure(&self, c: *Canvas, avail: Size) -> Size = Size(BOX_SIDE, BOX_SIDE)

    paint(&self, c: *Canvas, r: Rect)
        val look = c.theme()
        val color = look.color(self.role)
        val b = inside(r, BOX_SIDE, BOX_SIDE)
        val t = c.phase(b, DOT_SLOT, if self.chosen.read() == self.at then 1.0 else 0.0, FLIP_RATE)
        val edge = mix(look.inert, color, int(t * 100.0))

        c.fill(b, mix(look.ground, color, int(t * 100.0)), b.w / 2)
        c.stroke(b, lighten(edge, int(self.i.hover * 20.0)), 2, b.w / 2)

        // The dot, inset by however far in it has got, and rounded to its own half -- **a mark that
        // grew as a square inside a ring would show its corners** on the way in, which is the one
        // line of the checkbox's arithmetic that could not simply be reused.
        val inset = int((1.0 - t) * real(b.w) / 2.0) + 5
        val side = b.w - 2 * inset

        if side > 0 then c.fill(Rect(b.x + inset, b.y + inset, side, side), look.on_fill, side / 2)
    end paint

// One option of a group: a dot and its label, tappable as one thing.
//
// **A radio sets and never clears, which is the whole of what makes it not a checkbox.** Tapping the
// chosen option writes nothing at all, and that guard is the slider's guard for the slider's reason
// rather than a nicety: a write notifies, a notify marks the frame dirty, and an unguarded set would
// repaint the window every time somebody clicked the option that was already on.
//
// **A group is an `int` and its options are indices**, which is `tabs`'s choice made again and for
// the same reason: an application has to name an option somewhere, and an index is the one name
// every list of labels arrives with. A group over an enum is this call with `int(kind)`.
radio(chosen: &Signal[int], at: int, label: string, role: Role = Role.Primary) -> &View
    val pick: &Fn() -> unit = () -> if chosen.read() != at then chosen.set(at)

    reactive((i, t) -> row([Dot(chosen, at, role, i), text(label)], 8)).on_tap(pick)
end radio

// A column of options over one signal, one of them chosen.
//
// **There is no `RadioGroup` view and nothing here is new**, which is `tabs.sysl`'s finding arriving
// a second time. The mutual exclusion a radio group exists for lives entirely in the single `int`
// its options share, so the group is a `column` of them and the invariant belongs to the signal
// rather than to a container. A group that owned a view could not put one option in one half of a
// form and the rest in the other; this one can, because `radio` is callable on its own.
radio_group(labels: []string, chosen: &Signal[int], role: Role = Role.Primary,
            spacing: int = 6) -> &View =
    column(generate(labels.len, i -> radio(chosen, int(i), labels[i], role)), spacing)

// ## The slider

// A value dragged out of a track, and the one control that reads the pointer's position.
//
// **The drag is done during `paint` and the value is written there**, which is worth being plain
// about because it is the only place in the toolkit that writes application state outside a tap. The
// reason is that there is nowhere else: a hit region carries no coordinate, so a control whose value
// *is* a coordinate cannot be served by one, and the pointer's position is only meaningful against a
// rectangle that exists only during paint.
//
// **The write is guarded on the value actually changing**, and that guard is load-bearing rather
// than an optimization: a signal write notifies, an application's notify marks the frame dirty, and
// an unguarded write would mark every frame dirty for as long as a pointer rested on a slider it was
// not moving.
//
// **A drag follows the pointer anywhere, including well outside the track**, which is what `grab`
// is for: the canvas remembers which rectangle the press began in and keeps answering yes until the
// release. Asking `pressed` instead -- which is inside-and-held -- abandoned the drag the moment the
// pointer strayed a few pixels above a track sixteen pixels tall, which is not how any other slider
// anywhere has ever behaved.
//
// **One slider serves every numeric type, because the arithmetic is done in `real` and the answer is
// converted back.** A value is a whole number of `step`s from `lo`, so an `int` slider lands on
// exactly the integers it always did, and a `real` one lands on the grid its step names, or anywhere
// at all when it was given none.
// The conversion in each direction is checked where the slider is instantiated, which is why a
// slider over a type with no conversion to `real` is refused at the call rather than in here.
//
// **The keyboard is opt-in, through an `id`**, for the reason a field's is: keys are routed by a
// number that outlives a relayout, and a slider nobody gave one takes no keys and draws exactly as
// it always did. A focused slider shows its knob lit, as hovering does.
struct Slider[T: Eq + Ord]
    value: &Signal[T]
    lo: T
    hi: T
    width: int
    step: T
    id: int
    role: Role

    // A press on a slider does not *do* anything -- it drags -- but it must not fall through to
    // whatever is behind, so the region is claimed with an action that does nothing.
    grab: &Fn() -> unit

    // The value `d` past `lo` lands on: the nearest whole number of steps, never past either end.
    //
    // **A step that does not divide the range leaves `hi` unreachable**, the last value being the
    // last step that fits -- a value off the grid would be one the keyboard could never return to.
    // A grid point a rounding error past `hi` is still counted as inside, or `0.1` steps from `0.2`
    // to `0.9` would lose their last one to the eighth decimal.
    private snap(self, d: real) -> T
        val span = real(self.hi) - real(self.lo)
        val held = if d < 0.0 then 0.0 elif d > span then span else d
        val s = self.grid()

        // No grid at all: a real slider takes every value the track's pixels can tell apart.
        if s <= 0.0 then return T(real(self.lo) + held)

        // Rounded rather than truncated, so the two ends of the track are reachable and the steps
        // either side of a value are the same width. `held` is never negative, so truncating
        // `+ 0.5` is rounding.
        var n = int(held / s + 0.5)

        if real(n) * s > span + s * 1e-9 then n -= 1

        T(real(self.lo) + real(n) * s)
    end snap

    // **The grid a step of zero leaves is the finest `T` can hold**: none at all for a `real`, and
    // one for an `int`, whose values are whole numbers whatever the slider says. That is why the
    // default step is `T.zero()`, which every `T` has, and why an `int` slider given no step still
    // rounds to the nearest whole number rather than truncating. A type is whole-numbered when converting a half into it loses it.
    private grid(self) -> real
        val s = real(self.step)

        if s > 0.0 then s elif real(T(0.5)) != 0.5 then 1.0 else 0.0

    // How far one key moves the value: a step, or a hundredth of the range where there is none.
    private unit(self) -> real =
        if self.grid() > 0.0 then self.grid() else (real(self.hi) - real(self.lo)) / 100.0

    private put(self, want: T) = if want != self.value.read() then self.value.set(want)

impl[T: Eq + Ord] View for Slider[T]
    measure(&self, c: *Canvas, avail: Size) -> Size = Size(self.width, KNOB)

    paint(&self, c: *Canvas, r: Rect)
        val span = real(self.hi) - real(self.lo)
        val travel = r.w - KNOB

        if self.id != NOBODY && c.tapped(r) then c.take_focus(self.id)

        val mine = self.id != NOBODY && c.focus() == self.id

        if c.grab(r, DRAG_SLOT) && travel > 0 && span > 0.0
            val (px, _) = c.pointer()
            val at = px - r.x - KNOB / 2
            val held = if at < 0 then 0 elif at > travel then travel else at

            self.put(self.snap(real(held) * span / real(travel)))
        elif mine && span > 0.0
            // Each key moves from wherever the last one left the value, so two presses in one
            // frame are two steps.
            for p in c.keys()
                val d = real(self.value.read()) - real(self.lo)

                p.key match
                    Key.Left | Key.Down -> self.put(self.snap(d - self.unit()))
                    Key.Right | Key.Up -> self.put(self.snap(d + self.unit()))
                    Key.Home -> self.put(self.snap(0.0))
                    Key.End -> self.put(self.snap(span))
                    _ -> ()

        val v = self.value.read()
        val clamped = if v < self.lo then self.lo elif v > self.hi then self.hi else v

        // Truncated, as the integer division this replaced was: the numerator is exact, so the
        // knob of an `int` slider lands on the pixel it always did.
        val x =
            if travel > 0 && span > 0.0 then int((real(clamped) - real(self.lo)) * real(travel) / span)
            else 0

        val look = c.theme()
        val color = look.color(self.role)
        val lit = c.phase(r, KNOB_SLOT, if c.hovered(r) || mine then 1.0 else 0.0, HOVER_RATE)

        // **The knob and the track are centred in the same rectangle**, which is the whole reason
        // this control does not draw straight into `r`: they are two shapes that have to share a
        // centre line, and taking that line from anything but one rectangle is how they come apart.
        val b = inside(r, r.w, KNOB)
        val track = Rect(b.x, b.y + (b.h - TRACK_H) / 2, b.w, TRACK_H)

        c.fill(track, look.inert, TRACK_H / 2)
        c.fill(Rect(track.x, track.y, x + KNOB / 2, TRACK_H), color, TRACK_H / 2)
        c.fill(Rect(b.x + x, b.y, KNOB, KNOB), lighten(color, 30 + int(lit * 25.0)), KNOB / 2)
        c.hit(r, self.grab)
    end paint

// A slider over the inclusive range `lo` to `hi`, in multiples of `step` from `lo` -- an `int` or a
// `real` alike: `slider(volume, 0, 100, 260)`, `slider(gain, 0.0, 1.0, 260)`,
// `slider(cutoff, 20.0, 2000.0, 260, step = 10.0)`. A step of zero, the default, is the finest grid
// `T` holds: an `int` slider moves by whole numbers and a `real` one moves continuously. Give it an `id` and arrows, Home and End move it once
// it has been tapped.
slider[T: Eq + Ord + Zero](value: &Signal[T], lo: T, hi: T, width: int, step: T = T.zero(),
               role: Role = Role.Primary, id: int = NOBODY) -> &View =
    Slider(value, lo, hi, width, step, id, role, () -> ())

// ## The two that take no input

// A bar reporting how far along something else is, from zero to one.
//
// **It eases toward the fraction rather than jumping to it**, which is not decoration: a progress
// bar fed by a real task moves in whatever steps the task reports, and a bar that eases turns a
// stuttering series of jumps into something that reads as motion. A backend with no clock draws it
// at the fraction outright, since that is what `phase` answers without one.
struct Progress
    fraction: real
    width: int
    role: Role

impl View for Progress
    measure(&self, c: *Canvas, avail: Size) -> Size = Size(self.width, TRACK_H)

    paint(&self, c: *Canvas, r: Rect)
        val f = if self.fraction < 0.0 then 0.0 elif self.fraction > 1.0 then 1.0 else self.fraction
        val t = c.phase(r, FILL_SLOT, f, PROGRESS_RATE)
        val look = c.theme()
        val b = inside(r, r.w, TRACK_H)

        c.fill(b, look.inert, b.h / 2)

        val w = int(t * real(b.w))

        if w > 0 then c.fill(Rect(b.x, b.y, w, b.h), look.color(self.role), b.h / 2)
    end paint

progress(fraction: real, width: int, role: Role = Role.Primary) -> &View =
    Progress(fraction, width, role)

// A reading on a scale, with the stretch of it that counts as right marked.
//
// **A needle that cannot turn, because nothing here draws at an angle**: the scale is a strip, the
// needle a bar standing across it, and the ticks rules standing across it too. That is a tuner's
// cents display, a balance control's centre-zero readout and a level meter alike, which is why the
// target is a parameter rather than zero written into the paint.
//
// **The needle eases toward the reading, as a progress bar's fill does**, and for a better reason
// here: a meter is usually fed by a measurement, and a measurement jitters. Easing turns frame-to-
// frame noise into a needle settling, which is how the eye wants to read it.
//
// **The colour follows the reading and the position follows the ease.** A needle swinging into the
// band turns as the reading arrives there rather than when the needle does, which is the moment a
// person tuning a string wants to be told. It is also the comparison that is exact at the band's
// edge, where one built from an eased fraction would be a rounding error either side of it.
struct Meter
    value: real
    lo: real
    hi: real
    width: int
    target: real
    band: real
    role: Role

    private frac(self, v: real) -> real = clamped_fraction(v, self.lo, self.hi)

// Where a fraction of the scale lands, in pixels from the left of the needle's travel. Rounded rather
// than truncated, so the two ends are reached and a tick and a needle at one value agree.
private along(f: real, travel: int) -> int = int(f * real(travel) + 0.5)

// Every position on a meter is a fraction of its scale, clamped, so a reading past either end pins
// to it and a band reaching past an end stops there.
private clamped_fraction(v: real, lo: real, hi: real) -> real
    val f = (v - lo) / (hi - lo)
    if f < 0.0 then 0.0 elif f > 1.0 then 1.0 else f

impl View for Meter
    measure(&self, c: *Canvas, avail: Size) -> Size = Size(self.width, METER_H)

    paint(&self, c: *Canvas, r: Rect)
        val look = c.theme()
        val b = inside(r, r.w, METER_H)
        val track = Rect(b.x, b.y + (b.h - TRACK_H) / 2, b.w, TRACK_H)
        val travel = b.w - NEEDLE_W

        // A scale with no length has nowhere to put anything, so it is a bare track.
        if travel <= 0 || !(self.hi > self.lo)
            c.fill(track, look.inert, TRACK_H / 2)
            return

        // The centre of the needle's travel at a fraction, which is where a tick sits too.
        val mid = b.x + NEEDLE_W / 2 - TICK_W / 2
        val major = mix(look.inert, look.ink, 40)
        val aim = along(self.frac(self.target), travel)

        // Ticks first and the track over them, so a tick reads as a mark through the scale. Tenths
        // are the minor ones; the two ends and the target are major, and a tenth that falls on the
        // target is drawn once, as the target's.
        for i in 1..<10
            val at = along(real(i) / 10.0, travel)

            if at != aim then c.fill(Rect(mid + at, b.y + 5, TICK_W, 10), look.inert)

        c.fill(Rect(mid, b.y + 2, TICK_W, 16), major)
        c.fill(Rect(mid + travel, b.y + 2, TICK_W, 16), major)

        if aim != 0 && aim != travel then c.fill(Rect(mid + aim, b.y + 2, TICK_W, 16), major)

        c.fill(track, look.inert, TRACK_H / 2)

        if self.band > 0.0
            val left = along(self.frac(self.target - self.band), travel)
            val right = along(self.frac(self.target + self.band), travel)

            c.fill(Rect(b.x + NEEDLE_W / 2 + left, track.y, right - left, TRACK_H),
                   mix(look.inert, look.success, 55), TRACK_H / 2)

        // A reading that is not a number is no reading, and a needle drawn anywhere would claim one.
        if self.value.is_nan() then return

        val t = c.phase(r, NEEDLE_SLOT, self.frac(self.value), NEEDLE_RATE)
        val inside_band = self.band > 0.0 && self.value >= self.target - self.band &&
                          self.value <= self.target + self.band
        val color = if inside_band then look.success else look.color(self.role)

        c.fill(Rect(b.x + along(t, travel), b.y, NEEDLE_W, METER_H), color, NEEDLE_W / 2)
    end paint

// A meter reading `value` on a scale from `lo` to `hi`, with the stretch within `band` of `target`
// marked as right. A band of zero marks nothing; a target of zero on a scale from `-hi` to `hi` is a
// centre-zero meter.
meter(value: real, lo: real, hi: real, width: int, band: real = 0.0, target: real = 0.0,
      role: Role = Role.Primary) -> &View =
    Meter(value, lo, hi, width, target, band, role)

// A rule across whatever it is given.
//
// **It measures to no width at all and paints across the whole of what it is handed**, which is how
// a divider gets to be as wide as its container without knowing what its container is: a `Column`
// gives every child the column's width, so asking for nothing and drawing everything is the same
// thing as asking to be filled.
struct Rule
    thickness: int

impl View for Rule
    measure(&self, c: *Canvas, avail: Size) -> Size = Size(0, self.thickness)

    paint(&self, c: *Canvas, r: Rect) =
        c.fill(Rect(r.x, r.y, r.w, self.thickness), c.theme().edge)

// A rule in whatever the theme calls an edge. A caller wanting another colour writes
// `divider().restyle(t -> t with { edge = color })`, which is the same request said once for a
// whole section rather than once a line.
divider(thickness: int = 1) -> &View = Rule(thickness)
