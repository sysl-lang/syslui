module sh.sysl.ui

import sysl.buf.{Buf, buf}

// The layout pass: constraints down, sizes up, the parent places.
//
// **One pass, and it is Flutter's rather than a constraint solver's.** A parent hands each child the
// space it may have, the child answers how much of it it wants, and the parent then decides where
// each one goes. There is no second pass and nothing iterates to a fixed point, which is what keeps
// it linear in the number of nodes.
//
// `imui/layout.sysl` is the reference for the arithmetic and for nothing else: it cuts pieces off a
// shrinking rectangle and is deliberately *not* a tree, because immediate mode has no tree to walk.
// What ports is the rectangle algebra. What does not is the shape.
//
// **A container measures its children twice -- once to size itself and once to place them -- and
// that is a real cost this probe is here to expose rather than hide.** Flutter avoids it by caching
// the child's answer against the constraints it was asked with. Doing that here needs somewhere to
// put the cache, and an erased `&View` is shared and immutable, so the cache belongs to a retained
// element rather than to the view. That is question 5's territory and the probe records it rather
// than solving it.

// Children stacked top to bottom, each as tall as it asks to be and as wide as the column.
struct Column
    children: Buf[&View]
    spacing: int
end Column

impl View for Column
    measure(&self, c: *Canvas, avail: Size) -> Size
        var w = 0
        var h = 0
        val v = self.children.view()

        for i in 0..<v.len
            val s = v[i].measure(c, Size(avail.w, avail.h - h))

            if s.w > w then w = s.w

            h += s.h

            if i + 1 < v.len then h += self.spacing

        Size(w, h)
    end measure

    // **A child outside the clip is measured and not painted**, which is what makes a long list
    // affordable: the height is still needed to know where the next child starts, and the drawing --
    // which is nearly all of the cost -- is skipped. A backend that does not track its clip answers
    // `true` and nothing changes but the bill.
    //
    // **And what nobody took is shared between the children that asked for it**, which is what makes
    // a `Spacer` a flexible gap rather than nothing at all. Every child is measured before any is
    // placed, because how much is left over is not known until the last one has answered.
    paint(&self, c: *Canvas, r: Rect)
        val v = self.children.view()
        val (heights, spare, weight) = share(c, v, r.h, self.spacing, true, r.w)
        val hv = heights.view()

        var y = r.y

        for i in 0..<v.len
            val h = hv[i] + stretch(v[i].flex(), spare, weight)
            val at = Rect(r.x, y, r.w, h)

            if c.visible(at) then v[i].paint(c, at)

            y += h + self.spacing
    end paint
end Column

// Children laid left to right, each as wide as it asks to be and as tall as the row.
struct Row
    children: Buf[&View]
    spacing: int
end Row

impl View for Row
    measure(&self, c: *Canvas, avail: Size) -> Size
        var w = 0
        var h = 0
        val v = self.children.view()

        for i in 0..<v.len
            val s = v[i].measure(c, Size(avail.w - w, avail.h))

            if s.h > h then h = s.h

            w += s.w

            if i + 1 < v.len then w += self.spacing

        Size(w, h)
    end measure

    paint(&self, c: *Canvas, r: Rect)
        val v = self.children.view()
        val (widths, spare, weight) = share(c, v, r.w, self.spacing, false, r.h)
        val wv = widths.view()

        var x = r.x

        for i in 0..<v.len
            val w = wv[i] + stretch(v[i].flex(), spare, weight)
            val at = Rect(x, r.y, w, r.h)

            if c.visible(at) then v[i].paint(c, at)

            x += w + self.spacing
    end paint
end Row

// Measure every child along the axis, and say how much room is left and how much of it is wanted.
//
// **One pass over the children before any of them is placed**, which is what a flexible gap costs: a
// container cannot know how much is left over until the last child has answered, so it cannot place
// the first until then. That is the same double measure `layout.sysl` has always done and hidden
// nowhere -- the second pass is the paint itself.
private share(c: *Canvas, v: []&View, along: int, spacing: int, vertical: bool,
              across: int) -> (Buf[int], int, int)
    var sizes: Buf[int] = buf()
    var taken = 0
    var weight = 0
    var left = along

    for i in 0..<v.len
        val avail = if vertical then Size(across, left) else Size(left, across)
        val s = v[i].measure(c, avail)
        val n = if vertical then s.h else s.w

        sizes.push(n)

        taken += n
        weight += v[i].flex()
        left -= n + spacing

    val gaps = if v.len > 0 then (int(v.len) - 1) * spacing else 0
    val spare = along - taken - gaps

    (sizes, if spare > 0 then spare else 0, weight)
end share

// One child's share of the leftover.
//
// **Integer division, so the last pixel or two of a leftover is simply not handed out.** Spreading a
// remainder would put a one-pixel difference between two gaps that are meant to look the same, which
// is more visible than a gap one pixel narrower than it could have been.
private stretch(flex: int, spare: int, weight: int) -> int =
    if flex > 0 && weight > 0 then spare * flex / weight else 0

// The container constructors, and what a trailing block does to them.
//
// **A tree is indentation now**, which is what card 0171 was filed to get and what it landed:
//
//     column(spacing = 8):
//         text(s"count: ${count.read()}")
//         button("increment", () -> count.set(count.read() + 1))
//
// The block fills the first parameter no written argument took, so naming `spacing` ahead of it is
// not a conflict -- the block still goes to `children`. That rule is the reason `column(spacing =
// 8):` works at all, and it is the first thing anybody writes.
//
// **The older form still compiles and is what a caller with a `Buf` of children writes:**
//
//     column([text("a"), text("b")], 4)
//     column(rows.view(), 4)
//
// The array literal is what makes the first of those work: `[]&View` takes an array at a call
// **only** when the argument is a literal (card 0110), so a caller holding a `Buf` passes `.view()`
// instead. A block is a literal by the same rule, which is why lines of different concrete types
// meet at one `[]&View` without a cast.
//
// **What a block will not hold is a loop**, and that limit is 0171's stated cost rather than an
// oversight: a block is a list of expressions and a `for` is a statement. What a list of rows is
// written as instead is one expression that produces the whole list, which is what `sysl.seq` is
// for:
//
//     column(rows.map(r -> text(r).padding(3)), 0)
//
// That is the shape Swift reaches `buildArray` for, arrived at from the other end: the loop stays
// out of the block, and the sequence the loop would have built is named rather than accumulated.
// A caller that already holds a `Buf` still passes `.view()`.
column(children: []&View, spacing: int = 0) -> &View
    var b: Buf[&View] = buf()

    b.extend(children)

    Column(b, spacing)
end column

row(children: []&View, spacing: int = 0) -> &View
    var b: Buf[&View] = buf()

    b.extend(children)

    Row(b, spacing)
end row
