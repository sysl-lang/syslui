module sh.sysl.ui

// A view whose appearance is decided while it is being drawn, and the one idea the rest of the
// styling rests on.
//
// **The problem is an ordering one and it has no answer inside the tree.** A tree is built before
// anything knows where the pointer is -- that is what a rebuild *is*, a function of the application
// state alone -- so a node cannot be handed the colour it will need, because at the moment it is
// made nobody has asked the window yet. Immediate mode does not have this problem: `imui` draws and
// tests the pointer in the same call, which is why a hover effect there is an `if`.
//
// **So a node carries every appearance it might take and chooses while painting**, and the choice is
// made from the canvas, which is the only thing that knows. That is SwiftUI's `ButtonStyle` exactly:
// `makeBody(configuration:)` is handed `isPressed` and returns a view, and the same body is called
// again with a different configuration when the press changes. The difference is that SwiftUI
// re-runs the body through its diffing engine and this re-runs it during paint, which an erased tree
// with no reconciler can do and a reconciling one cannot.
//
// **This is what generalizes**, and the reason to write it as a struct with a state parameter rather
// than as a `hover_color` field on a button: focus, disabled, selected and dragged are all more
// fields on `Interaction`, and every style written against it keeps working because it takes the
// whole thing.

// What the pointer is doing to a view, at the moment the view is drawn.
//
// **Two numbers rather than two flags, and that is what makes the styling animate.** A style handed
// `hovered: bool` can only choose between two appearances, so a pointer crossing a button is a step
// change and there is nowhere for an ease to live. A style handed `hover: real` is being told *how
// far in* the hover is, and the same arithmetic that picked a colour picks every colour on the way
// to it -- so animation costs a style nothing and is not something it has to opt into.
//
// **Nothing here is stored between frames and nothing is a signal.** Where the pointer is, and how
// far an ease has got, are facts about the window rather than application state; treating either as
// state is what would force a rebuild on every mouse move.
struct Interaction derives Eq
    // Zero at rest, one fully hovered, in between while easing.
    hover: real

    // Held down *and* inside. A press that began here and wandered off falls back toward zero,
    // which is what a person expects: sliding off a button before letting go is how a click is
    // cancelled, and the button should relax rather than stay dented.
    press: real

    // The flags, for a style that genuinely wants a step change -- a label that swaps its text, an
    // icon that appears. Half way is the crossing point, so this is what the animation was doing
    // before it was an animation.
    hovered(self) -> bool = self.hover > 0.5

    pressed(self) -> bool = self.press > 0.5

// The resting appearance -- what a view looks like with nothing pointing at it.
//
// **Layout is measured in this state and never in another**, which is the rule that keeps a list
// from twitching. If `measure` asked the canvas what the pointer was doing, a style whose hover
// state is a pixel wider would relayout the row under the cursor and shove its neighbours, and the
// thing being pointed at would move out from under the pointer. With an *animated* hover that would
// be worse still: the layout would move for every frame of the ease rather than once.
//
// **A module-level `val`, not a `const`.** `const` in sysl is compile-time folding -- a constant is
// substituted into its uses as a *literal*, and there is no literal for a struct, which is why
// `const AT_REST: Interaction = ...` is refused. That refusal is the language being coherent rather
// than a gap: what a named struct value wants is storage, and storage is what a `val` is.
val AT_REST: Interaction = Interaction(0.0, 0.0)

// How fast the two states ease, as a fraction of the whole travel per second.
//
// **A press is quicker than a hover, and deliberately so.** A press is a direct response to
// something the person just did and has to feel instant; a hover is the interface noticing them, and
// noticing too fast reads as twitchy when the pointer is only passing over.
const HOVER_RATE: real = 8.0
const PRESS_RATE: real = 16.0

// A view built from the interaction state, freshly on every paint.
//
// **The body is called twice a frame and that is the honest cost of it**: once by `measure`, at
// rest, and once by `paint`, with the real state. A container measures its children twice as well,
// so a button inside a column is built three times a frame -- which is the same double-measure
// `layout.sysl` records rather than hides, and the same answer applies: it belongs to a cache on a
// retained element, and there are no elements.
//
// What it buys is that nothing is stored. A `Reactive` holds one closure and no appearance, so the
// hover state cannot go stale, cannot be left set by a pointer that has since moved, and cannot
// disagree with what was drawn.
// **The body is handed the theme as well as the state**, and for exactly the same reason it is
// handed the state: both are facts about the frame rather than about the application, both are known
// only while drawing, and the canvas is where both live. A style asked to choose an appearance
// without being told what appearance the interface has would have to reach for a constant, which is
// the one thing a theme exists to stop.
struct Reactive
    body: &Fn(Interaction, Theme) -> &View

impl View for Reactive
    measure(&self, c: *Canvas, avail: Size) -> Size =
        (self.body)(AT_REST, c.theme()).measure(c, avail)

    // **The canvas is asked twice and answers three things**: where the pointer is, and where each
    // of this view's two animations has got to on the way to matching it. A backend with no clock
    // answers the target outright, so this is the step change it always was until something supplies
    // time.
    paint(&self, c: *Canvas, r: Rect)
        val hover = c.phase(r, HOVER_SLOT, if c.hovered(r) then 1.0 else 0.0, HOVER_RATE)
        val press = c.phase(r, PRESS_SLOT, if c.pressed(r) then 1.0 else 0.0, PRESS_RATE)

        (self.body)(Interaction(hover, press), c.theme()).paint(c, r)

// Which of a `Reactive`'s two animations is which, in the canvas's store.
//
// **A slot rather than a name, because the key has to be cheap**: it is compared once per animated
// view per frame, beside a rectangle that is four integers.
private const HOVER_SLOT: int = 0
private const PRESS_SLOT: int = 1

// **The rectangle is the one this view was given**, which is why the question is asked here and not
// anywhere else: `hovered` and `pressed` need geometry, and geometry exists only inside `paint`.
reactive(body: &Fn(Interaction, Theme) -> &View) -> &View = Reactive(body)

// ## The button, which is what all of the above was for

// A tappable label that answers to the pointer, in one of six roles and one of four shapes.
//
// **A role and a variant rather than a colour and a chain**, and the reason is that a caller cannot
// see the theme: a tree is built before anything knows what it will be drawn into, so
// `button("Delete", f, .Error)` is the only spelling of "the destructive one" that survives a
// restyle. A hex literal at a call site is a colour that will still be there when the light theme
// is not.
//
// The two axes are independent, so six roles and four variants are twenty-four appearances out of
// the ten numbers in a `Theme` -- and every one of them moves when the theme does.
//
//     button("Save", save)                        // filled, primary
//     button("Delete", drop, .Error)              // filled, red
//     button("Later", defer, .Secondary, .Soft)   // muted ground, coloured label
//     button("Draft", edit, .Accent, .Dashed)     // a dashed outline: provisional
button(label: string, on_tap: &Fn() -> unit, role: Role = Role.Primary,
       variant: Variant = Variant.Filled) -> &View =
    reactive((i, t) -> button_face(t, label, i, t.color(role), variant)).on_tap(on_tap)

// **One function from a theme, a label and a state to a view**, which is the shape a `ButtonStyle`
// would have if styles became a trait -- and the reason this is not written inline in the lambda.
private button_face(t: Theme, label: string, i: Interaction, color: u32, variant: Variant) -> &View =
    variant match
        Filled -> filled(t, label, i, color)
        Soft -> soft(t, label, i, color)
        Outline -> outlined(t, label, i, color, 0)
        Dashed -> outlined(t, label, i, color, DASH)

// The dash a `Dashed` border is drawn with: four on, four off.
private const DASH: int = 4

// **Layered rather than chosen**, which is what turns three appearances into a continuum: the hover
// lifts the colour toward white and the press sinks the result toward black, each by as much of its
// travel as it has actually made. At rest both are zero and the ground is the role's colour itself.
private filled(t: Theme, label: string, i: Interaction, color: u32) -> &View
    val lifted = lighten(color, int(i.hover * real(t.hover_lift)))
    val ground = darken(lifted, int(i.press * real(t.press_sink)))

    // `on_fill` rather than white, because a light theme's yellow is not something white text can
    // be read against -- and a button whose label vanished on one theme would be the first thing
    // anybody found.
    text(label)
        .foreground(t.on_fill)
        .padding(t.pad)
        .background(ground, t.radius)
        .border(lighten(ground, t.edge_lift), 1, t.radius)
end filled

// A muted ground mixed a little way from `ground` toward the colour, with the label in the colour.
//
// **The one that scales.** A screen can carry a dozen of these where a dozen filled buttons is a
// screen with no hierarchy at all, so this is the variant a table's row actions want.
private soft(t: Theme, label: string, i: Interaction, color: u32) -> &View
    val at = t.soft + int(i.hover * real(t.hover_lift)) + int(i.press * real(t.press_sink))

    text(label)
        .foreground(lighten(color, 20))
        .padding(t.pad)
        .background(mix(t.ground, color, at), t.radius)
end soft

// An outline and a label in the colour, and no ground at all.
//
// **It fills nothing, ever, and the hover is carried entirely by the outline and the label.** That
// is a constraint rather than a taste: `Canvas` has no alpha, so a "transparent" ground would have
// to be painted in whatever is behind it, and a view does not know what is behind it. Brightening
// two things it *does* own needs no such knowledge and works on any background -- which is the whole
// argument for this variant existing, since it is the only one that can sit on an unknown surface.
//
// The press thickens the border rather than darkening it, because there is no ground to sink.
private outlined(t: Theme, label: string, i: Interaction, color: u32, dash: int) -> &View
    val lit = lighten(color, int(i.hover * real(t.hover_lift)) + int(i.press * real(t.edge_lift)))
    val width = if i.press > 0.5 then 2 else 1

    text(label)
        .foreground(lit)
        .padding(t.pad)
        .border(lit, width, t.radius, dash)
end outlined
