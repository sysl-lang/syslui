module sh.sysl.ui

import sysl.buf.{Buf, buf}

// The keys a frame saw, and which view they belong to.
//
// **The pointer needed no routing and the keyboard does, which is the whole difference between this
// file and `input.sysl`.** A click carries a position, so the frame can decide afterwards which
// rectangle it landed in; a key carries nothing at all, and the only thing that can say where it
// should go is a piece of state that outlived the frame before. That state is *focus*, and there is
// exactly one of it.
//
// **So focus is a number the canvas keeps, and a view asks whether it is the one.** Everything else
// the canvas remembers -- an animation's phase, a grab -- is keyed by the rectangle it is painting
// into, because a rectangle is what a view has. A rectangle is the wrong key here: a form that
// scrolls while somebody is typing moves the field they are typing in, and keying on geometry loses
// the focus at exactly the moment it matters most. **An id is passed in instead**, which is the
// choice `tabs` and `radio` already made for the same reason -- an application naming its fields is
// a line it was going to write anyway, and it is the only name that survives a relayout.
//
// **A press anywhere blurs, and whatever the press was inside takes focus back while it paints.**
// That is one line in each of two places rather than a rule anybody has to remember: no view has to
// know that another view was clicked, no dismissal chain has to be maintained, and a click on a
// button, on a scroll list, or on empty ground all put the keyboard away by doing nothing at all.
//
// **The press is remembered rather than observed, and a touch screen is what forced that.** Focus
// was taken by a field noticing `pressed(r)` while it painted, which works on a desktop only
// because a mouse press lasts several frames -- and a tap on a phone is a press and a release
// arriving between two frames, so the paint in the middle never sees one. So the down *transition*
// records where it landed and says so for exactly one frame: `tapped(r)` is true for whatever
// rectangle held it, whether the finger is still there or not.
//
// **Nothing here is application state and none of it is a signal.** Which field somebody is typing
// in, and where the caret is inside it, are facts about the window between two frames -- the same
// kind of fact as where the pointer is. The *text* is the application's, and it is a signal, which
// is the line this file is careful not to cross.

// Nobody has the keyboard. Ids therefore start at one, which is worth saying because a field given
// the default `int` would otherwise silently share focus with every other one.
const NOBODY: int = 0

// One key, as a view has to think about it.
//
// **`Typed` carries a string rather than a character**, because that is what a window system
// reports: a composed key, a dead-key sequence and a paste all arrive as a run of text, and a
// keyboard that could only say "one character" would make an editor that could not type é. A
// backend hands over whatever the window gave it and the edit inserts it whole.
enum Key derives Eq
    Typed(text: string)
    Backspace
    Delete
    Left
    Right
    Up
    Down
    Home
    End
    Enter
    Tab
    Escape
    Insert
    PageUp
    PageDown

    // A function key, `F(1)` to `F(12)` on most keyboards. **One variant carrying its number rather
    // than twelve**, because nothing the toolkit does differs between them, and a keyboard with
    // twenty-four of them reports the other twelve without the enum having to grow again.
    F(n: int)
end Key

// A key with the modifiers that were held when it went down.
//
// **Shift extends a selection and a word modifier moves by words**, and those are the only two an
// editing surface has to know about -- everything else a modifier does is a shortcut, which belongs
// to the application because only the application knows what its shortcuts are. ⌘C is not in this
// file for the same reason the clipboard is not: the toolkit says what is selected and the program
// decides what that is worth.
//
// **Each of the four is the key it names and nothing else**, so a spreadsheet can tell ⌘→ from ⌥→
// from ⌃→. Which of them *means* something is a platform convention, and that is answered by the two
// properties below rather than by a driver folding one key into another -- which is what happened
// until 0.1.16, when Alt arrived as `ctrl` and Command did not arrive at all.
struct Press derives Eq
    key: Key
    shift: bool
    ctrl: bool
    alt: bool

    // The platform's own key: Command on a Mac, the Windows key elsewhere. The name is `Modifiers`'.
    cmd: bool

    // Does this press ask for a motion by words?
    //
    // **Either control or alt**, because a Mac moves by word with ⌥ and everything else with Ctrl, and
    // a field that honoured only one would be wrong on half the machines. This is what the driver's
    // fold used to decide, kept as it was: an editor's arrows behave exactly as they did before the
    // two keys were told apart.
    by_word -> bool = self.ctrl || self.alt

    // Is the shortcut key held -- ⌘ on a Mac, Ctrl everywhere else?
    //
    // **This is the one an application's shortcuts should ask**, so that ⌘C on a Mac and Ctrl+C on
    // Linux are one line of the program rather than two. It is decided by the target the program was
    // built for, which is the platform the person is sitting at.
    command -> bool = if COMMAND_IS_CMD then self.cmd else self.ctrl
end Press

// Whether the shortcut key is Command, for `Press.command` and `Modifiers.command`.
#if macos
private[ui] const COMMAND_IS_CMD: bool = true
#else
private[ui] const COMMAND_IS_CMD: bool = false
#endif

// A key and whichever modifiers are held -- none, unless named, which is most of them.
press(k: Key, shift: bool = false, ctrl: bool = false, alt: bool = false, cmd: bool = false) -> Press =
    Press(k, shift, ctrl, alt, cmd)

// Text arriving from the window system.
typed(t: string) -> Press = Press(Key.Typed(t), false, false, false, false)

// No keys at all -- what a backend with no keyboard answers, so that a field on one still draws.
no_keys() -> []Press = buf[Press]().view()

// What the window has told the canvas about the keyboard, between one frame and the next.
//
// **It is a mechanism struct beside `Hits` and `Grab` rather than a member of either backend**, for
// the reason those two are: there is one right answer to "who has the keyboard", it is fiddly in the
// same way in every backend, and a second implementation of it is a second place for it to be
// subtly different.
struct Keyboard
    // What arrived since the last frame, in the order it arrived.
    presses: Buf[Press]

    // Which view has the keyboard, or `NOBODY`.
    focus: int

    // Where the caret is in that view, and what it has selected. **A caret is a selection whose two
    // ends are equal**, which is why there is no separate field for one: every rule about moving a
    // caret is a rule about moving `head`, and shift is the question of whether `anchor` follows.
    sel: Selection

    // Whether the pointer was down on the previous frame, so that the press can be told from the
    // hold. Blurring on the hold would mean a field could never keep focus while it was dragged in.
    was_down: bool

    // Where the last press landed, and whether the frame being painted is the one that follows it.
    // **A tap is over before a frame is drawn**, so the point is kept rather than asked for.
    tap_x: int
    tap_y: int
    fresh: bool

    // Which press of a run that one was: 1 for a single, 2 for the second of a double, and so on.
    //
    // **The platform counts, not the toolkit**, because how far apart in time and space two presses
    // may be and still make a double is a setting the person chose in their system preferences, and
    // only the window system can read it. A press nobody counted is a single.
    count: int

    // The window reported a key.
    press(*self, p: Press) = self.presses.push(p)

    // What this frame's keys are, for whoever has the focus.
    keys(*self) -> []Press = self.presses.view()

    // Forget this frame's keys and the press that came with them. **`render` calls it at the end of
    // a frame**, which is the only moment either is certainly finished with.
    reset(*self)
        self.presses = buf()
        self.fresh = false

    // Told once a frame, through the canvas's `point`. **The transition into down is the blur**, not
    // the hold and not the release -- and it is also the press a field takes focus from, recorded
    // here because a tap does not last long enough to be noticed any other way.
    moved(*self, x: int, y: int, down: bool)
        if down && !self.was_down
            self.focus = NOBODY
            self.tap_x = x
            self.tap_y = y
            self.fresh = true
            self.count = 1

        self.was_down = down
    end moved

    // The platform says the press just recorded was the `n`th of a run. A count below one is no
    // count at all, and leaves the press a single.
    counted(*self, n: int)
        if self.fresh && n > 0 then self.count = n

    // Did the press this frame follows land in `r`?
    landed(*self, r: Rect) -> bool = self.fresh && r.holds(self.tap_x, self.tap_y)

    // Which press of a run the one this frame follows was, or 0 when no press was.
    taps(*self) -> int = if self.fresh then self.count else 0

    // Give the keyboard to `id`, and start it with an empty caret if it did not have it before.
    take(*self, id: int)
        if self.focus != id
            self.focus = id
            self.sel = nothing_selected()

    // Where the focused view's caret is now.
    edit(*self, sel: Selection) = self.sel = sel
end Keyboard

keyboard() -> Keyboard = Keyboard(buf(), NOBODY, nothing_selected(), false, -1, -1, false, 0)
