module sh.sysl.ui
@tests

import sysl.buf.{Buf, buf}
import sysl.math.Float
import sysl.seq.{Sequence, generate}
import sysl.text.Search
import sh.sysl.plutovg

// The probe's findings, kept as tests rather than as prose.
//
// Card 0203 asks six questions and the rule is that a probe's answers become the first tests of the
// thing it probed. Each test below is one of those answers, and the name says which. A test that
// passes here is a claim in 0168 that has now been *run* rather than read off a design chapter.

private assert_paints(v: &View, avail: Size, at: Rect, expected: string)
    var c = recorder()

    v.paint(&c, at)
    assert(c.dump() == expected, s"expected:\n${expected}got:\n${c.dump()}")
end assert_paints

// What a view measures to, through a canvas, since a view no longer measures itself. The recorder's
// font is eight pixels a byte and sixteen tall, which is what every number below is in terms of.
private measured(v: &View, avail: Size) -> Size
    var c = recorder()

    v.measure(&c, avail)
end measured

// **`Size` and `Rect` ask the compiler to write their `Eq`, and a derived comparison has exactly one
// way to go wrong.** Two fields of the same type read in the wrong order still compiles and still
// answers `true` for most pairs, so every assertion below moves one field and expects that move to
// be seen. Everything else in this file compares a `Size` and would not notice.
@test
private a_derived_eq_sees_every_field()
    assert(Rect(1, 2, 3, 4) == Rect(1, 2, 3, 4), "the same four fields are equal")
    assert(Rect(9, 2, 3, 4) != Rect(1, 2, 3, 4), "x is compared")
    assert(Rect(1, 9, 3, 4) != Rect(1, 2, 3, 4), "y is compared")
    assert(Rect(1, 2, 9, 4) != Rect(1, 2, 3, 4), "w is compared")
    assert(Rect(1, 2, 3, 9) != Rect(1, 2, 3, 4), "h is compared")
    assert(Size(1, 2) != Size(2, 1), "a transposed pair is not equality")
end a_derived_eq_sees_every_field

// **Question 1: does a modifier chain?**
//
// `text("hi").padding(8).background(red)` -- three links, each a trait default returning `&View`,
// each called on the erased result of the one before. This is the claim 0168 makes and the one the
// whole ergonomic case rests on.
@test
private a_modifier_chain_calls_through_an_erased_receiver()
    val v = text("hi").padding(8).background(0xFF0000u32)

    assert(measured(v, Size(200, 200)) == Size(32, 32), "two chars at 8px plus 8px of padding a side")
end a_modifier_chain_calls_through_an_erased_receiver

// **Question 2: does the wrapped view stay erased?**
//
// The concrete type must not escape into the modifier's result, or the chain would break at the
// second link -- which is exactly what happens in Rust, where a default returning a box needs
// `Self: Sized` and is then unavailable on the trait object. A `Text` and a `Padding` reaching the
// same variable is the shortest thing that shows it does not happen here.
@test
private a_leaf_and_a_wrapper_meet_at_one_object_type()
    var views: Buf[&View] = buf()

    views.push(text("a"))
    views.push(text("bb").padding(4))
    views.push(spacer().frame(50, 10))

    val v = views.view()

    assert(measured(v[0], Size(100, 100)) == Size(8, 16), "the leaf measures itself")
    assert(measured(v[1], Size(100, 100)) == Size(24, 24), "the wrapper adds its inset")
    assert(measured(v[2], Size(100, 100)) == Size(50, 10), "a frame overrides what it wraps")
end a_leaf_and_a_wrapper_meet_at_one_object_type

// A chain paints inside-out: the background fills the whole rectangle it was given, then the
// padding insets, then the text lands in what is left. Asserting the recording rather than the
// sizes is what says the *positions* came out right and not merely the arithmetic.
@test
private a_chain_paints_from_the_outside_in()
    assert_paints(text("hi").padding(8).background(0xFF0000u32),
                  Size(200, 200), Rect(0, 0, 32, 32),
                  "fill 0,0 32x32 #16711680\ntext 8,8 16x16 'hi'\n")
end a_chain_paints_from_the_outside_in

// Modifier order is not commutative, and a framework where it silently were would be hiding a bug.
// Padding-then-background paints the fill behind the inset; background-then-padding insets the fill
// too. Both are legitimate and they are different pictures.
@test
private modifier_order_is_visible_in_the_recording()
    assert_paints(text("hi").background(0x00FF00u32).padding(8),
                  Size(200, 200), Rect(0, 0, 32, 32),
                  "fill 8,8 16x16 #65280\ntext 8,8 16x16 'hi'\n")
end modifier_order_is_visible_in_the_recording

// **Question 3: is `weak Fn() -> unit` a dependent list?**
//
// A write must reach everything that read, exactly once each. This is the mechanism that stands in
// for a reconciler, so if it does not work the architecture in 0168 does not either.
@test
private a_write_calls_every_live_dependent()
    val s = signal(1)
    val seen = signal(0)
    val f: &Fn() -> unit = () -> seen.set(seen.read() + 1)

    s.watch(f)
    s.set(2)
    s.set(3)

    assert(s.read() == 3, "the value is the last one written")
    assert(seen.read() == 2, "and each write called the dependent once")
end a_write_calls_every_live_dependent

// The other half of question 3, and the half that decides whether teardown needs a discipline: a
// dependent whose last strong reference has gone must simply stop being called, with nothing having
// unsubscribed it. If this fails, every drop path in the framework has to remember to unhook, and
// the one that forgets is a leak nobody finds.
@test
private a_dependent_that_has_gone_is_not_called()
    val s = signal(0)
    val seen = signal(0)

    if true
        val f: &Fn() -> unit = () -> seen.set(seen.read() + 1)

        s.watch(f)
        s.set(1)

    s.set(2)

    assert(seen.read() == 1, "called while it was alive, and not after it went")
end a_dependent_that_has_gone_is_not_called

// **Question 6: does one layout pass work over `[]&View`?**
//
// Constraints down, sizes up, the parent places. A column of three heterogeneous children -- a
// leaf, a chain and a nested row -- is the smallest tree where every part of that sentence has to
// be true at once.
@test
private a_column_stacks_what_its_children_asked_for()
    val v = column([
        text("a"),
        text("bb").padding(4),
        row([text("c"), text("d")], 2)
    ], 3)

    assert(measured(v, Size(200, 200)) == Size(24, 62), "the widest child, and every height plus the gaps")
end a_column_stacks_what_its_children_asked_for

// And the positions, which the sizes alone do not say. Reading the recording is what catches a
// container that measured correctly and then placed everything at the origin.
@test
private a_column_places_each_child_below_the_last()
    var c = recorder()
    val v = column([text("a"), text("bb"), text("c")], 3)

    v.paint(&c, Rect(10, 20, 100, 100))

    assert(c.dump() == "text 10,20 100x16 'a'\ntext 10,39 100x16 'bb'\ntext 10,58 100x16 'c'\n",
           s"got:\n${c.dump()}")
end a_column_places_each_child_below_the_last

// **Question 5: where does state that outlives a rebuild live?**
//
// The tree is thrown away and built again -- which is what a signal write causes -- and the scroll
// position must still be what it was. If this needs element identity, the erased tree cannot supply
// it and 0168's architecture has a hole in it.
private list_of(n: int, offset: &Signal[int]) -> &View =
    scroll(column(generate(usize(n), i -> text(s"row ${i}")), 0), offset, 40)

@test
private a_scroll_offset_survives_the_tree_being_rebuilt()
    val offset = signal(0)

    // One tree, scrolled.
    val before = list_of(10, offset)

    offset.set(32)

    // A completely different tree, built from scratch, sharing only the signal.
    val after = list_of(10, offset)
    var c = recorder()

    after.paint(&c, Rect(0, 0, 100, 40))

    assert(offset.read() == 32, "the offset is in the signal, so a rebuild cannot lose it")

    // **And only what is in the window is drawn.** Ten rows exist, three are reachable through the
    // clip, and the other seven are measured -- the column needs their heights to place the ones
    // after them -- and never painted. That is what makes a list of three hundred rows cost about
    // what a list of ten costs.
    assert(c.dump() == "clip 0,0 100x40\n" +
                       "text 0,0 100x16 'row 2'\ntext 0,16 100x16 'row 3'\ntext 0,32 100x16 'row 4'\n" +
                       "unclip\n" +
                       s"fill 92,0 8x40 #${dark().ground} r4\n" +
                       s"fill 92,4 8x24 #${lighten(dark().inert, 25)} r4\n",
           s"got:\n${c.dump()}")
end a_scroll_offset_survives_the_tree_being_rebuilt

// **A tree written as indentation**, which is card 0171 arriving and the reason the second half of
// 0203 waited for it. The same tree as an array literal is asserted a few tests above; this one is
// here to say the two build the same thing, and that a block's lines may be different concrete
// types reaching one `[]&View` -- a `Text`, a chain ending in a `Background`, and a nested `Row`.
@test
private a_trailing_block_builds_the_same_tree_as_a_literal()
    val block = column(spacing = 3):
        text("a")
        text("bb").padding(4)
        row([text("c"), text("d")], 2)

    val literal = column([
        text("a"),
        text("bb").padding(4),
        row([text("c"), text("d")], 2)
    ], 3)

    assert(measured(block, Size(200, 200)) == measured(literal, Size(200, 200)),
           "the block and the literal measure alike")

    var a = recorder()
    var b = recorder()

    block.paint(&a, Rect(10, 20, 100, 100))
    literal.paint(&b, Rect(10, 20, 100, 100))

    assert(a.dump() == b.dump(), s"block:\n${a.dump()}literal:\n${b.dump()}")
end a_trailing_block_builds_the_same_tree_as_a_literal

// **The rows a block cannot hold, produced as one expression instead.** A block's lines are
// expressions and a `for` is a statement, so a list whose length is known only while running is
// what `sysl.seq`'s `map` is for: it names the sequence rather than accumulating it, and the
// container takes the whole of it in the position a literal would have gone.
//
// This says the tree that arrives is the one the hand-built `Buf` produced, which is the form it
// replaces -- three lines and a `.view()` standing between a container and its children.
@test
private a_mapped_sequence_builds_the_same_children_as_a_loop()
    var names: Buf[string] = buf()

    for i in 0..<3
        names.push(s"row ${i}")

    val rows = names.view()

    var made: Buf[&View] = buf()

    for i in 0..<rows.len
        made.push(text(rows[i]).padding(2))

    val looped = column(made.view(), 3)
    val mapped = column(rows.map(r -> text(r).padding(2)), 3)

    assert(measured(looped, Size(200, 200)) == measured(mapped, Size(200, 200)),
           "the loop and the map measure alike")

    var a = recorder()
    var b = recorder()

    looped.paint(&a, Rect(0, 0, 200, 200))
    mapped.paint(&b, Rect(0, 0, 200, 200))

    assert(a.dump() == b.dump(), s"looped:\n${a.dump()}mapped:\n${b.dump()}")
end a_mapped_sequence_builds_the_same_children_as_a_loop

// A block naming `spacing` first still fills `children`, which is the rule 0171 landed second and
// the first thing anybody writes. Without it the block would be stranded at the parameter after the
// one it meant.
@test
private a_named_argument_before_a_block_does_not_take_its_slot()
    val v = column(spacing = 3):
        text("a")
        text("bb")

    assert(measured(v, Size(200, 200)) == Size(16, 35), "two rows of 16 and one gap of 3")
end a_named_argument_before_a_block_does_not_take_its_slot

// **Input composes with the chain.** `on_tap` is a modifier like `padding`, so a button is three
// links and no new view type -- and what proves it is a tap arriving at the closure through the
// erasure, not a line in the recording saying a region was registered.
@test
private a_tap_reaches_the_action_of_the_view_that_was_drawn()
    val count = signal(0)
    var c = recorder()

    button("increment", () -> count.set(count.read() + 1)).paint(&c, Rect(0, 0, 100, 28))

    assert(c.taps.len() == 1, "one region, from the one tappable view")
    assert(c.taps.tap(50, 14), "a point inside it is a hit")
    assert(count.read() == 1, "and the action ran")
    assert(!c.taps.tap(400, 14), "a point outside every region is not")
    assert(count.read() == 1, "and nothing ran")
end a_tap_reaches_the_action_of_the_view_that_was_drawn

// Paint order is depth order, so the last region holding a point is the one on top. A column of two
// buttons is the ordinary case; two overlapping regions is the case that says which rule is in use.
@test
private the_topmost_region_wins_a_point_two_of_them_hold()
    val which = signal(0)
    var c = recorder()

    val v = column(spacing = 0):
        button("under", () -> which.set(1))
        button("over", () -> which.set(2))

    v.paint(&c, Rect(0, 0, 200, 60))

    assert(c.taps.len() == 2, "two buttons, two regions")
    assert(c.taps.tap(10, 40), "the lower half is the second button")
    assert(which.read() == 2, "and it is the one that ran")
end the_topmost_region_wins_a_point_two_of_them_hold

// A canvas whose font is not the one these tests are written in, which is the whole reason
// `measure` takes one.
//
// **This is the defect the frame loop found.** A `Text` used to measure itself at eight pixels a
// byte, so a list of rows laid out against a real font put every row in the wrong place -- and no
// test could have caught it, because the only canvas in existence agreed with the guess.
@test
private a_view_measures_in_the_font_of_the_canvas_it_is_given()
    val v = text("hi").padding(8)
    var wide = recorder(10, 20)

    assert(measured(v, Size(200, 200)) == Size(32, 32), "eight a byte, sixteen tall, plus the inset")
    assert(v.measure(&wide, Size(200, 200)) == Size(36, 36), "ten a byte, twenty tall, same inset")
end a_view_measures_in_the_font_of_the_canvas_it_is_given

// -- the edges, found by pointing a frame loop at the tree -----------------------------------------

// **A click that arrives after the tree it was drawn from has gone.** This is the shape a real loop
// makes on every frame that rebuilds: the record was written by the previous tree, the previous
// tree has been dropped, and the mouse button goes down before the next paint replaces the record.
//
// It is safe, and the reason is worth stating rather than discovering: the record holds its handler
// **strongly**, and a handler captures the signals it writes rather than the node that carried it.
// So the node can go and the closure cannot dangle. A weak edge here -- which is the right edge in
// the dependent list, twenty lines up -- would have made this the crash the frame loop trips over
// first.
@test
private a_tap_recorded_by_a_tree_that_has_gone_still_runs()
    val count = signal(0)
    var c = recorder()

    if true
        val tree = button("increment", () -> count.set(count.read() + 1))

        tree.paint(&c, Rect(0, 0, 100, 28))

    assert(c.taps.tap(50, 14), "the region outlived the tree that drew it")
    assert(count.read() == 1, "and its action still reaches the signal")
end a_tap_recorded_by_a_tree_that_has_gone_still_runs

// A container with nothing in it. The spacing is added between children, so a container that added
// it per child would give an empty one a height and a single-child one a trailing gap.
@test
private an_empty_container_measures_to_nothing()
    assert(measured(column([], 8), Size(200, 200)) == Size(0, 0), "no children, no size, no spacing")
    assert(measured(row([], 8), Size(200, 200)) == Size(0, 0), "and the same across")
    assert(measured(column([text("a")], 8), Size(200, 200)) == Size(8, 16), "one child, no gap after it")
end an_empty_container_measures_to_nothing

// An inset larger than the space it is given. The child is offered a negative width, which is what
// the arithmetic produces and is not something a caller would write on purpose -- a window dragged
// narrow produces it on the way past. What must not happen is a wrapper reporting less than its own
// insets, which would place the next sibling on top of it.
@test
private an_inset_wider_than_the_space_still_reports_its_own_width()
    val v = text("hi").padding(20)

    assert(measured(v, Size(10, 10)) == Size(56, 56), "the text still measures, and the insets are added")
end an_inset_wider_than_the_space_still_reports_its_own_width

// A list scrolled past its end. Nothing in `Scroll` clamps, and that is deliberate: the offset is
// the application's signal, so the clamp is the application's -- a framework that clamped would need
// to know the content height at write time, which is exactly the layout it has not run yet.
//
// **The name of this test only became true when culling arrived.** It used to paint both rows ten
// thousand pixels above the window and rely on the backend to throw the pixels away; now the column
// asks whether each row is reachable and neither is, so nothing is drawn at all.
@test
private a_scroll_past_the_end_paints_nothing_and_does_not_fail()
    val offset = signal(10_000)
    var c = recorder()

    scroll(column([text("a"), text("b")], 0), offset, 40).paint(&c, Rect(0, 0, 100, 40))

    assert(c.dump() == "clip 0,0 100x40\nunclip\n", s"got:\n${c.dump()}")
end a_scroll_past_the_end_paints_nothing_and_does_not_fail

// Two dependents on one signal, one of which goes. The sweep must keep the survivor -- a `notify`
// that rebuilt its list from the live ones and dropped a live one with them would be a subscription
// that silently stops, which is the hardest kind of bug to see in a user interface.
@test
private a_sweep_keeps_the_dependent_that_is_still_alive()
    val s = signal(0)
    val lived = signal(0)
    val died = signal(0)
    val keep: &Fn() -> unit = () -> lived.set(lived.read() + 1)

    s.watch(keep)

    if true
        val f: &Fn() -> unit = () -> died.set(died.read() + 1)

        s.watch(f)
        s.set(1)

    s.set(2)
    s.set(3)

    assert(lived.read() == 3, "the survivor heard every write")
    assert(died.read() == 1, "and the one that went heard only the one before it did")
end a_sweep_keeps_the_dependent_that_is_still_alive

// -- the styling layer ----------------------------------------------------------------------------

// **A default argument on a trait member is filled in at the CALL, including a call through the
// erasure**, which is the language fact the whole `Canvas` surface was cut around: `fill` and a
// separate `round` were two members for a day, and every backend wrote the same body twice.
//
// A view calls `c.fill(r, colour)` with no radius, through a `*Canvas` whose receiver has forgotten
// what it is, and the recorder — which declares the parameter without a default, because an `impl`
// may not restate one — sees the zero.
@test
private a_defaulted_trait_argument_survives_the_erasure()
    assert_paints(text("hi").background(0xFF0000u32),
                  Size(200, 200), Rect(0, 0, 16, 16),
                  "fill 0,0 16x16 #16711680\ntext 0,0 16x16 'hi'\n")
end a_defaulted_trait_argument_survives_the_erasure

// And a radius, when one is asked for. The recorder writes it only when it is not zero, so a tree
// that never asked about corners reads the way it always did.
@test
private a_radius_reaches_the_canvas_and_a_square_fill_still_reads_as_one()
    assert_paints(text("hi").background(0xFF0000u32, 8),
                  Size(200, 200), Rect(0, 0, 16, 16),
                  "fill 0,0 16x16 #16711680 r8\ntext 0,0 16x16 'hi'\n")
end a_radius_reaches_the_canvas_and_a_square_fill_still_reads_as_one

// **A border is drawn over the child and inside the rectangle**, which is what lets it be added to a
// view without moving anything. Both halves are in this one recording: the stroke comes last, and
// its rectangle is the whole of what the view was given rather than an inset of it.
@test
private a_border_paints_over_the_child_and_insets_nothing()
    assert_paints(text("hi").border(0x00FF00u32, 2, 4),
                  Size(200, 200), Rect(0, 0, 16, 16),
                  "text 0,0 16x16 'hi'\nstroke 0,0 16x16 #65280 w2 r4\n")
end a_border_paints_over_the_child_and_insets_nothing

// A border measures to exactly what it wraps. If it did not, adding one would shove every sibling.
@test
private a_border_changes_no_measurement()
    val plain = text("hi").padding(4)
    val edged = text("hi").padding(4).border(0x00FF00u32, 3, 5)

    assert(measured(plain, Size(200, 200)) == measured(edged, Size(200, 200)),
           "an outline is drawn inside what layout already settled on")
end a_border_changes_no_measurement

// **Ink is set around the child and put back**, so a label follows the view that styled it and the
// siblings after it are unaffected.
@test
private foreground_sets_the_ink_around_its_child_and_restores_it()
    assert_paints(text("hi").foreground(0x112233u32),
                  Size(200, 200), Rect(0, 0, 16, 16),
                  "ink #1122867\ntext 0,0 16x16 'hi'\nunink\n")
end foreground_sets_the_ink_around_its_child_and_restores_it

// Nesting is the case that says `unink` restores rather than resets: the inner one ends and the
// outer colour is still standing for the row below it.
@test
private a_nested_foreground_leaves_the_outer_one_standing()
    val v = column(spacing = 0):
        text("a").foreground(0x00FF00u32)
        text("b")

    assert_paints(v.foreground(0xFF0000u32), Size(200, 200), Rect(0, 0, 16, 32),
                  "ink #16711680\nink #65280\ntext 0,0 16x16 'a'\nunink\ntext 0,16 16x16 'b'\nunink\n")
end a_nested_foreground_leaves_the_outer_one_standing

// -- colour arithmetic ----------------------------------------------------------------------------

// The ends of the line, which is what every derived state is a point on.
@test
private a_mix_at_either_end_is_the_colour_it_started_from()
    assert_eq(mix(0x3A6EA5u32, 0xFFFFFFu32, 0), 0x3A6EA5u32)
    assert_eq(mix(0x3A6EA5u32, 0xFFFFFFu32, 100), 0xFFFFFFu32)
    assert_eq(lighten(0x3A6EA5u32, 0), 0x3A6EA5u32)
    assert_eq(lighten(0x3A6EA5u32, 100), WHITE)
    assert_eq(darken(0x3A6EA5u32, 100), BLACK)
end a_mix_at_either_end_is_the_colour_it_started_from

// **Each channel is mixed against its own opposite number**, which is the one way this goes wrong
// and would not be visible in a grey: a shift computed off by eight bits still produces a colour.
@test
private each_channel_is_mixed_against_its_own()
    assert_eq(mix(BLACK, WHITE, 50), 0x7F7F7Fu32)
    assert_eq(mix(0xFF0000u32, 0x00FF00u32, 50), 0x7F7F00u32)
    assert_eq(mix(0x000000u32, 0x0000FFu32, 50), 0x00007Fu32)
end each_channel_is_mixed_against_its_own

// A percentage outside the range is clamped, because this is called from a paint pass and a user
// interface that stopped drawing over an arithmetic slip would be worse than one that drew the
// nearest colour it could.
@test
private a_percentage_outside_the_range_is_clamped_rather_than_wrapped()
    assert_eq(mix(0x3A6EA5u32, 0xFFFFFFu32, -40), 0x3A6EA5u32)
    assert_eq(mix(0x3A6EA5u32, 0xFFFFFFu32, 250), 0xFFFFFFu32)
end a_percentage_outside_the_range_is_clamped_rather_than_wrapped

// -- the state-dependent view ---------------------------------------------------------------------

// **Measurement is at rest even when the pointer is on it**, which is the rule that keeps a list
// from twitching as the cursor crosses it. The body below is deliberately a different size in each
// state, so a `measure` that asked the canvas would be caught.
@test
private a_reactive_view_measures_at_rest_whatever_the_pointer_is_doing()
    val v = reactive((i, _) -> if i.hovered() then spacer().frame(90, 90) else spacer().frame(10, 10))
    var c = recorder()

    c.point(5, 5)

    assert(v.measure(&c, Size(200, 200)) == Size(10, 10),
           "the pointer is inside it and it still measures to its resting size")
end a_reactive_view_measures_at_rest_whatever_the_pointer_is_doing

// And paint is where the state is read, because paint is the only moment a view knows its rectangle.
@test
private a_reactive_view_paints_the_state_the_canvas_reports()
    val v = reactive((i, _) -> if i.pressed() then text("down") elif i.hovered() then text("over") else text("rest"))

    var away = recorder()
    var over = recorder()
    var down = recorder()

    over.point(50, 10)
    down.point(50, 10, true)

    v.paint(&away, Rect(0, 0, 100, 20))
    v.paint(&over, Rect(0, 0, 100, 20))
    v.paint(&down, Rect(0, 0, 100, 20))

    assert(away.dump() == "text 0,2 100x16 'rest'\n", s"away:\n${away.dump()}")
    assert(over.dump() == "text 0,2 100x16 'over'\n", s"over:\n${over.dump()}")
    assert(down.dump() == "text 0,2 100x16 'down'\n", s"down:\n${down.dump()}")
end a_reactive_view_paints_the_state_the_canvas_reports

// **A press that wandered off reads as neither**, which is how a person cancels a click: hold the
// button down, slide off it, let go, and nothing should have happened.
@test
private a_press_outside_the_rectangle_is_not_a_press_on_it()
    val v = reactive((i, _) -> if i.pressed() then text("down") elif i.hovered() then text("over") else text("rest"))
    var c = recorder()

    c.point(400, 10, true)
    v.paint(&c, Rect(0, 0, 100, 20))

    assert(c.dump() == "text 0,2 100x16 'rest'\n", s"got:\n${c.dump()}")
end a_press_outside_the_rectangle_is_not_a_press_on_it

// The whole button, in the three states, read off the recording.
//
// **This asserts the WIRING and not the arithmetic** -- the derived colours are named through the
// same helpers the button uses, because what could go wrong here is a state choosing the wrong
// ground, and what could go wrong in `mix` is tested where `mix` is.
@test
private a_button_wears_a_different_ground_in_each_state()
    val face = button("hi", () -> ())

    var away = recorder()
    var over = recorder()
    var down = recorder()

    over.point(50, 14)
    down.point(50, 14, true)

    face.paint(&away, Rect(0, 0, 100, 28))
    face.paint(&over, Rect(0, 0, 100, 28))
    face.paint(&down, Rect(0, 0, 100, 28))

    assert(away.dump() == painted(dark().primary), s"away:\n${away.dump()}")
    assert(over.dump() == painted(lighten(dark().primary, dark().hover_lift)), s"over:\n${over.dump()}")

    // **A press is also a hover**, since the pointer has to be on the button to hold it down -- so
    // the pressed ground is the lifted one sunk, not the accent sunk. That falls out of the two
    // being layered rather than chosen between, and it is the right picture: releasing the button
    // leaves the pointer where it is, and what the eye should see is the press relaxing rather than
    // the whole colour jumping.
    assert(down.dump() == painted(darken(lighten(dark().primary, dark().hover_lift), dark().press_sink)),
           s"down:\n${down.dump()}")
end a_button_wears_a_different_ground_in_each_state

// What a button of label "hi" in a 100x28 rectangle draws, given the ground it settled on. The
// order is the chain read outside in, and the `hit` at the end is `on_tap` still being a modifier.
private painted(ground: u32) -> string =
    s"fill 0,0 100x28 #${ground} r6\n" +
    s"ink #${WHITE}\n" +
    "text 8,8 84x12 'hi'\n" +
    "unink\n" +
    s"stroke 0,0 100x28 #${lighten(ground, dark().edge_lift)} w1 r6\n" +
    "hit 0,0 100x28\n"

// A button still answers to a tap, which is the thing the rewrite could most easily have dropped:
// the `Reactive` sits *inside* the `Tappable`, so the region is the whole button rather than
// whatever the chosen state happened to build.
@test
private a_restyled_button_is_still_tappable_in_every_state()
    val count = signal(0)
    var c = recorder()

    c.point(50, 14, true)
    button("increment", () -> count.set(count.read() + 1)).paint(&c, Rect(0, 0, 100, 28))

    assert(c.taps.len() == 1, "one region, drawn while pressed")
    assert(c.taps.tap(50, 14), "and it holds the point")
    assert(count.read() == 1, "and the action ran")
end a_restyled_button_is_still_tappable_in_every_state

// -- animation ------------------------------------------------------------------------------------

// **An animation nobody has seen before starts settled**, which is the difference between a panel
// that appears and a panel that flies in. Only a *change* to something already on screen eases.
@test
private a_phase_first_asked_about_is_already_where_it_was_asked_for()
    var p = phases()

    assert_eq(p.at(Rect(0, 0, 10, 10), 0, 1.0, 8.0), 1.0)
    assert_eq(p.at(Rect(0, 0, 10, 10), 0, 0.0, 8.0), 0.0)
end a_phase_first_asked_about_is_already_where_it_was_asked_for

// And once it exists, a change to the target is travelled toward at the rate given rather than
// jumped to. A quarter of a second at four per second is a quarter of the way.
@test
private a_phase_moves_toward_its_target_at_the_rate_it_was_given()
    var p = phases()
    val r = Rect(0, 0, 10, 10)

    assert_eq(p.at(r, 0, 0.0, 1.0), 0.0)

    p.tick(0.25)

    assert_eq(p.at(r, 0, 1.0, 1.0), 0.25)

    p.tick(0.25)

    assert_eq(p.at(r, 0, 1.0, 1.0), 0.5)
end a_phase_moves_toward_its_target_at_the_rate_it_was_given

// It stops on arrival rather than overshooting, in both directions -- which is the one arithmetic
// slip a linear step can make, and it would show as a colour going past white and coming back.
@test
private a_phase_stops_on_arrival_rather_than_passing_it()
    var p = phases()
    val r = Rect(0, 0, 10, 10)

    assert_eq(p.at(r, 0, 0.0, 1.0), 0.0)

    p.tick(10.0)

    assert_eq(p.at(r, 0, 1.0, 1.0), 1.0)

    p.tick(10.0)

    assert_eq(p.at(r, 0, 0.0, 1.0), 0.0)
end a_phase_stops_on_arrival_rather_than_passing_it

// **A reversal starts from wherever it had got to**, which is why the step is a rate and not a curve
// over a duration: a pointer crossing a button twice interrupts the first ease half way, and there
// is no start time left to compute an ease-in-out from.
@test
private a_reversal_starts_from_where_the_animation_had_got_to()
    var p = phases()
    val r = Rect(0, 0, 10, 10)

    assert_eq(p.at(r, 0, 0.0, 1.0), 0.0)

    p.tick(0.25)

    assert_eq(p.at(r, 0, 1.0, 1.0), 0.25)

    p.tick(0.125)

    assert_eq(p.at(r, 0, 0.0, 1.0), 0.125)
end a_reversal_starts_from_where_the_animation_had_got_to

// Two animations on one view are told apart by their slot, and two views by their rectangle.
@test
private a_slot_and_a_rectangle_are_both_part_of_the_key()
    var p = phases()
    val a = Rect(0, 0, 10, 10)
    val b = Rect(0, 20, 10, 10)

    assert_eq(p.at(a, 0, 0.0, 1.0), 0.0)
    assert_eq(p.at(a, 1, 0.0, 1.0), 0.0)
    assert_eq(p.at(b, 0, 0.0, 1.0), 0.0)

    p.tick(0.25)

    // The same elapsed time, and the one asked to move twice as fast has moved twice as far.
    assert_eq(p.at(a, 0, 1.0, 1.0), 0.25)
    assert_eq(p.at(a, 1, 1.0, 2.0), 0.5)
    assert_eq(p.at(b, 0, 0.0, 1.0), 0.0)
end a_slot_and_a_rectangle_are_both_part_of_the_key

// **What nothing asked about during a frame is forgotten**, which is what stops the store growing
// for as long as the program runs: a row scrolled off the end, or a subtree behind a condition that
// turned false, leaves an entry nothing will ever ask about again.
@test
private an_animation_nothing_asked_about_is_swept()
    var p = phases()
    val r = Rect(0, 0, 10, 10)

    assert_eq(p.at(r, 0, 0.0, 1.0), 0.0)

    p.tick(0.25)

    assert_eq(p.at(r, 0, 1.0, 1.0), 0.25)

    // A frame in which nothing asks about it, and then another. The first tick keeps it (it was
    // touched during the frame before), the second drops it.
    p.tick(0.25)
    p.tick(0.25)

    // Asked about again it is new, so it starts settled rather than resuming from a quarter.
    assert_eq(p.at(r, 0, 1.0, 1.0), 1.0)
end an_animation_nothing_asked_about_is_swept

// **A recorder that is never ticked shows the settled appearance**, which is why every test above
// this section says nothing about time and still reads the way it always did.
@test
private a_canvas_with_no_clock_draws_everything_settled()
    val face = button("hi", () -> ())
    var c = recorder()

    c.point(50, 14)
    face.paint(&c, Rect(0, 0, 100, 28))

    assert(c.dump() == painted(lighten(dark().primary, dark().hover_lift)), s"got:\n${c.dump()}")
end a_canvas_with_no_clock_draws_everything_settled

// And a button that is hovered *after* it has been drawn eases, rather than snapping.
//
// The first paint is with the pointer away, which is what puts the phase in the store at zero; the
// pointer then arrives and each frame moves it `HOVER_RATE * dt` of the way.
@test
private a_button_eases_into_its_hover_rather_than_snapping()
    val face = button("hi", () -> ())
    val at = Rect(0, 0, 100, 28)
    var c = recorder()

    face.paint(&c, at)

    assert(c.dump() == painted(dark().primary), s"at rest:\n${c.dump()}")

    // The pointer arrives, and one frame of a sixtieth of a second passes.
    c.point(50, 14)
    c.tick(1.0 / 60.0)
    c.ops = buf()
    face.paint(&c, at)

    val part = HOVER_RATE / 60.0

    assert(c.dump() == painted(lighten(dark().primary, int(part * real(dark().hover_lift)))),
           s"one frame in:\n${c.dump()}")

    // Long enough to have arrived, and it is the full hover and no more.
    c.tick(1.0)
    c.ops = buf()
    face.paint(&c, at)

    assert(c.dump() == painted(lighten(dark().primary, dark().hover_lift)), s"settled:\n${c.dump()}")
end a_button_eases_into_its_hover_rather_than_snapping

// -- the plutovg backend's arithmetic -------------------------------------------------------------
//
// **Everything else in `pluto.sysl` is delegation, and delegation needs a real face and a real
// surface before a single claim about it can be checked.** A font is not something a package's own
// tests should have to find on the machine running them, so the three pieces that are decisions
// rather than forwarding are ordinary functions over ordinary values, and these are them.

// A colour channel arrives as zero-to-255 and PlutoVG wants zero-to-one.
@test
private a_colour_channel_becomes_a_fraction()
    assert_eq(fraction(0xFFFFFFu32, 16), 1.0)
    assert_eq(fraction(0x000000u32, 16), 0.0)
    assert_eq(fraction(0xFF0000u32, 16), 1.0)
    assert_eq(fraction(0xFF0000u32, 8), 0.0)
    assert_eq(fraction(0x0000FFu32, 0), 1.0)

    // The middle of the range, which is where a shift off by eight bits would still look plausible.
    assert_eq(fraction(0x008000u32, 8), 128.0 / 255.0)
end a_colour_channel_becomes_a_fraction

// **A border is drawn inside the rectangle layout settled on**, because PlutoVG centres a stroke on
// its path — so the path is inset by half the width, and the whole of the ink lands inside.
@test
private a_border_is_inset_by_half_its_width()
    assert(stroke_box(Rect(0, 0, 100, 40), 1) == Rect(0, 0, 100, 40),
           "a hairline sits on the edge, since half of one is none")
    assert(stroke_box(Rect(0, 0, 100, 40), 2) == Rect(1, 1, 98, 38), "half of two, off every side")
    assert(stroke_box(Rect(10, 20, 100, 40), 6) == Rect(13, 23, 94, 34), "and it moves the origin too")
end a_border_is_inset_by_half_its_width

// And the inset corner's radius comes in with it, or the stroke's outer edge would not follow the
// fill it is sitting on — a border round where its background is square, or the other way about.
@test
private an_inset_corner_takes_a_smaller_radius()
    assert_eq(stroke_radius(8, 2), 7)
    assert_eq(stroke_radius(8, 6), 5)

    // Never negative: a radius smaller than the inset is a square corner, not a curve turned inside
    // out.
    assert_eq(stroke_radius(1, 6), 0)
    assert_eq(stroke_radius(0, 2), 0)
end an_inset_corner_takes_a_smaller_radius

// **A face's `descent` is signed by whichever convention it carries**, and the two describe the same
// font — so a line height that believed the sign would be wrong for one of them.
@test
private a_line_height_reads_the_descent_whichever_way_it_is_signed()
    assert_eq(line_height(plutovg.Metrics(12.0, -4.0, 2.0)), 18)
    assert_eq(line_height(plutovg.Metrics(12.0, 4.0, 2.0)), 18)
    assert_eq(line_height(plutovg.Metrics(10.0, 0.0, 0.0)), 10)
end a_line_height_reads_the_descent_whichever_way_it_is_signed

// -- the controls ---------------------------------------------------------------------------------
//
// **Every one of these is asserted on the recording rather than on the widget**, which is the same
// discipline the rest of the file keeps: what a control *is* is what it draws and what it does with
// a tap, and a test that reached inside one to check a field would pass for a widget that painted
// nothing. The colours are written as the arithmetic that produced them and the geometry as
// literals, because the geometry is the half that can be wrong.

// A switch is a pill with a circle in it, and at rest the circle is at the left-hand end.
@test
private a_switch_off_has_its_knob_at_the_left_end()
    val on = signal(false)

    assert_paints(switch(on), Size(200, 200), Rect(0, 0, 44, 24),
                  s"fill 0,0 44x24 #${dark().inert} r12\n" +
                  s"fill 3,3 18x18 #${darken(WHITE, 8)} r9\n" +
                  "hit 0,0 44x24\n")
end a_switch_off_has_its_knob_at_the_left_end

// And on, the knob is at the other end and the track has taken the colour.
@test
private a_switch_on_has_its_knob_at_the_right_end_and_a_coloured_track()
    val on = signal(true)

    assert_paints(switch(on), Size(200, 200), Rect(0, 0, 44, 24),
                  s"fill 0,0 44x24 #${dark().primary} r12\n" +
                  s"fill 23,3 18x18 #${darken(WHITE, 8)} r9\n" +
                  "hit 0,0 44x24\n")
end a_switch_on_has_its_knob_at_the_right_end_and_a_coloured_track

// **The knob's position and the track's colour are one number**, so a switch caught mid-slide cannot
// be a coloured track with an unmoved knob. Both readings below come from the same phase: 42% of the
// way across is 8 pixels of the 20 it travels, and 42% of the way from the inert grey to the accent.
@test
private a_sliding_switch_moves_its_knob_and_its_track_together()
    val on = signal(false)
    val v = switch(on)
    var c = recorder()

    v.paint(&c, Rect(0, 0, 44, 24))

    on.set(true)
    c.ops = buf()
    c.tick(0.03)
    v.paint(&c, Rect(0, 0, 44, 24))

    assert(c.dump() == s"fill 0,0 44x24 #${mix(dark().inert, dark().primary, 42)} r12\n" +
                       s"fill 11,3 18x18 #${darken(WHITE, 8)} r9\n" +
                       "hit 0,0 44x24\n",
           s"a switch part way across:\n${c.dump()}")
end a_sliding_switch_moves_its_knob_and_its_track_together

// A tap flips the value, which is the whole of what a switch does.
@test
private a_switch_flips_the_signal_it_was_given()
    val on = signal(false)
    var c = recorder()

    switch(on).paint(&c, Rect(0, 0, 44, 24))

    assert(c.taps.tap(20, 12), "the region holds the point")
    assert(on.read(), "and the tap turned it on")

    assert(c.taps.tap(20, 12), "the same region, a second time")
    assert(!on.read(), "and it went back off, because a switch toggles rather than sets")
end a_switch_flips_the_signal_it_was_given

// An unchecked box is an outline with nothing in it. The mark has no area at all at rest, which is
// what the missing third `fill` below says.
@test
private an_unchecked_box_draws_no_mark()
    val on = signal(false)

    assert_paints(checkbox(on, "label"), Size(200, 200), Rect(0, 0, 66, 18),
                  s"fill 0,0 18x18 #${dark().ground} r4\n" +
                  s"stroke 0,0 18x18 #${dark().inert} w2 r4\n" +
                  "text 26,1 40x16 'label'\n" +
                  "hit 0,0 66x18\n")
end an_unchecked_box_draws_no_mark

// And a checked one is filled, outlined in the accent, and carries the mark.
@test
private a_checked_box_is_filled_and_marked()
    val on = signal(true)

    assert_paints(checkbox(on, "label"), Size(200, 200), Rect(0, 0, 66, 18),
                  s"fill 0,0 18x18 #${dark().primary} r4\n" +
                  s"stroke 0,0 18x18 #${dark().primary} w2 r4\n" +
                  s"fill 5,5 8x8 #${WHITE} r2\n" +
                  "text 26,1 40x16 'label'\n" +
                  "hit 0,0 66x18\n")
end a_checked_box_is_filled_and_marked

// **Pointing at the LABEL lights the BOX**, which is the composition the whole styling layer was
// built for arriving somewhere other than a button: the `Reactive` is the whole row, so the state it
// reports is the row's, and the box two levels down draws from it. Nothing had to be told.
@test
private pointing_at_a_checkbox_label_lights_its_box()
    val on = signal(false)
    val v = checkbox(on, "label")

    var away = recorder()
    var over = recorder()

    away.point(300, 300)
    over.point(50, 9)

    v.paint(&away, Rect(0, 0, 66, 18))
    v.paint(&over, Rect(0, 0, 66, 18))

    assert(away.dump() != over.dump(), "the pointer is on the label and the box knows")
    assert(over.dump() == s"fill 0,0 18x18 #${dark().ground} r4\n" +
                          s"stroke 0,0 18x18 #${lighten(dark().inert, 20)} w2 r4\n" +
                          "text 26,1 40x16 'label'\n" +
                          "hit 0,0 66x18\n",
           s"the lit outline:\n${over.dump()}")
end pointing_at_a_checkbox_label_lights_its_box

// The label is part of the control rather than text beside one, so a tap on it counts.
@test
private a_tap_on_a_checkbox_label_checks_it()
    val on = signal(false)
    var c = recorder()

    checkbox(on, "label").paint(&c, Rect(0, 0, 66, 18))

    assert(c.taps.tap(50, 9), "the region covers the label as well as the box")
    assert(on.read(), "and tapping the label checked it")
end a_tap_on_a_checkbox_label_checks_it

// An unchosen option is a ring and nothing else -- the same shape as an unchecked box with both
// radii at half the side, and the missing third `fill` is the dot it does not have yet.
@test
private an_unchosen_radio_draws_no_dot()
    val chosen = signal(1)

    assert_paints(radio(chosen, 0, "label"), Size(200, 200), Rect(0, 0, 66, 18),
                  s"fill 0,0 18x18 #${dark().ground} r9\n" +
                  s"stroke 0,0 18x18 #${dark().inert} w2 r9\n" +
                  "text 26,1 40x16 'label'\n" +
                  "hit 0,0 66x18\n")
end an_unchosen_radio_draws_no_dot

// And the chosen one is filled, ringed in the accent, and carries a dot that is round rather than
// square -- `r4` on an eight-pixel mark, which is the one number that distinguishes this paint from
// a checkbox's.
@test
private the_chosen_radio_is_filled_and_dotted()
    val chosen = signal(0)

    assert_paints(radio(chosen, 0, "label"), Size(200, 200), Rect(0, 0, 66, 18),
                  s"fill 0,0 18x18 #${dark().primary} r9\n" +
                  s"stroke 0,0 18x18 #${dark().primary} w2 r9\n" +
                  s"fill 5,5 8x8 #${dark().on_fill} r4\n" +
                  "text 26,1 40x16 'label'\n" +
                  "hit 0,0 66x18\n")
end the_chosen_radio_is_filled_and_dotted

// Pointing at the label lights the ring, for the reason the checkbox's does: the `Reactive` is the
// whole row, so a dot two levels down draws from the row's state and nothing had to be told.
@test
private pointing_at_a_radio_label_lights_its_ring()
    val chosen = signal(1)
    val v = radio(chosen, 0, "label")

    var away = recorder()
    var over = recorder()

    away.point(300, 300)
    over.point(50, 9)

    v.paint(&away, Rect(0, 0, 66, 18))
    v.paint(&over, Rect(0, 0, 66, 18))

    assert(away.dump() != over.dump(), "the pointer is on the label and the ring knows")
    assert(over.dump() == s"fill 0,0 18x18 #${dark().ground} r9\n" +
                          s"stroke 0,0 18x18 #${lighten(dark().inert, 20)} w2 r9\n" +
                          "text 26,1 40x16 'label'\n" +
                          "hit 0,0 66x18\n",
           s"the lit ring:\n${over.dump()}")
end pointing_at_a_radio_label_lights_its_ring

// **Choosing an option unchooses the others by construction**, which is the claim the whole design
// rests on: there is one `int`, so there is no state in which two options are on and no code
// anywhere that has to clear the previous one.
@test
private choosing_one_option_unchooses_the_rest()
    val chosen = signal(0)
    var c = recorder()

    radio_group(["a", "b", "c"], chosen).paint(&c, Rect(0, 0, 120, 66))

    assert(c.taps.tap(50, 30), "the second option's row holds the point")
    assert(chosen.read() == 1, s"the second option is chosen, not ${chosen.read()}")

    assert(c.taps.tap(50, 54), "the third option's row holds the point")
    assert(chosen.read() == 2, s"and choosing it left the second behind, not ${chosen.read()}")
end choosing_one_option_unchooses_the_rest

// **A radio sets and never clears**, which is what a second tap on the chosen option proves: a
// checkbox in the same place would have gone back off.
@test
private tapping_the_chosen_option_leaves_it_chosen()
    val chosen = signal(1)
    var c = recorder()

    radio_group(["a", "b", "c"], chosen).paint(&c, Rect(0, 0, 120, 66))

    assert(c.taps.tap(50, 30), "the chosen option's own row")
    assert(chosen.read() == 1, "and it is still chosen")
end tapping_the_chosen_option_leaves_it_chosen

// **And it writes nothing at all when it does, which is not a nicety.** A write moves the clock, an
// application repaints on a moved clock, so an unguarded `set` would repaint the window for every
// click on the option that was already on. The slider guards its drag for the same reason.
@test
private tapping_the_chosen_option_writes_nothing()
    val chosen = signal(1)
    var c = recorder()

    radio_group(["a", "b", "c"], chosen).paint(&c, Rect(0, 0, 120, 66))

    val before = writes()

    assert(c.taps.tap(50, 30), "the chosen option's own row")
    assert(writes() == before, "the clock did not move")

    assert(c.taps.tap(50, 6), "and now a different option")
    assert(writes() > before, "which did move it")
end tapping_the_chosen_option_writes_nothing

// A group is a column of its options and holds no invariant of its own -- so the same signal drives
// options built anywhere, and `radio` on its own is a first-class thing to write.
@test
private a_group_is_a_column_and_nothing_more()
    val chosen = signal(0)
    val group = radio_group(["a", "b"], chosen)
    val hand = column([radio(chosen, 0, "a"), radio(chosen, 1, "b")], 6)

    var one = recorder()
    var two = recorder()

    group.paint(&one, Rect(0, 0, 120, 42))
    hand.paint(&two, Rect(0, 0, 120, 42))

    assert(one.dump() == two.dump(), s"a group is its options in a column:\n${one.dump()}")
    assert(measured(group, Size(200, 200)) == Size(34, 42),
           s"two 18px rows and the 6px between them: ${measured(group, Size(200, 200)).w}x" +
           s"${measured(group, Size(200, 200)).h}")
end a_group_is_a_column_and_nothing_more

// **A slider reads the pointer's position, which no other control does**, and the value it computes
// is the fraction of the way along the part of the track the knob can actually reach.
@test
private a_pressed_slider_takes_its_value_from_where_the_pointer_is()
    val v = signal(0)
    val s = slider(v, 0, 100, 220)
    var c = recorder()

    // The knob is sixteen wide, so the travel is 204 and the middle of it is the knob's own centre.
    c.point(110, 8, true)
    s.paint(&c, Rect(0, 0, 220, 16))

    assert_eq(v.read(), 50)

    c.point(8, 8, true)
    s.paint(&c, Rect(0, 0, 220, 16))

    assert_eq(v.read(), 0)

    c.point(212, 8, true)
    s.paint(&c, Rect(0, 0, 220, 16))

    assert_eq(v.read(), 100)
end a_pressed_slider_takes_its_value_from_where_the_pointer_is

// **Both ends are reachable**, which is what the rounding in the arithmetic is for: a pointer past
// either end of the travel is clamped to it rather than producing a value outside the range.
@test
private a_drag_past_either_end_of_a_slider_stops_at_the_end()
    val v = signal(50)
    val s = slider(v, 0, 100, 220)
    var c = recorder()

    c.point(0, 8, true)
    s.paint(&c, Rect(0, 0, 220, 16))

    assert_eq(v.read(), 0)

    c.point(219, 8, true)
    s.paint(&c, Rect(0, 0, 220, 16))

    assert_eq(v.read(), 100)
end a_drag_past_either_end_of_a_slider_stops_at_the_end

// A pointer merely resting on a slider moves nothing.
@test
private a_slider_the_pointer_is_only_hovering_is_not_dragged()
    val v = signal(30)
    var c = recorder()

    c.point(110, 8)
    slider(v, 0, 100, 220).paint(&c, Rect(0, 0, 220, 16))

    assert_eq(v.read(), 30)
end a_slider_the_pointer_is_only_hovering_is_not_dragged

// **The write is guarded on the value actually changing, and the guard is load-bearing**: a signal
// write notifies, an application's notify marks the frame dirty, and an unguarded write would mark
// every frame dirty for as long as a pointer rested on a slider nobody was moving.
@test
private a_slider_writes_only_when_the_value_moves()
    val v = signal(0)
    val n = signal(0)
    val bump: &Fn() -> unit = () -> n.set(n.read() + 1)

    v.watch(bump)

    val s = slider(v, 0, 100, 220)
    var c = recorder()

    c.point(110, 8, true)
    s.paint(&c, Rect(0, 0, 220, 16))
    s.paint(&c, Rect(0, 0, 220, 16))
    s.paint(&c, Rect(0, 0, 220, 16))

    assert_eq(v.read(), 50)
    assert_eq(n.read(), 1)
end a_slider_writes_only_when_the_value_moves

// The track, the part of it that is filled, and the knob -- and the knob sits at the value.
@test
private a_slider_draws_its_track_its_fill_and_its_knob()
    val v = signal(50)

    assert_paints(slider(v, 0, 100, 220), Size(300, 300), Rect(0, 0, 220, 16),
                  s"fill 0,5 220x6 #${dark().inert} r3\n" +
                  s"fill 0,5 110x6 #${dark().primary} r3\n" +
                  s"fill 102,0 16x16 #${lighten(dark().primary, 30)} r8\n" +
                  "hit 0,0 220x16\n")
end a_slider_draws_its_track_its_fill_and_its_knob

// Two reals within a rounding error of each other. A step of `0.1` is not exactly a tenth, so a value
// six steps along is `0.6000000000000001`, and that is the value a person dragged to.
private close(a: real, b: real) -> bool = a - b < 1e-9 && b - a < 1e-9

// Paint `s` once with the pointer held down at `x`, which is a drag to there.
private drag_to(s: &View, c: *Recorder, x: int)
    c.point(x, 8, true)
    s.paint(c, Rect(0, 0, 220, 16))

// **A real slider maps the track the way an int one does**, and lands on a whole number of steps
// from `lo`. The travel is 204, so a pointer 51 pixels along it is a quarter of the way.
@test
private a_real_slider_takes_its_value_from_where_the_pointer_is()
    val v = signal(0.0)
    val s = slider(v, 0.0, 1.0, 220, step = 0.01)
    var c = recorder()

    drag_to(s, &c, 8 + 51)
    assert(close(v.read(), 0.25), s"${v.read()}")

    drag_to(s, &c, 8 + 102)
    assert(close(v.read(), 0.5), s"${v.read()}")

// **The value snaps to the nearest step**: 61 pixels is 0.299 of the way, which is nearer 0.25 than
// 0.5, and 82 is 0.402, nearer 0.5.
@test
private a_real_slider_snaps_to_its_step()
    val v = signal(0.0)
    val s = slider(v, 0.0, 1.0, 220, step = 0.25)
    var c = recorder()

    drag_to(s, &c, 8 + 61)
    assert_eq(v.read(), 0.25)

    drag_to(s, &c, 8 + 82)
    assert_eq(v.read(), 0.5)

// The grid starts at `lo`, not at zero, and a drag past either end stops at that end.
@test
private a_real_slider_counts_its_steps_from_lo_and_stops_at_either_end()
    val v = signal(0.0)
    val s = slider(v, 20.0, 2020.0, 220, step = 10.0)
    var c = recorder()

    drag_to(s, &c, 8 + 51)
    assert_eq(v.read(), 520.0)

    drag_to(s, &c, 0)
    assert_eq(v.read(), 20.0)

    drag_to(s, &c, 219)
    assert_eq(v.read(), 2020.0)

// A range either side of zero: its middle is zero, and its bottom is `lo`.
@test
private a_real_slider_with_a_negative_lo_has_zero_in_the_middle()
    val v = signal(1.0)
    val s = slider(v, -1.0, 1.0, 220, step = 0.5)
    var c = recorder()

    drag_to(s, &c, 8 + 102)
    assert_eq(v.read(), 0.0)

    drag_to(s, &c, 0)
    assert_eq(v.read(), -1.0)

// **A step that does not divide the range leaves `hi` unreachable**: the far end is the last step
// that fits, so every value the slider can hold is one the keyboard can return to.
@test
private a_step_that_does_not_divide_the_range_stops_at_the_last_one_that_fits()
    val r = signal(0.0)
    var c = recorder()

    drag_to(slider(r, 0.0, 1.0, 220, step = 0.4), &c, 219)
    assert_eq(r.read(), 0.8)

    val n = signal(0)

    drag_to(slider(n, 0, 10, 220, step = 3), &c, 219)
    assert_eq(n.read(), 9)

// An int slider takes a step too, and its default of one is the slider it always was.
@test
private an_int_slider_snaps_to_its_step()
    val v = signal(0)
    val s = slider(v, 0, 100, 220, step = 5)
    var c = recorder()

    drag_to(s, &c, 8 + 61)
    assert_eq(v.read(), 30)

    drag_to(s, &c, 8 + 102)
    assert_eq(v.read(), 50)

// **A real slider given no step has no grid**: it takes whatever fraction of the travel the pointer
// is at, so 61 pixels is 61/204 of the way rather than the nearest hundredth or the nearest one.
@test
private a_real_slider_with_no_step_follows_the_pointer()
    val v = signal(0.0)
    val s = slider(v, 0.0, 1.0, 220)
    var c = recorder()

    drag_to(s, &c, 8 + 51)
    assert_eq(v.read(), 0.25)

    drag_to(s, &c, 8 + 61)
    assert_eq(v.read(), 61.0 / 204.0)

    drag_to(s, &c, 8 + 62)
    assert_eq(v.read(), 62.0 / 204.0)

// A step of zero, written out, is the same slider as no step at all.
@test
private a_real_slider_with_a_zero_step_follows_the_pointer()
    val v = signal(0.0)
    var c = recorder()

    drag_to(slider(v, 0.0, 1.0, 220, step = 0.0), &c, 8 + 61)
    assert_eq(v.read(), 61.0 / 204.0)

// **An int slider given no step moves by whole numbers and rounds to the nearest**, as it did when
// its default step was one: 61 pixels of 204 is 29.9 of 100, which rounds to 30 where truncating
// would say 29, and 1 pixel is 0.49, which rounds down to 0.
@test
private an_int_slider_with_no_step_rounds_to_whole_numbers()
    val v = signal(0)
    val s = slider(v, 0, 100, 220)
    var c = recorder()

    drag_to(s, &c, 8 + 61)
    assert_eq(v.read(), 30)

    drag_to(s, &c, 8 + 1)
    assert_eq(v.read(), 0)

    drag_to(s, &c, 8 + 3)
    assert_eq(v.read(), 1)

// An int step of two lands on even numbers from `lo`: 61 pixels is 2.99 of 10, which a step of one
// would round to 3 and a step of two takes to 2.
@test
private an_int_slider_snaps_to_a_step_of_two()
    val v = signal(0)
    val s = slider(v, 0, 10, 220, step = 2)
    var c = recorder()

    drag_to(s, &c, 8 + 61)
    assert_eq(v.read(), 2)

    drag_to(s, &c, 8 + 82)
    assert_eq(v.read(), 4)

    drag_to(s, &c, 219)
    assert_eq(v.read(), 10)

// The knob of a real slider sits at its value exactly as an int one's does.
@test
private a_real_slider_draws_its_knob_at_its_value()
    val v = signal(0.5)

    assert_paints(slider(v, 0.0, 1.0, 220, step = 0.1), Size(300, 300), Rect(0, 0, 220, 16),
                  s"fill 0,5 220x6 #${dark().inert} r3\n" +
                  s"fill 0,5 110x6 #${dark().primary} r3\n" +
                  s"fill 102,0 16x16 #${lighten(dark().primary, 30)} r8\n" +
                  "hit 0,0 220x16\n")

// Tap a slider and end that frame, as `render` would, leaving the pointer up where it was.
private tap(s: &View, c: *Recorder, x: int)
    c.point(x, 8, true)
    s.paint(c, Rect(0, 0, 220, 16))
    c.keys_done()
    c.point(x, 8, false)

// Paint a frame that delivers `keys`, and end it.
private keys(s: &View, c: *Recorder, ks: []Key)
    for k in ks
        c.key(press(k))

    s.paint(c, Rect(0, 0, 220, 16))
    c.keys_done()

// **A slider with an id takes the arrows once tapped**, a step per press, two presses in a frame
// being two steps; Home and End go to the ends, and neither end is passed.
@test
private a_tapped_slider_steps_with_the_arrow_keys()
    val v = signal(0.0)
    val s = slider(v, 0.0, 1.0, 220, step = 0.1, id = 1)
    var c = recorder()

    tap(s, &c, 8 + 102)
    assert(close(v.read(), 0.5), s"${v.read()}")

    keys(s, &c, [Key.Right])
    assert(close(v.read(), 0.6), s"${v.read()}")

    keys(s, &c, [Key.Up, Key.Up])
    assert(close(v.read(), 0.8), s"${v.read()}")

    keys(s, &c, [Key.Left, Key.Down, Key.Down])
    assert(close(v.read(), 0.5), s"${v.read()}")

    keys(s, &c, [Key.End, Key.Right])
    assert_eq(v.read(), 1.0)

    keys(s, &c, [Key.Home, Key.Left])
    assert_eq(v.read(), 0.0)
end a_tapped_slider_steps_with_the_arrow_keys

// **A slider nobody gave an id takes no keys**, which is what keeps every slider written before
// the keyboard reached them exactly as it was.
@test
private a_slider_with_no_id_takes_no_keys()
    val v = signal(0)
    val s = slider(v, 0, 100, 220)
    var c = recorder()

    tap(s, &c, 8 + 102)
    keys(s, &c, [Key.Right, Key.End])

    assert_eq(v.read(), 50)

// A progress bar clamps rather than drawing outside itself, and an empty one draws no fill at all.
@test
private a_progress_bar_clamps_at_both_ends()
    assert_paints(progress(1.5, 200), Size(300, 300), Rect(0, 0, 200, 6),
                  s"fill 0,0 200x6 #${dark().inert} r3\n" +
                  s"fill 0,0 200x6 #${dark().primary} r3\n")

    assert_paints(progress(-0.5, 200), Size(300, 300), Rect(0, 0, 200, 6),
                  s"fill 0,0 200x6 #${dark().inert} r3\n")
end a_progress_bar_clamps_at_both_ends

// **It eases toward the fraction rather than jumping to it**, so a bar fed by a task that reports in
// steps reads as motion. Four per second for a tenth of a second is four hundredths of the way.
@test
private a_progress_bar_eases_toward_a_new_fraction()
    var c = recorder()

    progress(0.0, 200).paint(&c, Rect(0, 0, 200, 6))

    c.ops = buf()
    c.tick(0.1)
    progress(1.0, 200).paint(&c, Rect(0, 0, 200, 6))

    assert(c.dump() == s"fill 0,0 200x6 #${dark().inert} r3\n" +
                       s"fill 0,0 80x6 #${dark().primary} r3\n",
           s"a bar part of the way along:\n${c.dump()}")
end a_progress_bar_eases_toward_a_new_fraction

// The last thing a meter paints is its needle, so the needle is the recording's last line -- or the
// band, or a tick, when there is no needle to paint.
private last_painted(v: &View) -> string
    var c = recorder()

    v.paint(&c, Rect(0, 0, 220, 20))

    val ops = c.ops.view()
    ops[ops.len - 1]
end last_painted

// A tuner's scale: fifty cents either way, in tune within five. Two hundred and twenty pixels less a
// four-pixel needle is two hundred and sixteen of travel.
private tuner(cents: real) -> &View = meter(cents, -50.0, 50.0, 220, band = 5.0)

private needle_at(x: int, color: u32) -> string = s"fill ${x},0 4x20 #${color} r2"

@test
private a_meter_asks_for_its_width_and_its_own_height()
    assert(measured(tuner(0.0), Size(300, 300)) == Size(220, 20), "the width asked for, twenty tall")

// **The needle lands where the reading is on the scale**: the two ends at the two ends of the travel,
// the middle at the middle, and a reading between them in proportion -- -20 is three tenths of the
// way along, 64.8 pixels, which rounds to 65.
@test
private a_meter_needle_sits_at_the_reading()
    val off = dark().primary

    assert(last_painted(tuner(-50.0)) == needle_at(0, off), last_painted(tuner(-50.0)))
    assert(last_painted(tuner(50.0)) == needle_at(216, off), last_painted(tuner(50.0)))
    assert(last_painted(tuner(-20.0)) == needle_at(65, off), last_painted(tuner(-20.0)))
    assert(last_painted(tuner(25.0)) == needle_at(162, off), last_painted(tuner(25.0)))
    assert(last_painted(tuner(0.0)) == needle_at(108, dark().success), last_painted(tuner(0.0)))
end a_meter_needle_sits_at_the_reading

// A reading past either end pins to that end rather than drawing outside the meter.
@test
private a_meter_pins_a_reading_past_either_end()
    val off = dark().primary

    assert(last_painted(tuner(-400.0)) == needle_at(0, off), last_painted(tuner(-400.0)))
    assert(last_painted(tuner(75.0)) == needle_at(216, off), last_painted(tuner(75.0)))
end a_meter_pins_a_reading_past_either_end

// **The band is shaded across the track, from five cents flat to five sharp**: 0.45 and 0.55 of the
// travel, plus the half-needle that puts a position at the needle's centre.
@test
private a_meter_shades_its_band_across_the_track()
    var c = recorder()

    tuner(30.0).paint(&c, Rect(0, 0, 220, 20))

    val band = s"fill 99,7 22x6 #${mix(dark().inert, dark().success, 55)} r3"

    assert(c.dump().contains(band), s"expected ${band} in:\n${c.dump()}")

    var bare = recorder()

    meter(30.0, -50.0, 50.0, 220).paint(&bare, Rect(0, 0, 220, 20))
    assert(!bare.dump().contains("22x6"), s"a meter with no band shades nothing:\n${bare.dump()}")
end a_meter_shades_its_band_across_the_track

// **The needle turns to the theme's success colour exactly at the band's edge, on both sides**, since
// the band is a claim about the reading and a reading of exactly five cents is in tune.
@test
private a_meter_needle_turns_at_the_band_edge()
    val ok = dark().success
    val off = dark().primary

    assert(last_painted(tuner(5.0)).ends_with(s"#${ok} r2"), last_painted(tuner(5.0)))
    assert(last_painted(tuner(5.001)).ends_with(s"#${off} r2"), last_painted(tuner(5.001)))
    assert(last_painted(tuner(-5.0)).ends_with(s"#${ok} r2"), last_painted(tuner(-5.0)))
    assert(last_painted(tuner(-5.001)).ends_with(s"#${off} r2"), last_painted(tuner(-5.001)))

    // Around a target that is not zero, the band follows it.
    val level = meter(0.8, 0.0, 1.0, 220, band = 0.1, target = 0.75)

    assert(last_painted(level).ends_with(s"#${ok} r2"), last_painted(level))
end a_meter_needle_turns_at_the_band_edge

// **Ticks at the tenths, and major ones at the two ends and at the target**, each centred where a
// needle at that value would be centred. The target's tenth is drawn once, as the major one.
@test
private a_meter_marks_its_ends_and_its_target_as_major_ticks()
    var c = recorder()

    tuner(30.0).paint(&c, Rect(0, 0, 220, 20))

    val major = mix(dark().inert, dark().ink, 40)
    val d = c.dump()

    assert(d.contains(s"fill 1,2 2x16 #${major}\n"), d)
    assert(d.contains(s"fill 217,2 2x16 #${major}\n"), d)
    assert(d.contains(s"fill 109,2 2x16 #${major}\n"), d)
    assert(d.contains(s"fill 23,5 2x10 #${dark().inert}\n"), d)
    assert(!d.contains("fill 109,5 2x10"), s"the target is not also a minor tick:\n${d}")
end a_meter_marks_its_ends_and_its_target_as_major_ticks

// A reading that is not a number draws no needle, so the last thing painted is the band.
@test
private a_meter_draws_no_needle_for_a_reading_that_is_not_a_number()
    val last = last_painted(tuner(real.nan()))

    assert(!last.contains("4x20"), s"no needle: ${last}")
    assert(last.contains("22x6"), s"the band is still there: ${last}")
end a_meter_draws_no_needle_for_a_reading_that_is_not_a_number

// **The needle eases toward a new reading**, as a progress bar's fill does: six per second for a
// tenth of a second is six tenths of the way from one end to the other, 129.6 pixels.
@test
private a_meter_needle_eases_toward_a_new_reading()
    var c = recorder()

    tuner(-50.0).paint(&c, Rect(0, 0, 220, 20))

    c.ops = buf()
    c.tick(0.1)
    tuner(50.0).paint(&c, Rect(0, 0, 220, 20))

    val ops = c.ops.view()

    assert(ops[ops.len - 1] == needle_at(130, dark().primary), s"part of the way:\n${c.dump()}")
end a_meter_needle_eases_toward_a_new_reading

// **A divider asks for no width and paints across all of it**, which is how it fills its container
// without knowing what its container is.
@test
private a_divider_asks_for_no_width_and_paints_across_what_it_is_given()
    assert(measured(divider(), Size(300, 300)) == Size(0, 1), "no width, one pixel tall")

    assert_paints(divider(3), Size(300, 300), Rect(0, 40, 300, 3),
                  s"fill 0,40 300x3 #${dark().edge}\n")

    // And it takes the theme's edge, so a restyled section's rules move with it.
    assert_paints(divider().restyle(t -> t with { edge = 0xFF0000u32 }),
                  Size(300, 300), Rect(0, 40, 300, 1), "fill 0,40 300x1 #16711680\n")
end a_divider_asks_for_no_width_and_paints_across_what_it_is_given

// -- what a backend does NOT have to write --------------------------------------------------------

// `Blind` -- in `canvas.sysl`, because an `impl` may not sit in a file that said `@tests` -- is the
// smallest thing that satisfies the trait, and these two tests are why it is worth shipping.
//
// **They are the only way to check the two defaulted members are inherited rather than merely
// declared.** `Recorder` and `PlutoCanvas` both override both, so without a third backend nothing in
// the package would ever run the trait's own bodies.

// A backend with no clock draws everything settled, so animation is something a backend opts into
// rather than something every backend owes.
@test
private a_backend_with_no_clock_is_handed_the_target_outright()
    var b = blind()

    assert_eq(b.phase(Rect(0, 0, 10, 10), 0, 0.75, 1.0), 0.75)
    assert_eq(b.phase(Rect(0, 0, 10, 10), 0, 0.0, 1.0), 0.0)
end a_backend_with_no_clock_is_handed_the_target_outright

// And one with no pointer answers a position no rectangle contains, which is what "nothing is
// pointing at this" looks like when the answer has to be a coordinate rather than a flag.
@test
private a_backend_with_no_pointer_answers_off_the_surface()
    var b = blind()
    val (x, y) = b.pointer()

    assert(x == -1 && y == -1, "off the surface")
    assert(!Rect(0, 0, 1000, 1000).holds(x, y), "and no rectangle holds it")
end a_backend_with_no_pointer_answers_off_the_surface

// The recorder does have one, and it is the same one `hovered` and `pressed` answer from.
@test
private a_recorder_reports_the_pointer_it_was_given()
    var c = recorder()
    val (x0, y0) = c.pointer()

    assert(x0 == -1 && y0 == -1, "a fresh recorder's pointer is off the surface")

    c.point(37, 91, true)

    val (x1, y1) = c.pointer()

    assert(x1 == 37 && y1 == 91, "and it moves where it is put")
end a_recorder_reports_the_pointer_it_was_given

// -- culling --------------------------------------------------------------------------------------

// **Nothing is culled where nothing is clipped**, which is the case that must not regress: a plain
// column on a canvas that was never given a clip paints every child, and a `visible` that answered
// too eagerly would silently empty half the interface.
@test
private a_column_with_no_clip_paints_all_of_its_children()
    var c = recorder()

    column([text("a"), text("b"), text("c")], 0).paint(&c, Rect(0, 0, 100, 8))

    assert(c.dump() == "text 0,0 100x16 'a'\ntext 0,16 100x16 'b'\ntext 0,32 100x16 'c'\n",
           s"even a child taller than the rectangle it was given:\n${c.dump()}")
end a_column_with_no_clip_paints_all_of_its_children

// A row culls on the other axis, which is the same code and a different rectangle.
@test
private a_row_skips_children_past_the_edge_of_a_clip()
    var c = recorder()

    c.clip(Rect(0, 0, 30, 20))
    column([row([text("aa"), text("bb"), text("cc")], 0)], 0).paint(&c, Rect(0, 0, 100, 20))
    c.unclip()

    assert(c.dump() == "clip 0,0 30x20\ntext 0,0 16x16 'aa'\ntext 16,0 16x16 'bb'\nunclip\n",
           s"the third run starts at 32, past the clip:\n${c.dump()}")
end a_row_skips_children_past_the_edge_of_a_clip

// **A culled child registers no hit region either**, which is a correctness claim rather than a
// performance one: a row scrolled out of sight must not answer a click at the place it would have
// been, and before culling it would have -- the region was recorded from a paint nobody could see.
@test
private a_culled_row_cannot_be_clicked()
    val hit = signal(0)
    val bump: &Fn() -> unit = () -> hit.set(hit.read() + 1)
    val offset = signal(1000)
    var c = recorder()

    scroll(column([text("a").on_tap(bump)], 0), offset, 40).paint(&c, Rect(0, 0, 100, 40))

    assert(c.taps.len() == 0usize, "a row a thousand pixels above the window offers nothing to click")
    assert(!c.taps.tap(50, 20), "and a click in the window lands on nothing")
    assert_eq(hit.read(), 0)
end a_culled_row_cannot_be_clicked

// **Nested clips intersect**, so an inner clip cannot widen an outer one. A container inside two
// scrollers is judged against what both of them leave, which is what `meet` is for.
@test
private a_nested_clip_narrows_and_never_widens()
    var c = recorder()

    c.clip(Rect(0, 0, 100, 40))
    c.clip(Rect(0, 0, 100, 16))

    assert(c.visible(Rect(0, 0, 100, 10)), "inside both")
    assert(!c.visible(Rect(0, 20, 100, 10)), "inside the outer one and outside the inner")

    c.unclip()

    assert(c.visible(Rect(0, 20, 100, 10)), "and the outer one is what is left when the inner ends")

    c.unclip()

    assert(c.visible(Rect(0, 4000, 100, 10)), "with no clip at all, everything is visible")
end a_nested_clip_narrows_and_never_widens

// Two clips that do not touch leave nothing, and `meet` has to say so rather than producing a
// rectangle with a negative side that `overlaps` would then read as covering the plane.
@test
private two_clips_that_do_not_touch_leave_nothing_visible()
    var c = recorder()

    c.clip(Rect(0, 0, 20, 20))
    c.clip(Rect(50, 50, 20, 20))

    assert(!c.visible(Rect(0, 0, 20, 20)), "not in the second")
    assert(!c.visible(Rect(50, 50, 20, 20)), "not in the first")
    assert(!c.visible(Rect(0, 0, 1000, 1000)), "and nothing is, because they share no area")
end two_clips_that_do_not_touch_leave_nothing_visible

// A backend that tracks no clip answers `true`, so not implementing `visible` costs the saving and
// never the picture. That is the right way round for a default: the failure mode is a correct frame.
@test
private a_backend_that_tracks_no_clip_draws_everything()
    var b = blind()

    assert(b.visible(Rect(-9000, -9000, 1, 1)), "everything is visible to a backend with no opinion")
end a_backend_that_tracks_no_clip_draws_everything

// Two rectangles overlap when they share area, and touching along an edge is not sharing area.
@test
private overlapping_is_shared_area_and_not_a_shared_edge()
    val r = Rect(10, 10, 20, 20)

    assert(r.overlaps(Rect(20, 20, 20, 20)), "a corner's worth is enough")
    assert(r.overlaps(Rect(0, 0, 100, 100)), "and one inside the other counts from either side")
    assert(!r.overlaps(Rect(30, 10, 20, 20)), "flush against the right edge shares no area")
    assert(!r.overlaps(Rect(10, 30, 20, 20)), "nor flush below")
    assert(!r.overlaps(Rect(10, 10, 0, 20)), "an empty rectangle overlaps nothing, not even itself")
    assert(!Rect(0, 0, 1000, 1000).overlaps(Rect(50, 50, 0, 0)),
           "and a wide one straddling an empty one's single coordinate still shares no area with it")
end overlapping_is_shared_area_and_not_a_shared_edge

// -- a control given more room than it asked for --------------------------------------------------
//
// **A `Row` gives every child the height of the tallest one and a `Column` gives every child the
// column's whole width**, so a control is routinely handed a rectangle larger than it measured to.
// What it does about that is invisible to a test that paints it at exactly its own size, which is
// how a slider shipped with its knob three pixels above its own track.

// The knob and the track share a centre line whatever height the row turns out to be.
@test
private a_slider_in_a_taller_row_centres_its_knob_on_its_track()
    val v = signal(50)
    var c = recorder()

    // Sixteen tall by nature, handed twenty-six -- what sitting beside a padded label does to it.
    slider(v, 0, 100, 220).paint(&c, Rect(0, 0, 220, 26))

    assert(c.dump() == s"fill 0,10 220x6 #${dark().inert} r3\n" +
                       s"fill 0,10 110x6 #${dark().primary} r3\n" +
                       s"fill 102,5 16x16 #${lighten(dark().primary, 30)} r8\n" +
                       "hit 0,0 220x26\n",
           s"the track's centre is 13 and so is the knob's:\n${c.dump()}")
end a_slider_in_a_taller_row_centres_its_knob_on_its_track

// A switch keeps its own shape rather than stretching into whatever it was handed -- a pill drawn
// across a column's full width is not a switch.
@test
private a_switch_keeps_its_own_size_in_a_bigger_rectangle()
    val on = signal(false)
    var c = recorder()

    switch(on).paint(&c, Rect(0, 0, 300, 40))

    assert(c.dump() == s"fill 0,8 44x24 #${dark().inert} r12\n" +
                       s"fill 3,11 18x18 #${darken(WHITE, 8)} r9\n" +
                       "hit 0,0 300x40\n",
           s"forty-four by twenty-four, eight down:\n${c.dump()}")
end a_switch_keeps_its_own_size_in_a_bigger_rectangle

// And the whole of what it was given still answers to a tap: a control handed more room than it
// draws in is still the thing at that place on the line.
@test
private a_control_is_tappable_across_all_it_was_given()
    val on = signal(false)
    var c = recorder()

    switch(on).paint(&c, Rect(0, 0, 300, 40))

    assert(c.taps.tap(280, 36), "the far corner of the rectangle, well outside the pill")
    assert(on.read(), "and it flipped")
end a_control_is_tappable_across_all_it_was_given

// A progress bar is six tall wherever it is put, rather than a rounded rectangle as tall as its row.
@test
private a_progress_bar_keeps_its_thickness()
    assert_paints(progress(0.5, 200), Size(300, 300), Rect(0, 0, 200, 30),
                  s"fill 0,12 200x6 #${dark().inert} r3\n" +
                  s"fill 0,12 100x6 #${dark().primary} r3\n")
end a_progress_bar_keeps_its_thickness

// **A label is centred in the rectangle it was given rather than drawn at the top of it**, which is
// the same rule the controls follow and was found the same way: a checkbox's label sat two pixels
// above its box, because a `Row` gives every child the height of the tallest and the box is taller
// than a line of text.
@test
private a_label_is_centred_in_a_rectangle_taller_than_its_line()
    assert_paints(text("hi"), Size(200, 200), Rect(0, 0, 100, 40), "text 0,12 100x16 'hi'\n")

    // Given exactly its own height, nothing moves -- which is the case every other recording in
    // this file is written in terms of.
    assert_paints(text("hi"), Size(200, 200), Rect(0, 0, 100, 16), "text 0,0 100x16 'hi'\n")

    // And given less, it takes what there is rather than centring itself outside it.
    assert_paints(text("hi"), Size(200, 200), Rect(0, 0, 100, 8), "text 0,0 100x8 'hi'\n")
end a_label_is_centred_in_a_rectangle_taller_than_its_line

// -- the scrollbar --------------------------------------------------------------------------------

// **A list that fits gets no bar at all**, because a full-height thumb says nothing and would cover
// content that has no reason to be covered.
@test
private a_list_that_fits_its_window_shows_no_bar()
    val offset = signal(0)
    var c = recorder()

    scroll(column([text("a"), text("b")], 0), offset, 40).paint(&c, Rect(0, 0, 100, 40))

    assert(c.dump() == "clip 0,0 100x40\ntext 0,0 100x16 'a'\ntext 0,16 100x16 'b'\nunclip\n",
           s"thirty-two pixels of content in a forty-pixel window:\n${c.dump()}")
end a_list_that_fits_its_window_shows_no_bar

// **The thumb is as much of the track as the window is of the content**, which is what makes a
// scrollbar report how much there is as well as where you are.
@test
private a_thumb_is_the_windows_share_of_the_content()
    val offset = signal(0)
    var c = recorder()

    // A hundred rows of sixteen is sixteen hundred, seen through a two-hundred-pixel window: an
    // eighth, so twenty-five of the two hundred.
    scroll(column(generate(100usize, i -> text("x")), 0), offset, 200).paint(&c, Rect(0, 0, 100, 200))

    assert(c.dump().contains(s"fill 92,0 8x25 #${lighten(dark().inert, 25)} r4"),
           s"an eighth of the track, at the top:\n${c.dump()}")
end a_thumb_is_the_windows_share_of_the_content

// And it stops shrinking, or a long enough list leaves nothing to take hold of.
@test
private a_thumb_never_shrinks_past_taking_hold_of()
    val offset = signal(0)
    var c = recorder()

    scroll(column(generate(2000usize, i -> text("x")), 0), offset, 200).paint(&c, Rect(0, 0, 100, 200))

    assert(c.dump().contains(s"fill 92,0 8x24 #${lighten(dark().inert, 25)} r4"),
           s"two thousand rows would ask for a thumb one pixel tall:\n${c.dump()}")
end a_thumb_never_shrinks_past_taking_hold_of

// The thumb sits at the fraction of its travel the offset is of the content's, so the bottom of the
// list puts it at the bottom of the track and not one thumb past it.
@test
private a_thumb_at_the_end_of_the_list_is_at_the_end_of_its_track()
    val offset = signal(0)
    val list = scroll(column(generate(20usize, i -> text("x")), 0), offset, 100)

    var top = recorder()
    var bottom = recorder()

    // Twenty rows is 320 tall in a 100 window, so the content travels 220 and the thumb travels
    // 100 - 31 = 69.
    list.paint(&top, Rect(0, 0, 100, 100))

    offset.set(220)
    list.paint(&bottom, Rect(0, 0, 100, 100))

    assert(top.dump().contains(s"fill 92,0 8x31 #${lighten(dark().inert, 25)} r4"), s"at the top:\n${top.dump()}")
    assert(bottom.dump().contains(s"fill 92,69 8x31 #${lighten(dark().inert, 25)} r4"), s"at the end:\n${bottom.dump()}")
end a_thumb_at_the_end_of_the_list_is_at_the_end_of_its_track

// **Dragging the bar scrolls the list**, by the same arithmetic the slider does on the other axis:
// the thumb is taken by its middle, so it lands where the pointer is.
@test
private dragging_the_thumb_moves_the_offset()
    val offset = signal(0)
    val list = scroll(column(generate(20usize, i -> text("x")), 0), offset, 100)
    var c = recorder()

    // Half way down the thumb's travel, which is 69: 15 + 34 is the middle of the track.
    c.point(96, 34 + 15, true)
    list.paint(&c, Rect(0, 0, 100, 100))

    assert_eq(offset.read(), 108)

    // **The clamp is within the track**, because the thumb is taken by its middle: a pointer at the
    // very bottom would otherwise ask for half a thumb past the end of the list.
    c.point(96, 99, true)
    list.paint(&c, Rect(0, 0, 100, 100))

    assert_eq(offset.read(), 220)

    c.point(96, 0, true)
    list.paint(&c, Rect(0, 0, 100, 100))

    assert_eq(offset.read(), 0)
end dragging_the_thumb_moves_the_offset

// **A drag that has left the bar keeps scrolling**, which is the whole point of capturing the
// pointer: a thumb is eight pixels wide and nobody can keep a pointer inside one while dragging it
// the length of a window. This test used to assert the opposite, and the opposite was a defect.
@test
private a_drag_that_has_left_the_bar_keeps_scrolling()
    val offset = signal(0)
    val list = scroll(column(generate(20usize, i -> text("x")), 0), offset, 100)
    var c = recorder()

    c.point(96, 49, true)
    list.paint(&c, Rect(0, 0, 100, 100))

    val was = offset.read()

    assert(was > 0, "it scrolled while the pointer was on the bar")

    // Still held, now far outside the bar -- off the left of the window entirely.
    c.point(-200, 90, true)
    list.paint(&c, Rect(0, 0, 100, 100))

    assert(offset.read() > was, "and it followed the pointer down anyway")

    // Released: the grab ends, and a move afterwards does nothing.
    val settled = offset.read()

    c.point(-200, 10, false)
    list.paint(&c, Rect(0, 0, 100, 100))

    assert_eq(offset.read(), settled)
end a_drag_that_has_left_the_bar_keeps_scrolling

// And a pointer merely resting on the bar moves nothing, which is the same guard the slider has and
// for the same reason: an unguarded write would mark every frame dirty.
@test
private a_pointer_resting_on_the_bar_does_not_scroll()
    val offset = signal(50)
    val n = signal(0)
    val bump: &Fn() -> unit = () -> n.set(n.read() + 1)

    offset.watch(bump)

    val list = scroll(column(generate(20usize, i -> text("x")), 0), offset, 100)
    var c = recorder()

    c.point(96, 50)
    list.paint(&c, Rect(0, 0, 100, 100))

    assert_eq(offset.read(), 50)
    assert_eq(n.read(), 0)
end a_pointer_resting_on_the_bar_does_not_scroll

// -- scrolling by touch and by wheel ----------------------------------------------------------------
//
// Twenty rows of sixteen in a window of a hundred, so the content can travel 220.

private long_list(offset: &Signal[int]) -> &View =
    scroll(column(generate(20usize, i -> text("x")), 0), offset, 100)

// **A press that travels past the slop drags the content, and by exactly the pointer's travel** --
// the first answer carries the slop as well, so the row under the finger stays under it.
@test
private a_drag_past_the_slop_scrolls_by_the_pointer_travel()
    val offset = signal(0)
    val list = long_list(offset)
    var c = recorder()

    c.point(40, 80, true)
    list.paint(&c, Rect(0, 0, 100, 100))

    assert_eq(offset.read(), 0)

    c.point(40, 50, true)
    list.paint(&c, Rect(0, 0, 100, 100))

    assert_eq(offset.read(), 30)

    c.point(40, 40, true)
    list.paint(&c, Rect(0, 0, 100, 100))

    assert_eq(offset.read(), 40)

    // Back down follows too, and letting go ends it: a move afterwards does nothing.
    c.point(40, 70, true)
    list.paint(&c, Rect(0, 0, 100, 100))

    assert_eq(offset.read(), 10)

    c.release(40, 70)
    c.point(40, 10)
    list.paint(&c, Rect(0, 0, 100, 100))

    assert_eq(offset.read(), 10)
end a_drag_past_the_slop_scrolls_by_the_pointer_travel

// **Under the slop a press is still a tap**, so a finger that wobbled on a button presses it -- and
// the tap lands at the release, which is the only moment that is known.
@test
private a_press_that_moves_less_than_the_slop_is_a_tap()
    val offset = signal(0)
    val hit = signal(0)
    val list = scroll(column([button("go", () -> hit.set(hit.read() + 1)),
                              column(generate(20usize, i -> text("x")), 0)], 0), offset, 100)
    var c = recorder()

    c.point(10, 6, true)
    list.paint(&c, Rect(0, 0, 100, 100))
    c.point(10, 13, true)
    list.paint(&c, Rect(0, 0, 100, 100))

    assert_eq(offset.read(), 0)
    assert_eq(hit.read(), 0)

    c.release(10, 13)

    assert_eq(hit.read(), 1)
end a_press_that_moves_less_than_the_slop_is_a_tap

// And past it the press is the list's: the content moves and the button it began on is not pressed.
@test
private a_drag_that_scrolls_does_not_press_what_it_began_on()
    val offset = signal(0)
    val hit = signal(0)
    val list = scroll(column([button("go", () -> hit.set(hit.read() + 1)),
                              column(generate(20usize, i -> text("x")), 0)], 0), offset, 100)
    var c = recorder()

    // Both ends are on the button as it was first painted, so only the drag stands between this
    // release and a tap.
    c.point(10, 14, true)
    list.paint(&c, Rect(0, 0, 100, 100))
    c.point(10, 0, true)
    list.paint(&c, Rect(0, 0, 100, 100))

    assert_eq(offset.read(), 14)

    c.release(10, 0)

    assert_eq(hit.read(), 0)
end a_drag_that_scrolls_does_not_press_what_it_began_on

// A press that wanders off what it landed on and lets go elsewhere taps nothing, list or no list.
@test
private a_release_away_from_the_press_is_not_a_tap()
    val hit = signal(0)
    val b = button("go", () -> hit.set(hit.read() + 1))
    var c = recorder()

    c.point(20, 10, true)
    b.paint(&c, Rect(0, 0, 100, 28))
    c.release(300, 10)

    assert_eq(hit.read(), 0)

    c.point(20, 10, true)
    c.release(30, 12)

    assert_eq(hit.read(), 1)
end a_release_away_from_the_press_is_not_a_tap

// **A drag that begins on a slider is the slider's**: it claimed the pointer when the press landed,
// so the finger then travelling down the list moves the knob and not the content.
@test
private a_drag_that_begins_on_a_slider_moves_the_slider()
    val offset = signal(0)
    val v = signal(0)
    val list = scroll(column([slider(v, 0, 100, 80), column(generate(20usize, i -> text("x")), 0)], 0),
                      offset, 100)
    var c = recorder()

    c.point(8, 8, true)
    list.paint(&c, Rect(0, 0, 100, 100))
    c.point(72, 60, true)
    list.paint(&c, Rect(0, 0, 100, 100))

    assert(v.read() > 50, s"the knob followed the pointer along: ${v.read()}")
    assert_eq(offset.read(), 0)
end a_drag_that_begins_on_a_slider_moves_the_slider

// **The content stops at both ends**, and pushing it past one writes nothing at all.
@test
private a_drag_is_clamped_at_both_ends()
    val offset = signal(0)
    val writes = signal(0)

    offset.watch(() -> writes.set(writes.read() + 1))

    val list = long_list(offset)
    var c = recorder()

    // Down from the top, which is already as far down as the content goes.
    c.point(40, 10, true)
    list.paint(&c, Rect(0, 0, 100, 100))
    c.point(40, 90, true)
    list.paint(&c, Rect(0, 0, 100, 100))

    assert_eq(offset.read(), 0)
    assert_eq(writes.read(), 0)

    c.release(40, 90)

    // Up by far more than the content has.
    c.point(40, 90, true)
    list.paint(&c, Rect(0, 0, 100, 100))
    c.point(40, -500, true)
    list.paint(&c, Rect(0, 0, 100, 100))

    assert_eq(offset.read(), 220)
end a_drag_is_clamped_at_both_ends

// **The wheel scrolls the list under the pointer**, and a glide made of fractions of a point adds
// up rather than rounding away.
@test
private the_wheel_scrolls_the_list_under_the_pointer()
    val offset = signal(0)
    val list = long_list(offset)
    var c = recorder()

    c.point(40, 50)
    c.spin(0.0, -30.0)
    list.paint(&c, Rect(0, 0, 100, 100))

    assert_eq(offset.read(), 30)

    c.keys_done()
    c.spin(0.0, -0.6)
    list.paint(&c, Rect(0, 0, 100, 100))

    assert_eq(offset.read(), 30)

    c.keys_done()
    c.spin(0.0, -0.6)
    list.paint(&c, Rect(0, 0, 100, 100))

    assert_eq(offset.read(), 31)

    // Off the list, the wheel moves nothing -- and the turn is gone by the next frame.
    c.keys_done()
    c.point(300, 50)
    c.spin(0.0, -30.0)
    list.paint(&c, Rect(0, 0, 100, 100))
    c.keys_done()
    c.point(40, 50)
    list.paint(&c, Rect(0, 0, 100, 100))

    assert_eq(offset.read(), 31)
end the_wheel_scrolls_the_list_under_the_pointer

// **A wheel over a list at its end leaves it there**, and writes nothing.
@test
private the_wheel_does_not_move_a_list_past_its_end()
    val offset = signal(220)
    val writes = signal(0)

    offset.watch(() -> writes.set(writes.read() + 1))

    val list = long_list(offset)
    var c = recorder()

    c.point(40, 50)
    c.spin(0.0, -30.0)
    list.paint(&c, Rect(0, 0, 100, 100))

    assert_eq(offset.read(), 220)
    assert_eq(writes.read(), 0)
end the_wheel_does_not_move_a_list_past_its_end

// **Only the innermost list under the pointer takes the wheel or a drag**: the inner one asks first,
// because the outer one asks after painting it, and what it takes the outer one never sees -- even
// when the inner one is at its end and cannot use it.
@test
private only_the_innermost_list_takes_the_wheel_and_the_drag()
    val outer = signal(0)
    val inner = signal(0)
    val tree = scroll(column([scroll(column(generate(20usize, i -> text("x")), 0), inner, 50),
                              column(generate(20usize, i -> text("x")), 0)], 0), outer, 100)
    var c = recorder()

    c.point(40, 20)
    c.spin(0.0, -30.0)
    tree.paint(&c, Rect(0, 0, 100, 100))

    assert_eq(inner.read(), 30)
    assert_eq(outer.read(), 0)

    inner.set(270)
    c.keys_done()
    c.spin(0.0, -30.0)
    tree.paint(&c, Rect(0, 0, 100, 100))

    assert_eq(inner.read(), 270)
    assert_eq(outer.read(), 0)

    // Below the inner list the outer one takes it.
    c.keys_done()
    c.point(40, 80)
    c.spin(0.0, -30.0)
    tree.paint(&c, Rect(0, 0, 100, 100))

    assert_eq(outer.read(), 30)

    // And a drag begun in the inner list is the inner list's alone.
    inner.set(100)
    c.point(40, 10, true)
    tree.paint(&c, Rect(0, 0, 100, 100))
    c.point(40, 1, true)
    tree.paint(&c, Rect(0, 0, 100, 100))

    assert_eq(inner.read(), 109)
    assert_eq(outer.read(), 30)
end only_the_innermost_list_takes_the_wheel_and_the_drag

// -- the theme ------------------------------------------------------------------------------------
//
// **The change that introduced a theme moved not one recorded frame in this file**, which was the
// point of `dark()` carrying exactly the constants the controls had: what these tests check is the
// restyling, rather than a re-recording of the defaults.

// A restyle reaches a control that is two containers below it, because the theme travels on the
// canvas rather than through the tree.
@test
private a_restyle_reaches_a_control_below_it()
    val on = signal(true)
    val red = 0xC0453Fu32

    assert_paints(column([row([switch(on)], 0)], 0).restyle(t -> t with { primary = red }),
                  Size(200, 200), Rect(0, 0, 44, 24),
                  s"fill 0,0 44x24 #${red} r12\n" +
                  s"fill 23,3 18x18 #${darken(WHITE, 8)} r9\n" +
                  "hit 0,0 44x24\n")
end a_restyle_reaches_a_control_below_it

// And `.tinted` is the shorthand for the commonest one.
@test
private tinted_is_a_restyle_of_the_primary_colour()
    val on = signal(true)
    val red = 0xC0453Fu32

    var a = recorder()
    var b = recorder()

    switch(on).tinted(red).paint(&a, Rect(0, 0, 44, 24))
    switch(on).restyle(t -> t with { primary = red }).paint(&b, Rect(0, 0, 44, 24))

    assert(a.dump() == b.dump(), s"tinted:\n${a.dump()}restyle:\n${b.dump()}")
end tinted_is_a_restyle_of_the_primary_colour

// **Two restyles nest, and the inner one is handed the outer one's work.** That is why `Themed`
// holds a function rather than a theme: a wrapper storing a whole `Theme` could only replace one,
// and could not have known what the outer one had done anyway.
@test
private a_restyle_is_handed_what_the_one_above_it_left()
    val on = signal(true)

    // The outer sets the colour, the inner rounds the corners off. Neither names the other's field
    // and the switch draws under both.
    assert_paints(switch(on)
                      .restyle(t -> t with { radius = 0 })
                      .restyle(t -> t with { primary = 0x112233u32 }),
                  Size(200, 200), Rect(0, 0, 44, 24),
                  s"fill 0,0 44x24 #${0x112233u32} r12\n" +
                  s"fill 23,3 18x18 #${darken(WHITE, 8)} r9\n" +
                  "hit 0,0 44x24\n")
end a_restyle_is_handed_what_the_one_above_it_left

// And it is put back afterwards, so a sibling drawn after a restyled subtree is unaffected -- the
// same discipline `unink` and `unclip` keep.
@test
private a_restyle_ends_where_its_subtree_does()
    val on = signal(true)
    var c = recorder()

    column([switch(on).tinted(0xFF0000u32), switch(on)], 0).paint(&c, Rect(0, 0, 44, 48))

    assert(c.dump() == s"fill 0,0 44x24 #${0xFF0000u32} r12\n" +
                       s"fill 23,3 18x18 #${darken(WHITE, 8)} r9\n" +
                       "hit 0,0 44x24\n" +
                       s"fill 0,24 44x24 #${dark().primary} r12\n" +
                       s"fill 23,27 18x18 #${darken(WHITE, 8)} r9\n" +
                       "hit 0,24 44x24\n",
           s"the second switch is the theme's colour again:\n${c.dump()}")
end a_restyle_ends_where_its_subtree_does

// **`measure` pushes the theme too, and that is load-bearing**: `pad` and `radius` are in the theme,
// so a restyled button is a different *size*, and a layout pass that did not see the restyle would
// place its neighbours as though it were not one.
@test
private a_restyle_changes_what_a_button_measures_to()
    val plain = button("hi", () -> ())
    val roomy = button("hi", () -> ()).restyle(t -> t with { pad = 20 })

    assert(measured(plain, Size(300, 300)) == Size(32, 32), "two characters and eight a side")
    assert(measured(roomy, Size(300, 300)) == Size(56, 56), "and twenty a side")
end a_restyle_changes_what_a_button_measures_to

// A role names a colour the caller cannot see, which is the whole reason roles exist.
@test
private a_role_picks_its_colour_out_of_the_theme()
    val on = signal(true)
    val look = dark()

    assert_eq(look.color(Role.Primary), look.primary)
    assert_eq(look.color(Role.Error), look.error)
    assert_eq(look.color(Role.Success), look.success)

    assert_paints(switch(on, .Error), Size(200, 200), Rect(0, 0, 44, 24),
                  s"fill 0,0 44x24 #${look.error} r12\n" +
                  s"fill 23,3 18x18 #${darken(WHITE, 8)} r9\n" +
                  "hit 0,0 44x24\n")
end a_role_picks_its_colour_out_of_the_theme

// And a role follows the theme, where a hex literal at the call site would not: the same button
// under two themes is two colours, and nothing at the call site changed.
@test
private a_role_moves_when_the_theme_does()
    val on = signal(true)
    var c = recorder()

    switch(on, .Success).restyle(t -> light()).paint(&c, Rect(0, 0, 44, 24))

    assert(c.dump().contains(s"#${light().success}"),
           s"the light theme's green, not the dark theme's:\n${c.dump()}")
end a_role_moves_when_the_theme_does

// -- the button variants --------------------------------------------------------------------------

// **An outline fills nothing at all**, which is the constraint that shaped the variant: `Canvas` has
// no alpha, so a ground would have to be painted in whatever is behind, and a view does not know
// what is behind it.
@test
private an_outline_button_paints_no_ground()
    val look = dark()

    assert_paints(button("hi", () -> (), .Primary, .Outline), Size(300, 300), Rect(0, 0, 100, 28),
                  s"ink #${look.primary}\n" +
                  "text 8,8 84x12 'hi'\n" +
                  "unink\n" +
                  s"stroke 0,0 100x28 #${look.primary} w1 r6\n" +
                  "hit 0,0 100x28\n")
end an_outline_button_paints_no_ground

// A dashed one is the same with a pattern on the stroke, which is the one thing `Canvas.stroke`
// gained for it.
@test
private a_dashed_button_is_an_outline_with_a_pattern()
    val look = dark()

    assert_paints(button("hi", () -> (), .Accent, .Dashed), Size(300, 300), Rect(0, 0, 100, 28),
                  s"ink #${look.accent}\n" +
                  "text 8,8 84x12 'hi'\n" +
                  "unink\n" +
                  s"stroke 0,0 100x28 #${look.accent} w1 r6 d4\n" +
                  "hit 0,0 100x28\n")
end a_dashed_button_is_an_outline_with_a_pattern

// A soft one has a ground mixed a little way from the theme's `ground` toward the role, and no
// border at all -- which is what lets a screen carry a dozen of them.
@test
private a_soft_button_has_a_muted_ground_and_no_border()
    val look = dark()

    assert_paints(button("hi", () -> (), .Secondary, .Soft), Size(300, 300), Rect(0, 0, 100, 28),
                  s"fill 0,0 100x28 #${mix(look.ground, look.secondary, look.soft)} r6\n" +
                  s"ink #${lighten(look.secondary, 20)}\n" +
                  "text 8,8 84x12 'hi'\n" +
                  "unink\n" +
                  "hit 0,0 100x28\n")
end a_soft_button_has_a_muted_ground_and_no_border

// **The variant and the role are independent**, which is the whole claim: four shapes times six
// colours out of ten numbers, and every one of the twenty-four moves when the theme does.
@test
private a_variant_and_a_role_are_chosen_separately()
    var a = recorder()
    var b = recorder()

    button("hi", () -> (), .Error, .Outline).paint(&a, Rect(0, 0, 100, 28))
    button("hi", () -> (), .Success, .Outline).paint(&b, Rect(0, 0, 100, 28))

    assert(a.dump().contains(s"#${dark().error}"), "the same shape in one colour")
    assert(b.dump().contains(s"#${dark().success}"), "and in another")
    assert(a.dump().contains("w1 r6\n"), "neither of them dashed")
    assert(b.dump().contains("w1 r6\n"), "nor filled")
end a_variant_and_a_role_are_chosen_separately

// An outline's hover is carried by the outline and the label, since there is no ground to lift.
@test
private an_outline_button_brightens_rather_than_fills_when_hovered()
    val v = button("hi", () -> (), .Primary, .Outline)
    val look = dark()

    var away = recorder()
    var over = recorder()

    over.point(50, 14)

    v.paint(&away, Rect(0, 0, 100, 28))
    v.paint(&over, Rect(0, 0, 100, 28))

    assert(away.dump().contains(s"#${look.primary}"), "at rest it is the plain colour")
    assert(over.dump().contains(s"#${lighten(look.primary, look.hover_lift)}"), "and lit when over")
    assert(!over.dump().contains("fill "), "and it still fills nothing")
end an_outline_button_brightens_rather_than_fills_when_hovered

// A panel takes its colour and its corner from the theme, which is what makes it the restylable
// counterpart to `background(color, radius)`.
@test
private a_panel_is_the_themes_surface()
    assert_paints(text("hi").panel(), Size(200, 200), Rect(0, 0, 40, 20),
                  s"fill 0,0 40x20 #${dark().panel} r6\n" +
                  "text 0,2 40x16 'hi'\n")

    assert_paints(text("hi").panel().restyle(t -> light()), Size(200, 200), Rect(0, 0, 40, 20),
                  s"fill 0,0 40x20 #${light().panel} r6\n" +
                  "text 0,2 40x16 'hi'\n")
end a_panel_is_the_themes_surface

// **A backend that implements none of the three theme members draws in `dark()` and ignores a
// restyle**, which is the same bargain `visible` strikes and the same way round: not implementing it
// costs the feature and never the frame.
@test
private a_backend_with_no_theme_draws_in_the_default_one()
    var b = blind()

    assert(b.theme() == dark(), "the trait's own body")

    b.push_theme(light())

    assert(b.theme() == dark(), "and a push it did not implement changes nothing")
end a_backend_with_no_theme_draws_in_the_default_one

// -- the table ------------------------------------------------------------------------------------
//
// **A table adds no drawing at all**, which is the claim the file exists to make: it is a `Column`
// of `Row`s inside a `Scroll` inside a header, and every one of those already existed. What it adds
// is the one thing containers cannot do for themselves -- columns that line up.

private demo_rows() -> [][]string =
    [["a", "1"], ["bbbb", "22"], ["cc", "333"]]

// **Every cell in a column gets the same width**, which is the whole of what a table is. A `Row`
// gives each child what that child measured to, so without this the second row's edges would sit
// four characters right of the first's.
@test
private a_column_is_as_wide_as_its_widest_cell_and_every_row_agrees()
    val offset = signal(0)
    var c = recorder()

    table([col("name"), col("n", true)], demo_rows(), offset, 200).paint(&c, Rect(0, 0, 400, 232))

    // "bbbb" is four characters at eight pixels, plus the theme's padding either side: 32 + 16.
    // Every row's second column therefore starts at 48, header included.
    val d = c.dump()

    assert(d.contains("text 8,8 32x16 'name'"), s"the header's first cell:\n${d}")
    assert(d.contains("text 8,40 8x16 'a'"), s"and a short cell in the same column:\n${d}")
    assert(d.contains("text 8,72 32x16 'bbbb'"), s"and the widest one, which set the width:\n${d}")
end a_column_is_as_wide_as_its_widest_cell_and_every_row_agrees

// A fixed column takes exactly what it was given, whatever is in it.
@test
private a_fixed_column_ignores_what_is_in_it()
    val offset = signal(0)
    var c = recorder()

    table([fixed_col("name", 40), col("n")], demo_rows(), offset, 200).paint(&c, Rect(0, 0, 400, 232))

    // The second column starts at 40 rather than at 48, because the first was told its width.
    assert(c.dump().contains("text 48,40 8x16 '1'"), s"the second column at 40:\n${c.dump()}")
end a_fixed_column_ignores_what_is_in_it

// **A right-aligned column lands its text against its right edge**, which is what makes a column of
// numbers read as one -- and it is a property of the column rather than of any cell, since a cell
// deciding for itself would get it wrong for the one row whose value happened to be short.
@test
private a_right_aligned_column_pushes_its_cells_to_the_end()
    val offset = signal(0)
    var c = recorder()

    table([fixed_col("n", 100, true)], [["7"], ["999"]], offset, 200).paint(&c, Rect(0, 0, 400, 232))

    val d = c.dump()

    // One digit is eight wide and three are twenty-four; both end eight from the right edge of the
    // hundred-pixel column, so they start at different places and finish at the same one.
    assert(d.contains("text 84,40 8x16 '7'"), s"one digit:\n${d}")
    assert(d.contains("text 68,72 24x16 '999'"), s"three digits, ending in the same place:\n${d}")
end a_right_aligned_column_pushes_its_cells_to_the_end

// A flex column takes what is left over, which is what stops a table having a ragged right edge.
@test
private a_flex_column_takes_the_room_left_over()
    val offset = signal(0)
    var c = recorder()

    table([fixed_col("a", 100), flex_col("b")], [["x", "y"]], offset, 200).paint(&c, Rect(0, 0, 400, 232))

    // 400 less the fixed 100 and one gap a column: the second cell starts where the first ended.
    assert(c.dump().contains("text 108,40 8x16 'y'"), s"the flex column starts at 100:\n${c.dump()}")
end a_flex_column_takes_the_room_left_over

// **The header does not scroll**, which is the reason a table is not simply a scrolling column: it
// is painted outside the scroller, above it.
@test
private a_header_stays_where_it_is_when_the_body_scrolls()
    val offset = signal(1000)
    var c = recorder()

    table([col("name")], demo_rows(), offset, 60).paint(&c, Rect(0, 0, 400, 92))

    val d = c.dump()

    assert(d.contains("text 8,8 32x16 'name'"), s"the header is still at the top:\n${d}")
    assert(!d.contains("'bbbb'"), s"and every row has scrolled out of sight:\n${d}")
end a_header_stays_where_it_is_when_the_body_scrolls

// Striping is a `background` on alternate rows, which is what keeps the table free of drawing.
@test
private striping_gives_every_other_row_the_themes_alt_ground()
    val offset = signal(0)
    var c = recorder()

    table([col("name")], demo_rows(), offset, 200).paint(&c, Rect(0, 0, 400, 232))

    val d = c.dump()

    assert(d.contains(s"fill 0,64 400x32 #${dark().table.stripe}"), s"the second row is striped:\n${d}")
    assert(!d.contains(s"fill 0,32 400x32 #${dark().table.stripe}"), s"and the first is not:\n${d}")
end striping_gives_every_other_row_the_themes_alt_ground

// **Striping is the theme's, not the call's**, so turning it off is the same sentence as changing a
// colour and applies to every table below it.
@test
private striping_can_be_turned_off()
    val offset = signal(0)
    var c = recorder()

    table([col("name")], demo_rows(), offset, 200)
        .restyle(t -> t with { table = t.table with { striped = false } })
        .paint(&c, Rect(0, 0, 400, 232))

    assert(!c.dump().contains(s"#${dark().table.stripe}"), s"no stripe anywhere:\n${c.dump()}")
end striping_can_be_turned_off

// **A tap is answered with the row's index, not its contents**, so a handler outlives whatever the
// table was built from and an application looks the row up in its own model -- which is where the
// row actually lives.
@test
private tapping_a_row_reports_which_one()
    val offset = signal(0)
    val seen = signal(-1)
    val pick: &Fn(usize) -> unit = i -> seen.set(int(i))
    var c = recorder()

    table([col("name")], demo_rows(), offset, 200, Some(pick)).paint(&c, Rect(0, 0, 400, 232))

    // The header is 32 tall, so the second row starts 32 below the first.
    assert(c.taps.tap(50, 80), "the second row")
    assert_eq(seen.read(), 1)

    assert(c.taps.tap(50, 48), "and the first")
    assert_eq(seen.read(), 0)
end tapping_a_row_reports_which_one

// A table with no handler offers nothing to click, rather than offering a region that does nothing.
@test
private a_table_with_no_handler_registers_no_regions()
    val offset = signal(0)
    var c = recorder()

    table([col("name")], demo_rows(), offset, 200).paint(&c, Rect(0, 0, 400, 232))

    assert(c.taps.len() == 0usize, "nothing to click")
end a_table_with_no_handler_registers_no_regions

// **The table is styled entirely by the theme**, which is what "stylable" has to mean when a caller
// cannot see the theme: a restyle at any level above it moves the header, the stripes and the rule.
@test
private a_table_is_restyled_from_above()
    val offset = signal(0)
    var c = recorder()

    table([col("name")], demo_rows(), offset, 200)
        .restyle(t -> light())
        .paint(&c, Rect(0, 0, 400, 232))

    val d = c.dump()

    assert(d.contains(s"#${light().table.head}"), s"the light theme's header:\n${d}")
    assert(d.contains(s"#${light().table.stripe}"), s"and its stripe:\n${d}")
    assert(!d.contains(s"#${dark().table.stripe}"), s"and none of the dark one's:\n${d}")
end a_table_is_restyled_from_above

// And the rows below the window are culled like any other list, because the body *is* an ordinary
// column inside an ordinary scroller.
@test
private a_tables_rows_are_culled_like_any_other_list()
    val offset = signal(0)
    var rows: Buf[[]string] = buf()

    for i in 0..<200
        rows.push(["row", "x"])

    var c = recorder()

    table([col("a"), col("b")], rows.view(), offset, 64).paint(&c, Rect(0, 0, 400, 96))

    // Two rows fit in sixty-four pixels, so four cells are drawn and not four hundred.
    var drawn = 0
    val d = c.dump()

    for i in 0..<d.len
        if d[i] == u8('\'') then drawn += 1

    // Two header cells and two rows of two, each quoted twice.
    assert_eq(drawn / 2, 6)
end a_tables_rows_are_culled_like_any_other_list

// -- the flexible gap -----------------------------------------------------------------------------
//
// **`Spacer` was documented as "the flexible gap" and was nothing of the kind**: it measured to zero
// and no container ever gave it anything, so every `spacer()` in a row occupied no space at all. It
// was found by a table's right-aligned column landing its text against the left edge -- which is the
// value of building something out of the pieces rather than beside them.

// One spacer before a view pushes that view to the end.
@test
private a_spacer_pushes_what_follows_it_to_the_end()
    assert_paints(row([spacer(), text("hi")], 0), Size(200, 200), Rect(0, 0, 100, 16),
                  "text 84,0 16x16 'hi'\n")
end a_spacer_pushes_what_follows_it_to_the_end

// Two of them, one either side, centre it -- because a leftover is shared in proportion and that is
// the whole of the alignment story.
@test
private two_spacers_centre_what_is_between_them()
    assert_paints(row([spacer(), text("hi"), spacer()], 0), Size(200, 200), Rect(0, 0, 100, 16),
                  "text 42,0 16x16 'hi'\n")
end two_spacers_centre_what_is_between_them

// And a column stretches on the other axis, from the same code.
@test
private a_spacer_works_downwards_too()
    assert_paints(column([spacer(), text("hi")], 0), Size(200, 200), Rect(0, 0, 40, 100),
                  "text 0,84 40x16 'hi'\n")
end a_spacer_works_downwards_too

// **A framed spacer is not flexible**, which is what `frame` means: exactly this size, whatever else
// is going on. That is what the demo relied on while the flexible one did not work.
@test
private a_framed_spacer_takes_only_its_frame()
    assert_paints(row([spacer().frame(20, 1), text("hi")], 0), Size(200, 200), Rect(0, 0, 100, 16),
                  "text 20,0 16x16 'hi'\n")
end a_framed_spacer_takes_only_its_frame

// Nothing is stretched when there is nothing spare, and nothing overflows when there is less than
// nothing -- a row of children wider than the rectangle it was given still starts them in order.
@test
private a_row_with_nothing_to_spare_stretches_nothing()
    assert_paints(row([spacer(), text("hi")], 0), Size(200, 200), Rect(0, 0, 8, 16),
                  "text 0,0 16x16 'hi'\n")
end a_row_with_nothing_to_spare_stretches_nothing

// A view's natural size does not include the stretch, or a row containing a spacer would measure to
// the whole space offered and a column could not place it.
@test
private a_spacer_asks_for_nothing_when_measured()
    assert(measured(row([spacer(), text("hi")], 0), Size(500, 500)) == Size(16, 16),
           "sixteen pixels of text and a gap that wants nothing of its own")
end a_spacer_asks_for_nothing_when_measured

// -- `.flex(n)` -----------------------------------------------------------------------------------
//
// The request a `Spacer` makes, made by any view. The backgrounds are what shows the rectangle each
// child was painted in, since a text is drawn the same size whatever it is handed.

// Two children asking for one share and two split what is left 1:2. Two texts of sixteen in a
// hundred leave 68, which is 22 and 45 -- the last pixel is not handed out.
@test
private flex_children_split_the_leftover_by_weight()
    var c = recorder()

    column([text("a").background(0xFF0000u32).flex(1),
            text("b").background(0x00FF00u32).flex(2)], 0).paint(&c, Rect(0, 0, 40, 100))

    assert(c.dump().contains("fill 0,0 40x38 #16711680"), s"a takes one share:\n${c.dump()}")
    assert(c.dump().contains("fill 0,38 40x61 #65280"), s"b takes two:\n${c.dump()}")
end flex_children_split_the_leftover_by_weight

// And a row does the same on width: two letters of eight in a hundred leave 84, so 28 and 56.
@test
private flex_children_in_a_row_split_the_width()
    var c = recorder()

    row([text("a").background(0xFF0000u32).flex(1),
         text("b").background(0x00FF00u32).flex(2)], 0).paint(&c, Rect(0, 0, 100, 16))

    assert(c.dump().contains("fill 0,0 36x16 #16711680"), s"a takes one share:\n${c.dump()}")
    assert(c.dump().contains("fill 36,0 64x16 #65280"), s"b takes two:\n${c.dump()}")
end flex_children_in_a_row_split_the_width

// A plain view under `.flex()` is painted in the larger rectangle, and the view after it is pushed
// down to make room -- where without it the background would stop at the text.
@test
private flex_grows_the_rectangle_a_view_is_painted_in()
    var c = recorder()

    column([text("hi").background(0xFF0000u32).flex(), text("x")], 0).paint(&c, Rect(0, 0, 40, 100))

    assert(c.dump().contains("fill 0,0 40x84 #16711680"), s"everything the x leaves:\n${c.dump()}")
    assert(c.dump().contains("text 0,84 40x16 'x'"), s"and the x at the bottom:\n${c.dump()}")
end flex_grows_the_rectangle_a_view_is_painted_in

// **A `Spacer` and a `.flex()` view are one mechanism**, so they share by weight with each other:
// 84 spare between two shares is 42 each.
@test
private a_spacer_and_a_flex_view_share_alike()
    var c = recorder()

    row([spacer(), text("a").background(0xFF0000u32).flex(), text("b")], 0)
        .paint(&c, Rect(0, 0, 100, 16))

    assert(c.dump().contains("fill 42,0 50x16 #16711680"), s"the a after the gap:\n${c.dump()}")
    assert(c.dump().contains("text 92,0 8x16 'b'"), s"the b at the end:\n${c.dump()}")
end a_spacer_and_a_flex_view_share_alike

// **With nothing spare, a flexible child gets nothing extra** -- it is painted at its natural size
// and in order, exactly as an inflexible one would be.
@test
private with_nothing_spare_a_flex_child_keeps_its_natural_size()
    assert_paints(column([text("a").flex(), text("b").flex(2)], 0), Size(200, 200), Rect(0, 0, 40, 20),
                  "text 0,0 40x16 'a'\ntext 0,16 40x16 'b'\n")
end with_nothing_spare_a_flex_child_keeps_its_natural_size

// A view's flex is its own business: wrapped in anything else it has none, as a framed spacer has
// none, so `.flex()` is the last link in a chain.
@test
private flex_is_answered_by_the_outermost_wrapper()
    assert_eq(text("a").flex(3).weight(), 3)
    assert_eq(text("a").flex(3).padding(2).weight(), 0)
    assert_eq(text("a").weight(), 0)
end flex_is_answered_by_the_outermost_wrapper

// -- a scroll that fills ---------------------------------------------------------------------------
//
// Twenty rows of sixteen, so 320 of content, under a heading of sixteen in a window of a hundred.

private filling(offset: &Signal[int]) -> &View =
    column([text("head"), scroll(column(generate(20usize, i -> text("x")), 0), offset).flex()], 0)

// **A flexed scroll's window is everything the heading leaves**, 84, and it scrolls by the wheel to
// the end of a travel of 320 - 84 = 236 -- a number only that window height gives.
@test
private a_flexed_scroll_fills_and_scrolls_by_the_wheel()
    val offset = signal(0)
    val v = filling(offset)
    var c = recorder()

    c.point(40, 50)
    c.spin(0.0, -30.0)
    v.paint(&c, Rect(0, 0, 100, 100))

    assert(c.dump().contains("clip 0,16 100x84"), s"the window is what is left:\n${c.dump()}")
    assert_eq(offset.read(), 30)

    c.keys_done()
    c.spin(0.0, -1000.0)
    v.paint(&c, Rect(0, 0, 100, 100))

    assert_eq(offset.read(), 236)
end a_flexed_scroll_fills_and_scrolls_by_the_wheel

// And by a drag of the content, by exactly the pointer's travel once past the slop.
@test
private a_flexed_scroll_scrolls_by_a_drag()
    val offset = signal(0)
    val v = filling(offset)
    var c = recorder()

    c.point(40, 90, true)
    v.paint(&c, Rect(0, 0, 100, 100))
    c.point(40, 60, true)
    v.paint(&c, Rect(0, 0, 100, 100))

    assert_eq(offset.read(), 30)
end a_flexed_scroll_scrolls_by_a_drag

// **A filling scroll above a footer leaves the footer its room**, because a flexible child is asked
// its size with nothing to grow into and is handed its share afterwards.
@test
private a_flexed_scroll_leaves_room_for_what_follows_it()
    val offset = signal(0)
    var c = recorder()

    column([scroll(column(generate(20usize, i -> text("x")), 0), offset).flex(), text("foot")], 0)
        .paint(&c, Rect(0, 0, 100, 100))

    assert(c.dump().contains("clip 0,0 100x84"), s"the window stops at the footer:\n${c.dump()}")
    assert(c.dump().contains("text 0,84 100x16 'foot'"), s"and the footer is drawn:\n${c.dump()}")
end a_flexed_scroll_leaves_room_for_what_follows_it

// Two of them split the leftover by weight as any two flexible views do.
@test
private two_flexed_scrolls_split_the_room()
    val a = signal(0)
    val b = signal(0)
    var c = recorder()

    column([scroll(column(generate(20usize, i -> text("x")), 0), a).flex(),
            scroll(column(generate(20usize, i -> text("y")), 0), b).flex(2)], 0)
        .paint(&c, Rect(0, 0, 100, 90))

    assert(c.dump().contains("clip 0,0 100x30"), s"one share:\n${c.dump()}")
    assert(c.dump().contains("clip 0,30 100x60"), s"two shares:\n${c.dump()}")
end two_flexed_scrolls_split_the_room

// **A scroll with a height keeps it**, flexed or not, with room to spare or not.
@test
private a_fixed_height_scroll_keeps_its_height()
    val offset = signal(0)
    val list = column(generate(20usize, i -> text("x")), 0)
    var c = recorder()

    column([scroll(list, offset, 40), spacer()], 0).paint(&c, Rect(0, 0, 100, 100))
    assert(c.dump().contains("clip 0,0 100x40"), s"forty, beside a spacer:\n${c.dump()}")

    var d = recorder()

    column([scroll(list, offset, 40).flex()], 0).paint(&d, Rect(0, 0, 100, 100))
    assert(d.dump().contains("clip 0,0 100x40"), s"forty, flexed:\n${d.dump()}")
    assert(measured(scroll(list, offset, 40), Size(100, 500)) == Size(100, 40), "and it measures forty")
end a_fixed_height_scroll_keeps_its_height

// **With nothing spare a filling scroll gets nothing**, and a window of nothing draws nothing -- no
// thumb hanging below it over the next view.
@test
private a_flexed_scroll_with_no_room_draws_nothing()
    val offset = signal(0)

    assert_paints(column([text("a"), text("b"),
                          scroll(column(generate(20usize, i -> text("x")), 0), offset).flex()], 0),
                  Size(200, 200), Rect(0, 0, 100, 20),
                  "text 0,0 100x16 'a'\ntext 0,16 100x16 'b'\n")
end a_flexed_scroll_with_no_room_draws_nothing

// **Outside a flexing container a scroll with no height is as tall as its content, up to the room
// offered** -- a short list leaves no hole under it and a long one stops at the edge.
@test
private a_height_less_scroll_measures_to_its_content_within_the_room()
    val offset = signal(0)
    val short = scroll(column([text("a"), text("b")], 0), offset)

    assert(measured(short, Size(100, 500)) == Size(100, 32), "two rows")
    assert(measured(short, Size(100, 20)) == Size(100, 20), "clamped to the room")
    assert(measured(short, Size(100, 0)) == Size(100, 0), "and nothing for no room")
end a_height_less_scroll_measures_to_its_content_within_the_room

// **A flexed column inside a column gets its share, and hands its own leftover on** -- in one pass,
// because each container hands out only what it was given. The outer heading takes 16 of 200, the
// inner column the rest; its own heading takes 16 more, and the scroll the 168 after that.
@test
private a_flexed_scroll_in_a_flexed_column_gets_the_share_it_is_given()
    val offset = signal(0)
    var c = recorder()

    column([text("top"), filling(offset).flex()], 0).paint(&c, Rect(0, 0, 100, 200))

    assert(c.dump().contains("clip 0,32 100x168"), s"what both headings leave:\n${c.dump()}")
end a_flexed_scroll_in_a_flexed_column_gets_the_share_it_is_given

// **A table builds only the rows that can be seen**, which is the one thing it can do that a column
// of arbitrary views cannot. Culling already stops an invisible row being *painted* -- but the row
// still has to exist to be culled, and a table's body is built during paint, so at three hundred
// rows that was twelve thousand boxes made and thrown away every frame. Every row being the same
// height is what turns "which rows are visible" into arithmetic.
@test
private the_window_is_arithmetic_rather_than_a_measurement()
    // Nothing scrolled: the first row, and the window's worth plus two.
    assert_eq(window_first(0, 32, 300), 0)
    assert_eq(window_last(0, 320, 32, 300), 12)

    // Scrolled by ten rows.
    assert_eq(window_first(320, 32, 300), 10)
    assert_eq(window_last(10, 320, 32, 300), 22)

    // Part way through a row: that row is still the first, because it is still half visible.
    assert_eq(window_first(335, 32, 300), 10)

    // Neither end runs past the list, however far it is scrolled.
    assert_eq(window_first(999_999, 32, 300), 300)
    assert_eq(window_last(295, 320, 32, 300), 300)
    assert_eq(window_first(-40, 32, 300), 0)

    // A degenerate row height asks for everything rather than dividing by nothing.
    assert_eq(window_first(100, 0, 300), 0)
    assert_eq(window_last(0, 320, 0, 300), 300)
end the_window_is_arithmetic_rather_than_a_measurement

// And the rows outside the window are a gap rather than nothing, so the list keeps its full height
// -- which is what the scrollbar's thumb is a fraction of.
@test
private a_scrolled_table_keeps_its_full_height()
    val offset = signal(0)
    var rows: Buf[[]string] = buf()

    for i in 0..<100
        rows.push([s"${i}"])

    var top = recorder()
    var down = recorder()

    val v = table([col("n")], rows.view(), offset, 96)

    v.paint(&top, Rect(0, 0, 200, 128))

    offset.set(1600)
    v.paint(&down, Rect(0, 0, 200, 128))

    // A hundred rows of 32 is 3200 in a 96 window, so the thumb is at its 24-pixel minimum on a
    // 96-pixel track that starts below the 32-pixel header. Scrolled by 1600 of the 3104 it can
    // travel, it has moved 1600 * 72 / 3104 = 37 of the 72 pixels left over.
    assert(top.dump().contains("fill 192,32 8x24"), s"the thumb at the top:\n${top.dump()}")
    assert(down.dump().contains("fill 192,69 8x24"), s"and part way down:\n${down.dump()}")
end a_scrolled_table_keeps_its_full_height

// -- the grid -------------------------------------------------------------------------------------
//
// **A grid answers "where" and a row answers "what comes after what".** A form laid out as rows has
// its fields starting wherever its labels' text happened to end; on a grid two children in different
// lines line up because they were given the same fractions.

// Halves, thirds and quarters of a width that does not divide evenly by any of them.
@test
private a_grid_divides_the_width_it_was_given()
    // 24 columns, no gutter, 100 wide: the edges are 0, 50, 100 for halves.
    assert_paints(grid([text("a").cell(12), text("b").cell(12)]).restyle(t -> t with { gutter = 0 }),
                  Size(200, 200), Rect(0, 0, 100, 16),
                  "text 0,0 50x16 'a'\ntext 50,0 50x16 'b'\n")
end a_grid_divides_the_width_it_was_given

// **The rounding goes between the columns, not all at the right-hand end.** Three columns of a
// hundred pixels cannot each be 33, and a grid that computed a column width would come out eight
// pixels short of the space it was given.
@test
private a_grid_lands_its_last_edge_exactly_on_the_width()
    assert_paints(grid([text("a").cell(8), text("b").cell(8), text("c").cell(8)])
                      .restyle(t -> t with { gutter = 0 }),
                  Size(200, 200), Rect(0, 0, 100, 16),
                  "text 0,0 33x16 'a'\ntext 33,0 33x16 'b'\ntext 66,0 34x16 'c'\n")
end a_grid_lands_its_last_edge_exactly_on_the_width

// A gutter is taken out between the columns and not off the ends.
@test
private a_gutter_sits_between_the_columns_and_not_outside_them()
    assert_paints(grid([text("a").cell(12), text("b").cell(12)]).restyle(t -> t with { gutter = 10 }),
                  Size(200, 200), Rect(0, 0, 100, 16),
                  "text 0,0 45x16 'a'\ntext 55,0 45x16 'b'\n")
end a_gutter_sits_between_the_columns_and_not_outside_them

// **A line wraps when it runs out of columns**, and the next one starts below the tallest thing on
// the one before it.
@test
private a_grid_wraps_when_a_line_is_full()
    val v = grid([text("a").cell(16), text("b").cell(16), text("c").cell(16)])
                .restyle(t -> t with { gutter = 0 })

    assert_paints(v, Size(200, 200), Rect(0, 0, 90, 32),
                  "text 0,0 60x16 'a'\ntext 0,16 60x16 'b'\ntext 0,32 60x16 'c'\n")
end a_grid_wraps_when_a_line_is_full

// An offset skips columns before a child, which is how something is put in the middle of a line
// without an empty view standing in for the gap.
@test
private an_offset_skips_columns_before_a_child()
    assert_paints(grid([text("a").cell(6, 12)]).restyle(t -> t with { gutter = 0 }),
                  Size(200, 200), Rect(0, 0, 100, 16),
                  "text 50,0 25x16 'a'\n")
end an_offset_skips_columns_before_a_child

// A child with no opinion takes the whole width, which is the least surprising thing an unmarked
// child can do -- a paragraph between two lines of fields.
@test
private an_unmarked_child_takes_the_whole_width()
    assert_paints(grid([text("a")]).restyle(t -> t with { gutter = 0 }),
                  Size(200, 200), Rect(0, 0, 100, 16),
                  "text 0,0 100x16 'a'\n")
end an_unmarked_child_takes_the_whole_width

// **The divisions come off the theme**, so a subtree wanting fifths says so the same way it would
// want another colour -- and 24 cannot express a fifth, which is the whole reason 60 is offered.
@test
private a_restyle_changes_what_the_grid_divides_by()
    val fifths = grid([text("a").cell(6)])
                     .restyle(t -> t with { columns = COLUMNS_30, gutter = 0 })

    assert_paints(fifths, Size(200, 200), Rect(0, 0, 100, 16), "text 0,0 20x16 'a'\n")

    // The same span on the coarse grid is half the width rather than a fifth of it.
    assert_paints(grid([text("a").cell(12)]).restyle(t -> t with { gutter = 0 }),
                  Size(200, 200), Rect(0, 0, 100, 16), "text 0,0 50x16 'a'\n")
end a_restyle_changes_what_the_grid_divides_by

// **The two counts are complementary rather than coarse and fine**, which is the whole reason there
// are two: each gives something the other cannot, and both give the proportions everything needs.
@test
private the_two_counts_are_complementary()
    // What they share, and what everything is mostly made of.
    for c in [COLUMNS_24, COLUMNS_30]
        assert_eq(c % 2, 0)
        assert_eq(c % 3, 0)
        assert_eq(c % 6, 0)

    // Twenty-four's own: quarters and eighths.
    assert_eq(COLUMNS_24 % 4, 0)
    assert_eq(COLUMNS_24 % 8, 0)

    // Thirty's own: fifths and tenths.
    assert_eq(COLUMNS_30 % 5, 0)
    assert_eq(COLUMNS_30 % 10, 0)

    // And neither has the other's, which is why one grid would not do.
    assert(COLUMNS_24 % 5 != 0, "twenty-four has no fifth")
    assert(COLUMNS_30 % 4 != 0, "and thirty has no quarter")
end the_two_counts_are_complementary

// A grid is as tall as its lines came out, and as wide as it was offered -- the whole point being to
// divide a known width, so a grid that asked for one of its own would have nothing to divide.
@test
private a_grid_measures_to_the_width_it_was_offered()
    val v = grid([text("a").cell(12), text("b").cell(12), text("c").cell(24)])

    assert(measured(v, Size(300, 500)) == Size(300, 40), "two lines of sixteen and a gutter between")
end a_grid_measures_to_the_width_it_was_offered

// **`.cell` must be the last link in a chain**, because a wrapper outside it answers the grid's
// question for itself. This is that rule pinned rather than only written down.
@test
private a_cell_inside_a_wrapper_loses_its_span()
    // The right way round: the padding is inside the cell, and the span survives.
    assert_paints(grid([text("a").padding(2).cell(12)]).restyle(t -> t with { gutter = 0 }),
                  Size(200, 200), Rect(0, 0, 100, 20),
                  "text 2,2 46x16 'a'\n")

    // The wrong way round: the padding answers, has no opinion, and the child takes the whole width.
    assert_paints(grid([text("a").cell(12).padding(2)]).restyle(t -> t with { gutter = 0 }),
                  Size(200, 200), Rect(0, 0, 100, 20),
                  "text 2,2 96x16 'a'\n")
end a_cell_inside_a_wrapper_loses_its_span

// A grid culls what is outside the clip, like every other container.
@test
private a_grid_skips_children_outside_the_clip()
    var c = recorder()

    c.clip(Rect(0, 0, 100, 16))
    grid([text("a").cell(24), text("b").cell(24), text("c").cell(24)])
        .restyle(t -> t with { gutter = 0 })
        .paint(&c, Rect(0, 0, 100, 48))
    c.unclip()

    assert(c.dump() == "clip 0,0 100x16\ntext 0,0 100x16 'a'\nunclip\n",
           s"only the first line is reachable:\n${c.dump()}")
end a_grid_skips_children_outside_the_clip

// -- capturing the pointer ------------------------------------------------------------------------
//
// **`pressed` is inside-and-held, and a drag is neither.** A slider read through it abandoned its
// drag the moment the pointer strayed above a track sixteen pixels tall; a scrollbar thumb eight
// pixels wide was lost almost at once. Every browser captures the pointer at the press and keeps
// sending it to that element until the release.

// The grab is claimed by where the press BEGAN, and released by the release.
@test
private a_grab_is_claimed_by_where_the_press_began()
    var g = grabbing()
    val r = Rect(0, 0, 10, 10)

    assert(!g.claim(r, 0), "nothing is held while nothing is pressed")

    g.moved(5, 5, true)

    assert(g.claim(r, 0), "the press began inside")

    // Wherever the pointer goes, it is still held.
    g.moved(500, 500, true)

    assert(g.claim(r, 0), "and it is still held a long way outside")

    g.moved(500, 500, false)

    assert(!g.claim(r, 0), "until the release")
end a_grab_is_claimed_by_where_the_press_began

// A press that began outside claims nothing, however far into the rectangle it later travels --
// which is what stops a drag from being picked up by whatever it happens to pass over.
@test
private a_press_that_began_outside_never_claims()
    var g = grabbing()
    val r = Rect(0, 0, 10, 10)

    g.moved(500, 500, true)

    assert(!g.claim(r, 0), "the press began elsewhere")

    g.moved(5, 5, true)

    assert(!g.claim(r, 0), "and passing over it changes nothing")
end a_press_that_began_outside_never_claims

// **One thing owns the pointer at a time, and first claim wins** -- first meaning earliest painted,
// which is the opposite of the hit list's last-wins rule and right for the opposite reason.
@test
private only_one_thing_owns_the_pointer()
    var g = grabbing()
    val outer = Rect(0, 0, 100, 100)
    val inner = Rect(0, 0, 10, 10)

    g.moved(5, 5, true)

    assert(g.claim(outer, 0), "the outer one asked first")
    assert(!g.claim(inner, 0), "so the inner one does not get it, though the press was inside it too")
    assert(g.claim(outer, 0), "and the outer one still has it")
end only_one_thing_owns_the_pointer

// A slot tells two grabbable things sharing a rectangle apart.
@test
private a_slot_is_part_of_the_grab_key()
    var g = grabbing()
    val r = Rect(0, 0, 10, 10)

    g.moved(5, 5, true)

    assert(g.claim(r, 0), "the first slot claims it")
    assert(!g.claim(r, 1), "and the second is a different thing")
end a_slot_is_part_of_the_grab_key

// The whole point, at the slider: a drag well outside the track still moves the value.
@test
private a_slider_drag_follows_the_pointer_outside_the_track()
    val v = signal(0)
    val s = slider(v, 0, 100, 220)
    var c = recorder()

    c.point(110, 8, true)
    s.paint(&c, Rect(0, 0, 220, 16))

    assert_eq(v.read(), 50)

    // A hundred pixels above the track, which `pressed` would have called no press at all.
    c.point(212, -100, true)
    s.paint(&c, Rect(0, 0, 220, 16))

    assert_eq(v.read(), 100)

    c.point(8, 900, true)
    s.paint(&c, Rect(0, 0, 220, 16))

    assert_eq(v.read(), 0)
end a_slider_drag_follows_the_pointer_outside_the_track

// And a press that began somewhere else does not start dragging the slider it passes over.
@test
private a_pointer_dragged_over_a_slider_does_not_grab_it()
    val v = signal(30)
    var c = recorder()

    // The press began far away and is still held.
    c.point(900, 900, true)
    c.point(110, 8, true)
    slider(v, 0, 100, 220).paint(&c, Rect(0, 0, 220, 16))

    assert_eq(v.read(), 30)
end a_pointer_dragged_over_a_slider_does_not_grab_it

// **A backend that implements no grab still works** -- it asks the pointer to stay inside, which is
// what every widget did before this existed. Not implementing it costs the convenience, never the
// frame.
@test
private a_backend_with_no_grab_falls_back_to_pressed()
    var b = blind()

    assert(!b.grab(Rect(0, 0, 10, 10), 0), "a canvas with no pointer answers no to both")
end a_backend_with_no_grab_falls_back_to_pressed

// -- the table's own style ------------------------------------------------------------------------
//
// **A table has more surface than everything else here put together**, so its appearance is a
// `TableStyle` block in the theme rather than ten more fields on `Theme`. Until it existed the
// header's text was `mix(ink, panel, 35)` computed inside `table.sysl` -- a colour a theme could not
// name and therefore could not change, which is exactly what a theme is for.

// The header takes the style's own ground and ink rather than colours derived from elsewhere.
@test
private a_header_takes_the_styles_own_colours()
    val offset = signal(0)
    var c = recorder()

    table([col("name")], demo_rows(), offset, 200)
        .restyle(t -> t with { table = t.table with { head = 0x402020u32, head_ink = 0xFFCCCCu32 } })
        .paint(&c, Rect(0, 0, 400, 232))

    val d = c.dump()

    assert(d.contains(s"fill 0,0 400x32 #${0x402020u32}"), s"the header's ground:\n${d}")
    assert(d.contains(s"ink #${0xFFCCCCu32}"), s"and its text:\n${d}")
end a_header_takes_the_styles_own_colours

// **Every row's ground is painted rather than left to whatever is behind**, because `Canvas` has no
// alpha -- so a row that wanted to be "the surface underneath" would have to know what that was.
@test
private every_row_paints_its_own_ground()
    val offset = signal(0)
    var c = recorder()

    table([col("name")], demo_rows(), offset, 200)
        .restyle(t -> t with { table = t.table with { ground = 0x101010u32, stripe = 0x202020u32 } })
        .paint(&c, Rect(0, 0, 400, 232))

    val d = c.dump()

    assert(d.contains(s"fill 0,32 400x32 #${0x101010u32}"), s"the first row:\n${d}")
    assert(d.contains(s"fill 0,64 400x32 #${0x202020u32}"), s"and the striped second:\n${d}")
end every_row_paints_its_own_ground

// **The row under the pointer lights, and it eases in like everything else** -- a lit row is a
// `Reactive`, so the same `Interaction` that drives a button drives a table row and nothing new was
// needed for it.
@test
private the_row_under_the_pointer_lights()
    val offset = signal(0)
    val v = table([col("name")], demo_rows(), offset, 200)

    var away = recorder()
    var over = recorder()

    away.point(900, 900)

    // Inside the second row, which runs from 64 to 96 with a 32-pixel header above it.
    over.point(50, 80)

    v.paint(&away, Rect(0, 0, 400, 232))
    v.paint(&over, Rect(0, 0, 400, 232))

    assert(over.dump().contains(s"fill 0,64 400x32 #${dark().table.hover}"),
           s"the row under the pointer:\n${over.dump()}")
    assert(!away.dump().contains(s"#${dark().table.hover}"),
           s"and none of them when the pointer is elsewhere:\n${away.dump()}")
end the_row_under_the_pointer_lights

// And the highlight can be turned off, which is what a table nobody can click wants.
@test
private the_highlight_can_be_turned_off()
    val offset = signal(0)
    var c = recorder()

    c.point(50, 80)
    table([col("name")], demo_rows(), offset, 200)
        .restyle(t -> t with { table = t.table with { highlight = false } })
        .paint(&c, Rect(0, 0, 400, 232))

    assert(!c.dump().contains(s"#${dark().table.hover}"), s"nothing lights:\n${c.dump()}")
end the_highlight_can_be_turned_off

// **Rules between rows and striping are alternatives rather than companions**: both say "this row
// ends here", and an interface doing both says it twice. So `lined` is off by default and turning it
// on is one word.
@test
private rows_can_be_ruled_instead_of_striped()
    val offset = signal(0)
    var c = recorder()

    table([col("name")], demo_rows(), offset, 200)
        .restyle(t -> t with { table = t.table with { striped = false, lined = true } })
        .paint(&c, Rect(0, 0, 400, 232))

    val d = c.dump()

    assert(d.contains(s"stroke 0,32 400x32 #${dark().table.rule} w1"), s"a rule round a row:\n${d}")
    assert(!d.contains(s"#${dark().table.stripe}"), s"and no stripe:\n${d}")
end rows_can_be_ruled_instead_of_striped

// The cell inset decides how tall a row is, so a denser table is one number.
@test
private the_cell_inset_decides_the_row_height()
    val offset = signal(0)

    val roomy = table([col("name")], demo_rows(), offset, 200)
    val dense = table([col("name")], demo_rows(), offset, 200)
                    .restyle(t -> t with { table = t.table with { pad = 2 } })

    // A sixteen-pixel line plus the inset twice, and the header is one row tall.
    assert(measured(roomy, Size(400, 400)) == Size(400, 232), "eight a side")
    assert(measured(dense, Size(400, 400)) == Size(400, 220), "two a side")
end the_cell_inset_decides_the_row_height

// **A `TableStyle` nests inside a `Theme`, and a restyle reaches into it** -- which is what makes
// changing one field of it a sentence rather than a reconstruction of all ten.
@test
private a_restyle_reaches_one_field_of_the_table_style()
    val t = dark() with { table = dark().table with { lined = true } }

    assert(t.table.lined, "the one field asked for")
    assert(t.table.striped, "and the other nine are the ones it started with")
    assert_eq(t.table.head, dark().table.head)
    assert_eq(t.primary, dark().primary)
end a_restyle_reaches_one_field_of_the_table_style

// -- application state ----------------------------------------------------------------------------
//
// **A component here is a function returning `&View`, and it cannot own state** -- there is no
// reconciler and no element identity, so there is nowhere to hang a value between rebuilds. Every
// piece of application state is therefore already outside the tree, and these are the two things
// that makes bearable: a count of writes nobody has to subscribe to, and values computed from other
// values.

// **A write moves the clock whether or not anything was watching**, which is what makes `writes()` a
// complete account of whether state has changed. A signal nothing subscribed to is still state.
@test
private every_write_moves_the_clock()
    val a = signal(0)
    val b = signal("x")
    val before = writes()

    a.set(1)

    assert(writes() > before, "a write nobody subscribed to still counts")

    val between = writes()

    b.set("y")

    assert(writes() > between, "and so does a write to something else entirely")
end every_write_moves_the_clock

// Reading changes nothing, or a frame loop comparing the clock would rebuild for ever.
@test
private reading_does_not_move_the_clock()
    val a = signal(7)
    val before = writes()

    assert_eq(a.read(), 7)
    assert_eq(a.read(), 7)
    assert_eq(writes(), before)
end reading_does_not_move_the_clock

// **This is what replaces a `watch` per signal.** A frame loop keeps the number it last saw and
// rebuilds when it differs -- which cannot be forgotten, however many pieces of state there are.
@test
private a_frame_loop_can_tell_that_anything_changed()
    val a = signal(0)
    val b = signal(0)

    var seen = writes()
    var rebuilds = 0

    // Three frames, one write between the first and the second.
    for i in 0..<3
        if i == 1 then a.set(9)

        if writes() != seen
            rebuilds += 1
            seen = writes()

    assert_eq(rebuilds, 1)

    // A write to a different signal is seen by the same comparison, with nothing added anywhere.
    b.set(1)

    assert(writes() != seen, "and the second signal needed no line of its own")
end a_frame_loop_can_tell_that_anything_changed

// **A plain signal built from another is computed once and then frozen**, which is the trap a
// module-level `val` makes easy to fall into and the whole reason `derived` exists.
@test
private a_signal_built_from_another_is_frozen()
    val count = signal(1)
    val stale = signal(count.read() * 2)

    count.set(50)

    assert_eq(stale.read(), 2, "it holds the answer, not the question")
end a_signal_built_from_another_is_frozen

// A derivation holds the computation instead, so it is right whenever it is asked.
@test
private a_derivation_stays_right()
    val count = signal(1)
    val doubled = derived(() -> count.read() * 2)

    assert_eq(doubled.read(), 2)

    count.set(50)

    assert_eq(doubled.read(), 100)

    count.set(0)

    assert_eq(doubled.read(), 0)
end a_derivation_stays_right

// It recomputes only when something has been written, not on every read.
//
// **The counter cannot itself be a signal**, which is worth knowing: writing one inside a derivation
// moves the clock the derivation is deciding freshness by, so it would be stale the instant it
// finished and would recompute on every read for ever.
// **Reached through a reference, or a closure capturing it would count in a copy** -- which is what
// made a tab test read zero while the thing it was counting had run.
struct Ticks
    n: int

    take(*self) -> int
        self.n += 1
        self.n
    end take
end Ticks

private ticks() -> &Ticks = Ticks(0)

@test
private a_derivation_caches_between_writes()
    val marker = signal(0)
    val runs = ticks()
    val counted = derived(() -> runs.take())

    // One evaluation at construction, one on the first read.
    assert_eq(counted.read(), 2)
    assert_eq(counted.read(), 2)
    assert_eq(counted.read(), 2, "three reads and it worked it out once")

    marker.set(1)

    assert_eq(counted.read(), 3, "and once more, after something was written")
    assert_eq(counted.read(), 3)
end a_derivation_caches_between_writes

// **A derivation of a derivation works, and a diamond recomputes once**, because nothing is pushed:
// a value is worked out when it is asked for, from whatever the atoms hold at that moment, so there
// is no intermediate state for anything to observe.
@test
private a_diamond_settles_in_one_read()
    val base = signal(2)
    val left = derived(() -> base.read() + 1)
    val right = derived(() -> base.read() * 10)
    val both = derived(() -> left.read() + right.read())

    assert_eq(both.read(), 23)

    base.set(5)

    assert_eq(both.read(), 56)
end a_diamond_settles_in_one_read

// A derivation over several atoms follows all of them.
@test
private a_derivation_may_read_more_than_one_atom()
    val first = signal("Ada")
    val last = signal("Lovelace")
    val whole = derived(() -> first.read() + " " + last.read())

    assert(whole.read() == "Ada Lovelace", whole.read())

    last.set("Byron")

    assert(whole.read() == "Ada Byron", whole.read())
end a_derivation_may_read_more_than_one_atom

// And it may be anything, not only a number: this is what a screen actually asks a derivation for.
@test
private a_derivation_may_produce_a_view()
    val loud = signal(false)
    val label = derived(() -> if loud.read() then "LOUD" else "quiet")

    assert(label.read() == "quiet", label.read())

    loud.set(true)

    assert(label.read() == "LOUD", label.read())
end a_derivation_may_produce_a_view

// -- overlays -------------------------------------------------------------------------------------
//
// **Everything else in the toolkit composes downward** -- a view is given a rectangle and must not
// draw outside it, and culling skips what a clip cannot reach. That is exactly wrong for a dropdown,
// which is anchored to something small and has to spill out over what comes after it. An overlay is
// raised rather than painted, and the frame paints it after the tree.

// A closed popover raises nothing at all, and reserves nothing either.
@test
private a_closed_popover_is_not_there()
    val open = signal(false)
    val v = text("menu").popover(open, text("one"))

    assert_paints(v, Size(200, 200), Rect(0, 0, 40, 16), "text 0,0 40x16 'menu'\n")
    assert(measured(v, Size(200, 200)) == Size(32, 16), "and it measures to the anchor alone")
end a_closed_popover_is_not_there

// **An open one is raised, not painted in place** -- and still measures to the anchor, or a closed
// menu would reserve room for itself.
@test
private an_open_popover_is_raised_below_its_anchor()
    val open = signal(true)
    val v = text("menu").popover(open, text("one"))
    var c = recorder()

    v.paint(&c, Rect(10, 20, 40, 16))

    assert(c.dump() == "text 10,20 40x16 'menu'\n" + "raise -1000000,-1000000 2000000x2000000\n" + "raise 10,40 24x16\n",
           s"the catcher, then the content four below the anchor:\n${c.dump()}")
    assert(measured(v, Size(200, 200)) == Size(32, 16), "and it still measures to the anchor")
end an_open_popover_is_raised_below_its_anchor

// It may open upward instead, which is what a menu near the bottom of a window wants.
@test
private a_popover_may_open_upward()
    val open = signal(true)
    var c = recorder()

    text("menu").popover(open, text("one"), false).paint(&c, Rect(10, 100, 40, 16))

    assert(c.dump().contains("raise 10,80 24x16"), s"above the anchor:\n${c.dump()}")
end a_popover_may_open_upward

// **`render` is what paints them**, after the tree -- which is why an application should use it
// rather than calling `measure` and `paint` itself and silently never drawing a dialog.
@test
private render_paints_the_tree_and_then_what_it_raised()
    val open = signal(true)
    var c = recorder()

    render(text("menu").popover(open, text("one")), &c, Rect(0, 0, 40, 16))

    assert(c.dump() == "text 0,0 40x16 'menu'\n" + "raise -1000000,-1000000 2000000x2000000\n" + "raise 0,20 24x16\n" +
                       "hit -1000000,-1000000 2000000x2000000\ntext 0,20 24x16 'one'\n",
           s"the overlay is painted last, outside the anchor:\n${c.dump()}")
end render_paints_the_tree_and_then_what_it_raised

// **An overlay escapes the clip in force where it was raised**, which is the whole reason it exists:
// a menu on a row of a scrolling list must not be cut off at the list's edge.
@test
private an_overlay_escapes_the_clip_it_was_raised_under()
    val open = signal(true)
    val offset = signal(0)
    var c = recorder()

    render(scroll(text("menu").popover(open, text("one")), offset, 16), &c, Rect(0, 0, 40, 16))

    // The raise happens inside the clip and the paint happens after `unclip`, at y = 20, which is
    // outside the sixteen-pixel window entirely.
    assert(c.dump().contains("unclip\nhit -1000000,-1000000 2000000x2000000\n" +
                             "text 0,20 24x16 'one'"),
           s"painted after the clip was unwound:\n${c.dump()}")
end an_overlay_escapes_the_clip_it_was_raised_under

// And it is on top for input, because the hit list is last-wins and an overlay is recorded last.
@test
private an_overlay_takes_the_tap_from_what_is_under_it()
    val open = signal(true)
    val hit = signal("nothing")
    val under: &Fn() -> unit = () -> hit.set("under")
    val over: &Fn() -> unit = () -> hit.set("over")
    var c = recorder()

    // The anchor and the overlay are given the same rectangle, so a tap could be either.
    render(text("menu").on_tap(under).popover(open, text("one").on_tap(over), true, -16),
           &c, Rect(0, 0, 40, 16))

    assert(c.taps.tap(10, 8), "something answered")
    assert(hit.read() == "over", s"and it was the overlay: ${hit.read()}")
end an_overlay_takes_the_tap_from_what_is_under_it

// A modal covers what it wraps, centres its content, and swallows a tap on everything else.
@test
private a_modal_centres_its_content_and_catches_what_misses_it()
    val open = signal(true)
    val behind = signal(0)
    val tapped: &Fn() -> unit = () -> behind.set(behind.read() + 1)
    var c = recorder()

    render(text("page").on_tap(tapped).modal(open, text("hi")), &c, Rect(0, 0, 100, 100))

    // Sixteen wide and sixteen tall, centred in a hundred square.
    assert(c.dump().contains("text 42,42 16x16 'hi'"), s"centred:\n${c.dump()}")

    assert(c.taps.tap(5, 5), "a tap outside the content is answered")
    assert_eq(behind.read(), 0, "by the catcher, not by the page underneath")
end a_modal_centres_its_content_and_catches_what_misses_it

// **A dismissible modal closes when the tap misses**, which is the whole of what the catcher is for
// beyond blocking. `None` is a modal that has to be answered.
@test
private a_dismissible_modal_closes_on_a_tap_outside_it()
    val open = signal(true)
    val shut: &Fn() -> unit = () -> open.set(false)
    var c = recorder()

    render(text("page").modal(open, text("hi"), Some(shut)), &c, Rect(0, 0, 100, 100))

    assert(c.taps.tap(5, 5), "the catcher answered")
    assert(!open.read(), "and it closed")
end a_dismissible_modal_closes_on_a_tap_outside_it

// An overlay may raise an overlay -- a menu inside a dialog -- and `render` drains until nothing new
// is raised.
@test
private an_overlay_may_raise_another()
    val dialog = signal(true)
    val menu = signal(true)
    var c = recorder()

    render(text("page").modal(dialog, text("in").popover(menu, text("deep"))),
           &c, Rect(0, 0, 100, 100))

    assert(c.dump().contains("'deep'"), s"the second round was painted too:\n${c.dump()}")
end an_overlay_may_raise_another

// Taking them clears them, so a second frame does not paint the first frame's overlays again.
@test
private overlays_are_taken_once()
    val open = signal(true)
    var c = recorder()

    text("menu").popover(open, text("one")).paint(&c, Rect(0, 0, 40, 16))

    // Two: the catcher that closes it and the content itself.
    assert(c.take_overlays().view().len == 2usize, "the catcher and the content")
    assert(c.take_overlays().view().len == 0usize, "and taking it emptied the store")
end overlays_are_taken_once

// -- tabs -----------------------------------------------------------------------------------------
//
// **There is no `Tabs` view**, and that is what these check: a tab bar is a `Row` of `Reactive`
// headers, each a `Column` of a label over a restyled `divider`, above a rule and the chosen panel.
// If tabs had needed a new `View` or a new `Canvas` operation it would have meant something below
// was missing.

private panels(i: int) -> &View = text(s"panel ${i}")

// Only the chosen panel is built, which is why the body is a function of the index rather than a
// list: a list would build every panel on every rebuild to show one.
@test
private only_the_chosen_panel_is_built()
    val chosen = signal(0)
    val built = ticks()
    val v = tabs(["a", "b", "c"], chosen, i -> text(s"panel ${built.take()}"))
    var c = recorder()

    v.paint(&c, Rect(0, 0, 200, 100))

    assert_eq(built.n, 1, "three tabs and one panel built")
end only_the_chosen_panel_is_built

// The chosen header carries the accent under it and the others carry the panel colour, so every
// header is the same shape and only its colour says which is which.
@test
private the_chosen_header_wears_the_accent()
    val chosen = signal(1)
    var c = recorder()

    tabs(["a", "b"], chosen, panels).paint(&c, Rect(0, 0, 200, 100))

    val d = c.dump()
    val look = dark()

    assert(d.contains(s"#${look.primary}"), s"the chosen one's indicator:\n${d}")
    assert(d.contains(s"#${look.panel}"), s"and the other's, which is the same shape:\n${d}")
end the_chosen_header_wears_the_accent

// Tapping a header chooses it, and the panel that comes back is the new one.
@test
private tapping_a_header_chooses_it()
    val chosen = signal(0)
    val v = tabs(["one", "two"], chosen, panels)
    var c = recorder()

    v.paint(&c, Rect(0, 0, 200, 100))

    assert(c.dump().contains("'panel 0'"), s"the first panel:\n${c.dump()}")

    // "one" is three characters plus the theme's padding either side: 24 + 16 = 40 wide, so "two"
    // starts at 40.
    assert(c.taps.tap(50, 10), "the second header")
    assert_eq(chosen.read(), 1)

    // **Rebuilt rather than repainted**, which is what an application does when anything is written:
    // the whole widget is a snapshot of the state it was built from, so the bar and the panel can
    // never disagree.
    var after = recorder()

    tabs(["one", "two"], chosen, panels).paint(&after, Rect(0, 0, 200, 100))

    assert(after.dump().contains("'panel 1'"), s"and now the second panel:\n${after.dump()}")
end tapping_a_header_chooses_it

// **A header does not change height when it is chosen**, or the bar would shift as tabs were
// clicked -- which is why the indicator is always there and only its colour changes.
@test
private choosing_a_tab_moves_nothing()
    val chosen = signal(0)
    val v = tabs(["one", "two"], chosen, panels)

    val before = measured(v, Size(200, 200))

    chosen.set(1)

    assert(measured(v, Size(200, 200)) == before, "the same size whichever is chosen")
end choosing_a_tab_moves_nothing

// An index outside the list shows the first panel rather than reading past the end.
@test
private an_index_outside_the_list_falls_back()
    val chosen = signal(9)
    var c = recorder()

    tabs(["a", "b"], chosen, panels).paint(&c, Rect(0, 0, 200, 100))

    assert(c.dump().contains("'panel 0'"), s"the first, not a crash:\n${c.dump()}")
end an_index_outside_the_list_falls_back

// The headers sit at the left rather than spreading, because the row ends with a flexible gap.
@test
private the_headers_sit_at_the_left()
    val chosen = signal(0)
    var c = recorder()

    tabs(["a", "b"], chosen, panels).paint(&c, Rect(0, 0, 400, 100))

    // Each label is one character at eight pixels plus eight of padding a side: 24 wide.
    assert(c.dump().contains("text 8,8 8x16 'a'"), s"the first at the left edge:\n${c.dump()}")
    assert(c.dump().contains("text 32,8 8x16 'b'"), s"and the second right after it:\n${c.dump()}")
end the_headers_sit_at_the_left

// **An overlay paints in the theme it was raised under, not the one the root was drawn in.** It is
// painted after the tree has finished, by which time every `push_theme` the tree made has been
// popped -- so without capturing it, a menu raised inside a restyled section comes back wearing the
// theme of the root, which is the one place it obviously does not belong.
//
// Found by putting a modal at the root of the demo under a `.restyle`, where every colour in it came
// out dark on a light interface. Nothing would have thought to check it.
@test
private an_overlay_keeps_the_theme_it_was_raised_under()
    val open = signal(true)
    var c = recorder()

    render(text("anchor").popover(open, text("menu").panel()).restyle(t -> light()),
           &c, Rect(0, 0, 60, 16))

    assert(c.dump().contains(s"fill 0,20 32x16 #${light().panel}"),
           s"the light theme's panel, raised under it:\n${c.dump()}")
    assert(!c.dump().contains(s"#${dark().panel}"), s"and none of the root's:\n${c.dump()}")
end an_overlay_keeps_the_theme_it_was_raised_under

// And the capture is per-overlay, so two raised under different themes each keep their own.
@test
private two_overlays_keep_their_own_themes()
    val a = signal(true)
    val b = signal(true)
    var c = recorder()

    render(column([
               text("one").popover(a, text("x").panel()),
               text("two").popover(b, text("y").panel()).restyle(t -> light())
           ], 0),
           &c, Rect(0, 0, 60, 32))

    val d = c.dump()

    assert(d.contains(s"#${dark().panel}"), s"the first kept the root's:\n${d}")
    assert(d.contains(s"#${light().panel}"), s"and the second kept its own:\n${d}")
end two_overlays_keep_their_own_themes

// -- spacing --------------------------------------------------------------------------------------

// **Named arguments are what makes per-side padding readable**, which is why it is four defaulted
// parameters rather than an `Insets` struct: `.pad(bottom = 12)` says what it does.
@test
private padding_may_be_given_on_one_side_only()
    assert_paints(text("hi").pad(bottom = 12), Size(200, 200), Rect(0, 0, 16, 28),
                  "text 0,0 16x16 'hi'\n")

    assert(measured(text("hi").pad(bottom = 12), Size(200, 200)) == Size(16, 28),
           "twelve taller and no wider")
end padding_may_be_given_on_one_side_only

@test
private padding_may_be_given_on_each_side_separately()
    assert_paints(text("hi").pad(top = 1, right = 2, bottom = 3, left = 4),
                  Size(200, 200), Rect(0, 0, 22, 20),
                  "text 4,1 16x16 'hi'\n")

    assert(measured(text("hi").pad(top = 1, right = 2, bottom = 3, left = 4), Size(200, 200))
               == Size(22, 20),
           "six wider and four taller")
end padding_may_be_given_on_each_side_separately

// The uniform one is the same wrapper with the same number four times, so nothing about it moved.
@test
private uniform_padding_is_the_same_on_every_side()
    var a = recorder()
    var b = recorder()

    text("hi").padding(8).paint(&a, Rect(0, 0, 32, 32))
    text("hi").pad(8, 8, 8, 8).paint(&b, Rect(0, 0, 32, 32))

    assert(a.dump() == b.dump(), s"one:\n${a.dump()}four:\n${b.dump()}")
end uniform_padding_is_the_same_on_every_side

// **`padded` takes its inset from the theme**, which is the same argument as `panel` against
// `background`: a number cannot be restyled, and "however much room this interface gives things"
// moves with the theme.
@test
private padded_takes_its_inset_from_the_theme()
    assert_paints(text("hi").padded(), Size(200, 200), Rect(0, 0, 32, 32),
                  "text 8,8 16x16 'hi'\n")

    assert_paints(text("hi").padded().restyle(t -> t with { pad = 2 }),
                  Size(200, 200), Rect(0, 0, 20, 20),
                  "text 2,2 16x16 'hi'\n")

    assert(measured(text("hi").padded().restyle(t -> t with { pad = 20 }), Size(200, 200))
               == Size(56, 56),
           "and measure sees the restyle too, or a padded view would be placed wrong")
end padded_takes_its_inset_from_the_theme

// **There is no `margin`, and there does not need to be one**: the difference between a padding and
// a margin is only which side of the background it falls on, and the chain decides that.
@test
private a_margin_is_padding_outside_the_background()
    // Padding: the ground covers the inset.
    assert_paints(text("hi").padding(8).background(0xFF0000u32),
                  Size(200, 200), Rect(0, 0, 32, 32),
                  "fill 0,0 32x32 #16711680\ntext 8,8 16x16 'hi'\n")

    // Margin: the ground stops at the text, and the inset is outside it.
    assert_paints(text("hi").background(0xFF0000u32).padding(8),
                  Size(200, 200), Rect(0, 0, 32, 32),
                  "fill 8,8 16x16 #16711680\ntext 8,8 16x16 'hi'\n")
end a_margin_is_padding_outside_the_background

// The panel below a tab bar does not sit hard against the rule, which is the one place a tab bar
// always looks wrong.
@test
private a_tab_panel_is_not_flush_against_the_rule()
    val chosen = signal(0)
    var c = recorder()

    tabs(["a"], chosen, panels).paint(&c, Rect(0, 0, 200, 100))

    // The bar is 16 of text and 8 of padding a side, then a 2-pixel indicator, then the 1-pixel
    // rule: the panel starts a theme's padding below that rather than on it.
    assert(c.dump().contains("text 8,43 184x16 'panel 0'"),
           s"eight below the rule, not on it:\n${c.dump()}")
end a_tab_panel_is_not_flush_against_the_rule

// **The demo's exact shape, which is what actually went wrong.** `.modal` sits outside
// `.foreground`, so by the time the modal raised its content the `Foreground` had already put the
// ink back -- the capture was working and was faithfully capturing a moment at which nothing was
// set. Twice I fixed the capture and twice the dialog stayed invisible.
//
// **The fix is not an ordering rule for callers to remember.** It is that text with nothing pushed
// over it takes the THEME's ink, so a dialog is readable without anybody having said so -- and a
// backend that carried its own default text colour was carrying one no theme could reach.
@test
private text_takes_the_themes_ink_when_nothing_says_otherwise()
    var c = recorder()

    assert_eq(c.text_ink(), dark().ink)

    c.push_theme(light())

    assert_eq(c.text_ink(), light().ink, "it follows the theme, with nothing pushed over it")

    c.pop_theme()

    assert_eq(c.text_ink(), dark().ink)
end text_takes_the_themes_ink_when_nothing_says_otherwise

// An explicit `foreground` still wins, and still puts back what it found rather than a default.
@test
private an_explicit_foreground_overrides_the_theme()
    var c = recorder()

    c.ink(0xFF0000u32)

    assert_eq(c.text_ink(), 0xFF0000u32)

    c.ink(0x00FF00u32)

    assert_eq(c.text_ink(), 0x00FF00u32, "and they nest")

    c.unink()

    assert_eq(c.text_ink(), 0xFF0000u32, "the outer one is still standing")

    c.unink()

    assert_eq(c.text_ink(), dark().ink, "and then it is the theme's again, not a backend's")
end an_explicit_foreground_overrides_the_theme

// **A backend that pushes nothing and remembers nothing still draws in the theme's ink**, which is
// the default body doing the whole of the work.
@test
private a_backend_that_tracks_no_ink_still_follows_the_theme()
    var b = blind()

    assert_eq(b.text_ink(), dark().ink)
end a_backend_that_tracks_no_ink_still_follows_the_theme

// And the dialog case end to end: a modal outside a foreground, under a restyle, with the content
// painted in the restyled theme's ink rather than anything the root or the backend had.
@test
private a_dialog_is_readable_with_no_foreground_anywhere()
    val open = signal(true)
    var c = recorder()

    render(text("page").foreground(0x111111u32).modal(open, text("Reset?")).restyle(_ -> light()),
           &c, Rect(0, 0, 100, 100))

    val d = c.dump()

    // The page's own foreground was pushed and popped inside the tree, and nothing of it is left
    // standing over the dialog -- there is no `ink` around the raised content at all.
    assert(d.contains("text 26,42 48x16 'Reset?'"), s"the dialog's text is painted:\n${d}")
    assert(!d.contains("ink #1118481\ntext 26,42"), s"and not under the page's ink:\n${d}")

    // What colour that text actually comes out is `text_ink` at the moment it is painted, and the
    // two halves of that are pinned above: an overlay keeps the theme it was raised under, and text
    // with nothing pushed over it takes that theme's ink.
end a_dialog_is_readable_with_no_foreground_anywhere

// -- selecting text -------------------------------------------------------------------------------
//
// **The toolkit selects and the application copies.** A selection is geometry and state, which is
// what a view knows; the clipboard is the window system's, which a view should not reach.

// **A hit test is measuring prefixes**, which is why no backend has to implement it: a canvas that
// can measure a run can measure the front of one. The recorder's font is eight pixels a byte.
@test
private a_click_lands_on_the_character_it_points_at()
    var c = recorder()

    assert_eq(c.text_at("hello", 0), 0usize)
    assert_eq(c.text_at("hello", -40), 0usize, "before the run is the start of it")

    // Past the middle of a character snaps past it, so a click lands where a person points rather
    // than always before the letter they aimed at.
    assert_eq(c.text_at("hello", 3), 0usize, "still in the first half of 'h'")
    assert_eq(c.text_at("hello", 5), 1usize, "past its middle")
    assert_eq(c.text_at("hello", 8), 1usize, "on the boundary")

    assert_eq(c.text_at("hello", 400), 5usize, "past the end is the end")
end a_click_lands_on_the_character_it_points_at

// **And it never lands inside a multi-byte character**, because it walks characters and builds the
// prefix as it goes rather than dividing a width by a byte count.
@test
private an_offset_is_always_on_a_character_boundary()
    var c = recorder()

    // "héllo" is six bytes and five characters; the recorder charges eight pixels a *byte*, so 'é'
    // is sixteen wide to it -- which is wrong for a font and exactly right for this test, because a
    // hit test that divided by bytes would answer 2 and land inside it.
    assert_eq("héllo".len, 6usize)
    assert_eq(c.text_at("héllo", 9), 1usize, "the front half of the two-byte character")
    assert_eq(c.text_at("héllo", 20), 3usize, "and past it -- 3, never 2")
end an_offset_is_always_on_a_character_boundary

// The other direction, which is what draws the highlight.
@test
private a_boundary_has_a_position()
    var c = recorder()

    assert_eq(c.text_x("hello", 0usize), 0)
    assert_eq(c.text_x("hello", 2usize), 16)
    assert_eq(c.text_x("hello", 5usize), 40)
    assert_eq(c.text_x("hello", 99usize), 40, "past the end is the end")
end a_boundary_has_a_position

// A selection keeps its direction, so a drag leftward has its head below its anchor -- which is what
// a shift-click would extend from. `lo` and `hi` are what everything else asks for.
@test
private a_selection_keeps_which_way_it_was_dragged()
    val back = Selection(5usize, 2usize)

    assert_eq(back.lo(), 2usize)
    assert_eq(back.hi(), 5usize)
    assert(!back.empty(), "and it is not empty")
    assert(Selection(3usize, 3usize).empty(), "one that never moved is")
end a_selection_keeps_which_way_it_was_dragged

// **The substring is bounded against the run rather than trusted**, because a selection outlives the
// text it was made in: a rebuild can shorten what is under a selection nobody cleared.
@test
private selected_text_is_bounded_against_the_run()
    assert(selected_text("hello", Selection(1usize, 4usize)) == "ell",
           selected_text("hello", Selection(1usize, 4usize)))
    assert(selected_text("hello", Selection(4usize, 1usize)) == "ell", "either direction")
    assert(selected_text("hello", Selection(2usize, 2usize)) == "", "an empty selection is nothing")
    assert(selected_text("hi", Selection(0usize, 99usize)) == "hi", "past the end is clamped")
    assert(selected_text("", Selection(3usize, 9usize)) == "", "and an empty run is safe")
end selected_text_is_bounded_against_the_run

// Nothing selected draws no highlight, only the run.
@test
private an_unselected_run_is_just_text()
    val sel = signal(nothing_selected())

    assert_paints(selectable("hello", sel), Size(200, 200), Rect(0, 0, 40, 16),
                  "text 0,0 40x16 'hello'\n")
end an_unselected_run_is_just_text

// **The highlight goes behind the run**, because `Canvas` has no alpha and a colour over the letters
// would hide them.
@test
private a_selection_is_painted_behind_the_text()
    val sel = signal(Selection(1usize, 3usize))

    assert_paints(selectable("hello", sel), Size(200, 200), Rect(0, 0, 40, 16),
                  s"fill 8,0 16x16 #${dark().selection}\n" +
                  "text 0,0 40x16 'hello'\n")
end a_selection_is_painted_behind_the_text

// **Both ends come from where the press began and where the pointer is now**, recomputed every
// frame -- so the view stores no anchor, there is no first frame to notice, and a drag cannot be
// left half-set.
@test
private dragging_selects_from_the_press_to_the_pointer()
    val sel = signal(nothing_selected())
    val v = selectable("hello", sel)
    var c = recorder()

    // Press inside 'e' and drag into the first 'l'. The values are deliberately away from a
    // character's midpoint, which is the one place either answer is defensible.
    c.point(10, 8, true)
    v.paint(&c, Rect(0, 0, 40, 16))

    assert_eq(sel.read().lo(), 1usize)
    assert_eq(sel.read().hi(), 1usize, "the drag has not moved yet")

    c.point(22, 8, true)
    v.paint(&c, Rect(0, 0, 40, 16))

    assert(selected_text("hello", sel.read()) == "el", selected_text("hello", sel.read()))

    // Dragging back past the start keeps the anchor and moves the head the other way.
    c.point(2, 8, true)
    v.paint(&c, Rect(0, 0, 40, 16))

    assert(selected_text("hello", sel.read()) == "h", selected_text("hello", sel.read()))
end dragging_selects_from_the_press_to_the_pointer

// And the drag follows the pointer off the run entirely, because it is the same capture a slider
// uses -- a person selecting a line does not keep the pointer inside it.
@test
private a_selection_drag_follows_the_pointer_off_the_run()
    val sel = signal(nothing_selected())
    val v = selectable("hello", sel)
    var c = recorder()

    c.point(0, 8, true)
    v.paint(&c, Rect(0, 0, 40, 16))

    c.point(900, 900, true)
    v.paint(&c, Rect(0, 0, 40, 16))

    assert(selected_text("hello", sel.read()) == "hello", "the whole run")
end a_selection_drag_follows_the_pointer_off_the_run

// A press that began somewhere else does not start selecting a run it is dragged across.
@test
private dragging_over_a_run_does_not_select_it()
    val sel = signal(nothing_selected())
    var c = recorder()

    c.point(900, 900, true)
    c.point(20, 8, true)
    selectable("hello", sel).paint(&c, Rect(0, 0, 40, 16))

    assert(sel.read().empty(), "nothing was selected")
end dragging_over_a_run_does_not_select_it

// **A tap anywhere else closes a popover**, which is what a menu does everywhere and what this did
// not do until somebody clicked beside one.
@test
private a_tap_outside_a_popover_closes_it()
    val open = signal(true)
    var c = recorder()

    render(text("menu").popover(open, text("one")), &c, Rect(0, 0, 40, 16))

    assert(c.taps.tap(900, 900), "a tap far outside is answered")
    assert(!open.read(), "and it closed")
end a_tap_outside_a_popover_closes_it

// A tap *inside* it reaches the content, because the catcher is raised first and the hit list is
// last-wins.
@test
private a_tap_inside_a_popover_reaches_its_content()
    val open = signal(true)
    val chose = signal(false)
    val pick: &Fn() -> unit = () -> chose.set(true)
    var c = recorder()

    render(text("menu").popover(open, text("one").on_tap(pick)), &c, Rect(0, 0, 40, 16))

    assert(c.taps.tap(4, 24), "inside the raised content")
    assert(chose.read(), "the item ran")
    assert(open.read(), "and the menu did not close from under it")
end a_tap_inside_a_popover_reaches_its_content

// **Clicking the button that opened it closes it rather than toggling twice.** The catcher is raised
// after the anchor was painted, so it is later in the hit list and wins.
@test
private clicking_the_trigger_again_closes_the_menu()
    val open = signal(true)
    val toggles = signal(0)
    val flip: &Fn() -> unit = () -> toggles.set(toggles.read() + 1)
    var c = recorder()

    render(text("menu").on_tap(flip).popover(open, text("one")), &c, Rect(0, 0, 40, 16))

    assert(c.taps.tap(10, 8), "on the trigger")
    assert(!open.read(), "it closed")
    assert_eq(toggles.read(), 0, "and the trigger's own handler did not also run")
end clicking_the_trigger_again_closes_the_menu

// A closed one catches nothing at all, or every click in the window would be swallowed.
@test
private a_closed_popover_catches_nothing()
    val open = signal(false)
    val hit = signal(false)
    val f: &Fn() -> unit = () -> hit.set(true)
    var c = recorder()

    render(text("menu").on_tap(f).popover(open, text("one")), &c, Rect(0, 0, 40, 16))

    assert(c.taps.tap(10, 8), "the trigger is still tappable")
    assert(hit.read(), "and its own handler runs")
end a_closed_popover_catches_nothing

// **A named struct value is a module-level `val`, not a `const`.** `const` in sysl is compile-time
// folding -- a constant is substituted into its uses as a literal, and there is no literal for a
// struct -- so `const AT_REST: Interaction = ...` is refused, and that refusal is the language being
// coherent rather than a gap. What a named struct value wants is storage, which is what a `val` is.
//
// Both of this package's "I had to write a function instead" workarounds were this mistake.
@test
private a_named_struct_value_is_a_module_level_val()
    assert(AT_REST == Interaction(0.0, 0.0), "a struct value with a name")
    assert(!AT_REST.hovered(), "usable as an ordinary value")
    assert(!AT_REST.pressed())
end a_named_struct_value_is_a_module_level_val

// ## What a key does, which is a pure function and is tested as one
//
// **The hard half of a text field is not the caret bar, it is what backspace does to a selection
// that was dragged right-to-left across a multi-byte character**, and none of that needs a canvas, a
// font or a frame. `edit.sysl` is written so that the rules can be put through a hundred cases here
// and the view below has only geometry left to get wrong.

private caret(at: usize) -> Selection = Selection(at, at)

@test
private typing_inserts_at_the_caret()
    val e = apply("ac", caret(1), typed("b"))

    assert(e.text == "abc", s"'${e.text}'")
    assert(e.sel == caret(2), "and the caret is after what was typed")
end typing_inserts_at_the_caret

@test
private typing_replaces_what_is_selected()
    val e = apply("hello", Selection(1, 4), typed("i"))

    assert(e.text == "hio", s"'${e.text}'")
    assert(e.sel == caret(2), "the caret is after the insertion, not after the old selection")
end typing_replaces_what_is_selected

// **Text arrives as a run rather than a character**, which is what a paste and a dead key both are.
@test
private a_whole_run_arrives_at_once()
    val e = apply("", caret(0), typed("a paste"))

    assert(e.text == "a paste" && e.sel == caret(7), s"'${e.text}' at ${e.sel.head}")
end a_whole_run_arrives_at_once

// **A multi-byte character is deleted whole**, which is the reason nothing here ever adds one to an
// offset: `é` is two bytes, and a backspace that took one of them would leave a string that is not
// text at all.
@test
private backspace_takes_a_whole_character()
    val e = apply("hé", caret(3), press(Key.Backspace))

    assert(e.text == "h", s"'${e.text}'")
    assert(e.sel == caret(1), "and the caret came back two bytes, which is one character")
end backspace_takes_a_whole_character

@test
private backspace_with_a_selection_takes_the_selection()
    val e = apply("hello", Selection(4, 1), press(Key.Backspace))

    assert(e.text == "ho", "a selection dragged right-to-left deletes the same as one dragged left")
    assert(e.sel == caret(1))
end backspace_with_a_selection_takes_the_selection

@test
private backspace_at_the_start_does_nothing()
    val e = apply("hi", caret(0), press(Key.Backspace))

    assert(e.text == "hi" && e.sel == caret(0), "there is nothing before the start")
end backspace_at_the_start_does_nothing

@test
private delete_takes_the_character_after()
    val e = apply("héllo", caret(1), press(Key.Delete))

    assert(e.text == "hllo", s"'${e.text}'")
    assert(e.sel == caret(1), "and the caret did not move, because what went was in front of it")
end delete_takes_the_character_after

@test
private delete_at_the_end_does_nothing()
    val e = apply("hi", caret(2), press(Key.Delete))

    assert(e.text == "hi" && e.sel == caret(2))
end delete_at_the_end_does_nothing

// The arrows move by characters and stop at the ends rather than wrapping.
@test
private the_arrows_move_by_characters()
    assert(apply("hé", caret(1), press(Key.Right)).sel == caret(3), "over a two-byte character")
    assert(apply("hé", caret(3), press(Key.Left)).sel == caret(1), "and back over it")
    assert(apply("hi", caret(2), press(Key.Right)).sel == caret(2), "the end is the end")
    assert(apply("hi", caret(0), press(Key.Left)).sel == caret(0), "and the start is the start")
end the_arrows_move_by_characters

// **A left arrow over a selection puts the caret before it rather than moving as well**, which is
// what every other editor does and what a person selecting a word and pressing left means.
@test
private an_arrow_over_a_selection_collapses_it()
    assert(apply("hello", Selection(1, 4), press(Key.Left)).sel == caret(1), "to the left-hand end")
    assert(apply("hello", Selection(4, 1), press(Key.Right)).sel == caret(4), "and to the other")
end an_arrow_over_a_selection_collapses_it

// Shift keeps the anchor, which is the whole of what makes a selection out of a motion.
@test
private shift_extends_rather_than_moves()
    val e = apply("hello", caret(2), Press(Key.Right, true, false))

    assert(e.sel == Selection(2, 3), s"anchor ${e.sel.anchor} head ${e.sel.head}")

    val f = apply("hello", e.sel, Press(Key.Right, true, false))

    assert(f.sel == Selection(2, 4), "and the anchor stayed where the selection began")
end shift_extends_rather_than_moves

// Control moves by words: back over any spaces, then over the word itself.
@test
private control_moves_by_words()
    val s = "one two  three"

    assert(apply(s, caret(14), Press(Key.Left, false, true)).sel == caret(9), "to 'three'")
    assert(apply(s, caret(9), Press(Key.Left, false, true)).sel == caret(4), "over two spaces to 'two'")
    assert(apply(s, caret(0), Press(Key.Right, false, true)).sel == caret(3), "to the end of 'one'")
    assert(apply(s, caret(3), Press(Key.Right, false, true)).sel == caret(7), "and of 'two'")
    assert(apply(s, caret(0), Press(Key.Left, false, true)).sel == caret(0), "the start still stops it")
end control_moves_by_words

// In one line, home and end are the whole run; in several, they are the line -- and control widens
// them back out to the whole run again.
@test
private home_and_end_mean_the_line_or_the_run()
    val s = "ab\ncdef"

    assert(apply(s, caret(5), press(Key.Home)).sel == caret(0), "one line: the start of the run")
    assert(apply(s, caret(5), press(Key.Home), true).sel == caret(3), "several: the start of the line")
    assert(apply(s, caret(1), press(Key.End), true).sel == caret(2), "up to the newline, not past it")
    assert(apply(s, caret(1), press(Key.End)).sel == caret(7), "and the end of the run in one line")
    assert(apply(s, caret(5), Press(Key.Home, false, true), true).sel == caret(0), "control widens it")
end home_and_end_mean_the_line_or_the_run

// **`Enter` is the one key whose meaning is the difference between the two views**, which is why
// `apply` takes `multiline` rather than there being two of it.
@test
private enter_is_a_newline_only_where_there_are_lines()
    assert(apply("ab", caret(1), press(Key.Enter)).text == "ab", "a field swallows it")
    assert(apply("ab", caret(1), press(Key.Enter), true).text == "a\nb", "an area breaks the line")
end enter_is_a_newline_only_where_there_are_lines

// Up and down keep the column, and a shorter line takes the caret to its end rather than past it.
@test
private up_and_down_keep_the_column()
    val s = "abcd\nxy\nlonger"

    assert(apply(s, caret(3), press(Key.Down), true).sel == caret(7), "column 3 on a two-long line")
    assert(apply(s, caret(7), press(Key.Down), true).sel == caret(10), "and back out on a long one")
    assert(apply(s, caret(10), press(Key.Up), true).sel == caret(7), "up onto the short one")
    assert(apply(s, caret(2), press(Key.Up), true).sel == caret(0), "above the first line is the start")
    assert(apply(s, caret(12), press(Key.Down), true).sel == caret(14), "below the last is the end")
    assert(apply(s, caret(2), press(Key.Up)).sel == caret(2), "and neither moves in a field")
end up_and_down_keep_the_column

// **Tab and escape belong to the application**: a field that swallowed them is one nothing could
// ever tab out of.
@test
private a_field_does_not_swallow_tab_or_escape()
    assert(apply("ab", caret(1), press(Key.Tab)).text == "ab")
    assert(apply("ab", caret(1), press(Key.Tab)).sel == caret(1), "and it did not move the caret")
    assert(apply("ab", caret(1), press(Key.Escape)).sel == caret(1))
end a_field_does_not_swallow_tab_or_escape

// A whole frame's keys, in the order they arrived, which is how quick typing and a paste split
// across two events both come out right.
@test
private a_frames_keys_are_applied_in_order()
    var b: Buf[Press] = buf()

    b.push(typed("a"))
    b.push(typed("b"))
    b.push(press(Key.Left))
    b.push(typed("c"))

    val e = apply_all("", nothing_selected(), b.view())

    assert(e.text == "acb", s"'${e.text}'")
    assert(e.sel == caret(2))
end a_frames_keys_are_applied_in_order

// **A selection outlives the text it was made in**, so every edit is bounded against the string
// rather than trusting the offsets it was handed.
@test
private a_stale_selection_cannot_slice_past_the_end()
    val e = apply("hi", Selection(40, 99), typed("!"))

    assert(e.text == "hi!", s"'${e.text}'")
    assert(e.sel == caret(3))
end a_stale_selection_cannot_slice_past_the_end

// ## The field itself, which is geometry and a routing rule
//
// **The keyboard is the one thing a rectangle cannot key**, so these tests are as much about focus
// arriving in the right place as about what is drawn: a press anywhere blurs, whatever the press was
// inside takes it back while it paints, and a field that is not the focused one draws no caret and
// consumes no key however many are waiting.

private val FIELD: Rect = Rect(0, 0, 200, 28)

// The frame every field draws before anything else: a ground, and a border that says whether the
// keyboard is here.
private frame(focused: bool) -> string =
    s"fill 0,0 200x28 #${dark().ground} r${dark().radius}\n" +
    (if focused then s"stroke 0,0 200x28 #${dark().primary} w2 r${dark().radius}\n"
     else s"stroke 0,0 200x28 #${dark().edge} w1 r${dark().radius}\n")

// A field nobody is typing in is its border and its text, clipped to the inside so that a run longer
// than the box is cut off rather than drawn through the border.
@test
private an_idle_field_draws_its_text_inside_its_border()
    val t = signal("hi")

    assert_paints(text_field(t, 1), Size(200, 200), FIELD,
                  frame(false) +
                  "clip 6,6 188x16\n" +
                  "text 6,6 188x16 'hi'\n" +
                  "unclip\n" +
                  "hit 0,0 200x28\n")
end an_idle_field_draws_its_text_inside_its_border

// It measures to the width it was asked for and to as many lines as it holds, plus the padding.
@test
private a_field_is_one_line_tall_and_an_area_is_as_many_as_it_was_asked_for()
    val t = signal("")

    assert(measured(text_field(t, 1), Size(500, 500)) == Size(200, 28), "one 16px line and 6px a side")
    assert(measured(text_field(t, 1, 320), Size(500, 500)) == Size(320, 28), "the width is the caller's")
    assert(measured(text_area(t, 1, 320, 3), Size(500, 500)) == Size(320, 60), "three of them")
end a_field_is_one_line_tall_and_an_area_is_as_many_as_it_was_asked_for

// A press inside takes the keyboard, and the border says so.
@test
private a_press_inside_takes_the_keyboard()
    val t = signal("hi")
    val v = text_field(t, 1)
    var c = recorder()

    assert(c.focus() == NOBODY, "nobody has it to start with")

    c.point(20, 14, true)
    v.paint(&c, FIELD)

    assert(c.focus() == 1, "and the field it was pressed in has it")

    c.ops = buf()
    c.point(20, 14, false)
    v.paint(&c, FIELD)

    // **The press placed the caret where it landed**, which is past the end of a two-character run
    // at twenty pixels in -- a click puts the caret at the character it points at, and past the last
    // one is the end.
    assert(c.dump() == frame(true) +
                       "clip 6,6 188x16\n" +
                       "text 6,6 188x16 'hi'\n" +
                       s"fill 22,6 2x16 #${dark().ink}\n" +
                       "unclip\n" +
                       "hit 0,0 200x28\n",
           s"a focused field carries a caret:\n${c.dump()}")
end a_press_inside_takes_the_keyboard

// **And a press anywhere else gives it up, without any view knowing another view was clicked.**
@test
private a_press_anywhere_else_gives_the_keyboard_up()
    val t = signal("hi")
    val v = text_field(t, 1)
    var c = recorder()

    c.point(20, 14, true)
    v.paint(&c, FIELD)

    // **End the frame the press belongs to.** A tap is reported for exactly one frame and `render`
    // is what ends one; a test that paints by hand says so itself.
    c.keys_done()
    c.point(20, 14, false)

    assert(c.focus() == 1, "it has the keyboard")

    c.point(300, 300, true)

    assert(c.focus() == NOBODY, "and the press outside took it away")

    v.paint(&c, FIELD)

    assert(c.focus() == NOBODY, "the paint that followed did not take it back")
end a_press_anywhere_else_gives_the_keyboard_up

// Typing reaches the signal, and it reaches it on the frame it was typed rather than the one after.
@test
private typing_into_a_focused_field_writes_the_signal()
    val t = signal("")
    val v = text_field(t, 1)
    var c = recorder()

    c.point(20, 14, true)
    v.paint(&c, FIELD)

    // **End the frame the press belongs to.** A tap is reported for exactly one frame and `render`
    // is what ends one; a test that paints by hand says so itself.
    c.keys_done()
    c.point(20, 14, false)

    c.key(typed("ab"))
    c.ops = buf()
    v.paint(&c, FIELD)

    assert(t.read() == "ab", s"'${t.read()}'")
    assert(c.dump() == frame(true) +
                       "clip 6,6 188x16\n" +
                       "text 6,6 188x16 'ab'\n" +
                       s"fill 22,6 2x16 #${dark().ink}\n" +
                       "unclip\n" +
                       "hit 0,0 200x28\n",
           s"the frame that typed it shows it, with the caret after it:\n${c.dump()}")
end typing_into_a_focused_field_writes_the_signal

// **A field that is not the focused one consumes nothing**, however many keys are waiting -- which
// is the whole point of routing them by an id rather than by geometry.
@test
private an_unfocused_field_takes_none_of_the_keys()
    val mine = signal("")
    val theirs = signal("")
    var c = recorder()

    c.point(20, 14, true)
    text_field(mine, 1).paint(&c, FIELD)
    c.keys_done()
    c.point(20, 14, false)

    c.key(typed("ab"))
    text_field(mine, 1).paint(&c, FIELD)
    text_field(theirs, 2).paint(&c, FIELD)

    assert(mine.read() == "ab", "the focused field took them")
    assert(theirs.read() == "", "and the other one did not, though it was painted the same frame")
end an_unfocused_field_takes_none_of_the_keys

// A selection is painted behind the text, on however many lines it covers.
@test
private a_selection_is_painted_behind_the_field_text()
    val t = signal("hello")
    val v = text_field(t, 1)
    var c = recorder()

    c.point(20, 14, true)
    v.paint(&c, FIELD)

    // **End the frame the press belongs to.** A tap is reported for exactly one frame and `render`
    // is what ends one; a test that paints by hand says so itself.
    c.keys_done()
    c.point(20, 14, false)
    c.edit(Selection(1, 3))
    c.ops = buf()
    v.paint(&c, FIELD)

    assert(c.dump() == frame(true) +
                       "clip 6,6 188x16\n" +
                       s"fill 14,6 16x16 #${dark().selection}\n" +
                       "text 6,6 188x16 'hello'\n" +
                       s"fill 30,6 2x16 #${dark().ink}\n" +
                       "unclip\n" +
                       "hit 0,0 200x28\n",
           s"two characters of highlight and the caret at the far end:\n${c.dump()}")
end a_selection_is_painted_behind_the_field_text

// Dragging selects, from where the press began to where the pointer is now -- `select.sysl`'s
// stateless rule, arriving in a view that can also be typed into.
@test
private dragging_in_a_field_selects()
    val t = signal("hello")
    val v = text_field(t, 1)
    var c = recorder()

    c.point(14, 14, true)
    v.paint(&c, FIELD)

    c.point(38, 14, true)
    v.paint(&c, FIELD)

    assert(c.editing() == Selection(1, 4), s"${c.editing().anchor} to ${c.editing().head}")
    assert(t.read() == "hello", "and nothing was typed")
end dragging_in_a_field_selects

// The placeholder shows in an empty field nobody is typing in, and goes the moment one is.
@test
private a_hint_shows_in_an_empty_unfocused_field()
    val t = signal("")

    assert_paints(text_field(t, 1, 200, "your name"), Size(200, 200), FIELD,
                  frame(false) +
                  "clip 6,6 188x16\n" +
                  s"ink #${mix(dark().ink, dark().ground, 55)}\n" +
                  "text 6,6 188x16 'your name'\n" +
                  "unink\n" +
                  "unclip\n" +
                  "hit 0,0 200x28\n")
end a_hint_shows_in_an_empty_unfocused_field

// **The run scrolls to keep the caret in view and remembers nothing about how far**: the offset is a
// function of where the caret is, so text replaced from underneath cannot leave a field scrolled
// past the end of what it now holds.
@test
private a_long_run_scrolls_to_keep_the_caret_in_view()
    val t = signal("")
    val v = text_field(t, 1, 100)
    val box = Rect(0, 0, 100, 28)
    var c = recorder()

    c.point(20, 14, true)
    v.paint(&c, box)
    c.keys_done()
    c.point(20, 14, false)

    // Eighty-eight pixels of room and eight pixels a character: the twelfth character is the first
    // that does not fit.
    c.key(typed("abcdefghijklmno"))
    c.ops = buf()
    v.paint(&c, box)

    assert(t.read() == "abcdefghijklmno")
    assert(c.dump() == s"fill 0,0 100x28 #${dark().ground} r6\n" +
                       s"stroke 0,0 100x28 #${dark().primary} w2 r6\n" +
                       "clip 6,6 88x16\n" +
                       "text -28,6 122x16 'abcdefghijklmno'\n" +
                       s"fill 92,6 2x16 #${dark().ink}\n" +
                       "unclip\n" +
                       "hit 0,0 100x28\n",
           s"the run is pulled left and the caret sits at the right-hand edge:\n${c.dump()}")
end a_long_run_scrolls_to_keep_the_caret_in_view

// ## The area, which is the same view with lines

private val AREA: Rect = Rect(0, 0, 320, 60)

@test
private an_area_draws_a_line_at_a_time()
    val t = signal("one\ntwo\nthree")

    assert_paints(text_area(t, 1, 320, 3), Size(400, 400), AREA,
                  s"fill 0,0 320x60 #${dark().ground} r6\n" +
                  s"stroke 0,0 320x60 #${dark().edge} w1 r6\n" +
                  "clip 6,6 308x48\n" +
                  "text 6,6 308x16 'one'\n" +
                  "text 6,22 308x16 'two'\n" +
                  "text 6,38 308x16 'three'\n" +
                  "unclip\n" +
                  "hit 0,0 320x60\n")
end an_area_draws_a_line_at_a_time

// **A selection spanning three lines paints on all three**, which is why the paint is an overlap
// rather than a comparison.
@test
private a_selection_across_lines_paints_on_each_of_them()
    val t = signal("one\ntwo\nthree")
    val v = text_area(t, 1, 320, 3)
    var c = recorder()

    c.point(20, 14, true)
    v.paint(&c, AREA)

    // **End the frame the press belongs to.** A tap is reported for exactly one frame and `render`
    // is what ends one; a test that paints by hand says so itself.
    c.keys_done()
    c.point(20, 14, false)
    c.edit(Selection(1, 10))
    c.ops = buf()
    v.paint(&c, AREA)

    assert(c.dump() == s"fill 0,0 320x60 #${dark().ground} r6\n" +
                       s"stroke 0,0 320x60 #${dark().primary} w2 r6\n" +
                       "clip 6,6 308x48\n" +
                       s"fill 14,6 16x16 #${dark().selection}\n" +
                       "text 6,6 308x16 'one'\n" +
                       s"fill 6,22 24x16 #${dark().selection}\n" +
                       "text 6,22 308x16 'two'\n" +
                       s"fill 6,38 16x16 #${dark().selection}\n" +
                       "text 6,38 308x16 'three'\n" +
                       s"fill 22,38 2x16 #${dark().ink}\n" +
                       "unclip\n" +
                       "hit 0,0 320x60\n",
           s"the middle line is covered end to end:\n${c.dump()}")
end a_selection_across_lines_paints_on_each_of_them

// Enter breaks the line in an area, and the caret lands on the new one.
@test
private enter_in_an_area_starts_a_line()
    val t = signal("")
    val v = text_area(t, 1, 320, 3)
    var c = recorder()

    c.point(20, 14, true)
    v.paint(&c, AREA)

    // **End the frame the press belongs to.** A tap is reported for exactly one frame and `render`
    // is what ends one; a test that paints by hand says so itself.
    c.keys_done()
    c.point(20, 14, false)

    c.key(typed("a"))
    c.key(press(Key.Enter))
    c.key(typed("b"))
    c.ops = buf()
    v.paint(&c, AREA)

    assert(t.read() == "a\nb", s"'${t.read()}'")
    assert(c.dump() == s"fill 0,0 320x60 #${dark().ground} r6\n" +
                       s"stroke 0,0 320x60 #${dark().primary} w2 r6\n" +
                       "clip 6,6 308x48\n" +
                       "text 6,6 308x16 'a'\n" +
                       "text 6,22 308x16 'b'\n" +
                       s"fill 14,22 2x16 #${dark().ink}\n" +
                       "unclip\n" +
                       "hit 0,0 320x60\n",
           s"two lines and the caret on the second:\n${c.dump()}")
end enter_in_an_area_starts_a_line

// A click lands on the character it points at, on the line it points at.
@test
private a_click_in_an_area_lands_on_the_line_it_points_at()
    val t = signal("one\ntwo\nthree")
    val v = text_area(t, 1, 320, 3)
    var c = recorder()

    c.point(6 + 12, 6 + 20, true)
    v.paint(&c, AREA)

    assert(c.editing() == Selection(6, 6), s"the second line, past the middle of 'w': ${c.editing().head}")
end a_click_in_an_area_lands_on_the_line_it_points_at

// And an area scrolls a line at a time to keep the caret's line in view.
@test
private an_area_scrolls_to_the_caret_line()
    val t = signal("1\n2\n3\n4\n5")
    val v = text_area(t, 1, 320, 3)
    var c = recorder()

    c.point(20, 14, true)
    v.paint(&c, AREA)

    // **End the frame the press belongs to.** A tap is reported for exactly one frame and `render`
    // is what ends one; a test that paints by hand says so itself.
    c.keys_done()
    c.point(20, 14, false)
    c.edit(Selection(8, 8))
    c.ops = buf()
    v.paint(&c, AREA)

    assert(c.dump() == s"fill 0,0 320x60 #${dark().ground} r6\n" +
                       s"stroke 0,0 320x60 #${dark().primary} w2 r6\n" +
                       "clip 6,6 308x48\n" +
                       "text 6,6 308x16 '3'\n" +
                       "text 6,22 308x16 '4'\n" +
                       "text 6,38 308x16 '5'\n" +
                       s"fill 6,38 2x16 #${dark().ink}\n" +
                       "unclip\n" +
                       "hit 0,0 320x60\n",
           s"the first two lines have scrolled off the top:\n${c.dump()}")
end an_area_scrolls_to_the_caret_line

// **A tap is a press and a release between two frames, and a field has to be focusable by one.**
// This is the phone bug written down: focus was taken by a field noticing `pressed(r)` while it
// painted, which works with a mouse because a mouse press lasts for several frames -- and a thumb's
// does not, so on a touch screen no field could ever be typed into.
@test
private a_tap_too_quick_to_span_a_frame_still_focuses()
    val t = signal("hello")
    val v = text_field(t, 1)
    var c = recorder()

    c.point(30, 14, true)
    c.point(30, 14, false)

    assert(!c.pressed(FIELD), "the finger has already gone by the time anything is painted")

    render(v, &c, FIELD)

    assert(c.focus() == 1, "and the field still took the keyboard")
    assert(c.editing() == Selection(3, 3), "with the caret where the finger landed")
end a_tap_too_quick_to_span_a_frame_still_focuses

// And the frame after it is not a second tap: a press is reported once and `render` is what ends it.
@test
private a_tap_is_reported_for_one_frame_only()
    val t = signal("hello")
    val v = text_field(t, 1)
    var c = recorder()

    c.point(30, 14, true)
    c.point(30, 14, false)
    render(v, &c, FIELD)

    c.edit(Selection(0, 0))
    render(v, &c, FIELD)

    assert(c.editing() == Selection(0, 0), "the caret was not put back where the tap was")
    assert(c.focus() == 1, "and the focus is still where the tap left it")
end a_tap_is_reported_for_one_frame_only

// A tap outside blurs, which is the other half and needs no view to know anything.
@test
private a_tap_outside_puts_the_keyboard_away()
    val t = signal("hello")
    val v = text_field(t, 1)
    var c = recorder()

    c.point(30, 14, true)
    c.point(30, 14, false)
    render(v, &c, FIELD)

    assert(c.focus() == 1)

    c.point(400, 400, true)
    c.point(400, 400, false)
    render(v, &c, FIELD)

    assert(c.focus() == NOBODY, "a tap that landed nowhere near it still took the keyboard away")
end a_tap_outside_puts_the_keyboard_away

// **A key belongs to exactly one frame**, and `render` is what says where a frame ends -- which is
// the regression this pins: clearing them in `tick` threw away the keys of the frame about to be
// painted, because a frame loop polls its events before it ticks its clock.
@test
private a_frame_forgets_its_keys_when_it_ends()
    val t = signal("")
    val v = text_field(t, 1)
    var c = recorder()

    c.point(20, 14, true)
    render(v, &c, FIELD)
    c.point(20, 14, false)

    c.key(typed("a"))
    render(v, &c, FIELD)

    assert(t.read() == "a", "the frame the key arrived in typed it")

    render(v, &c, FIELD)

    assert(t.read() == "a", s"and the frame after did not type it again: '${t.read()}'")
end a_frame_forgets_its_keys_when_it_ends

// ## The clip stack, which is the thing a transform got wrong
//
// **A backend answered `visible` by asking PlutoVG for its clip extents, which are in device space.**
// Scaled by a phone's density, a table compared its rows against pixels nearly three times larger
// and drew one row in eight. Neither backend asks anybody now: the stack below is kept in the
// coordinates views are painted in, so there is no transform for it to disagree with.

@test
private nothing_clipped_shows_everything()
    var k = clips()

    assert(k.shows(Rect(0, 0, 10, 10)), "with nothing pushed, everything is reachable")
    assert(k.depth() == 0)
end nothing_clipped_shows_everything

@test
private a_clip_hides_what_falls_outside_it()
    var k = clips()

    k.push(Rect(0, 100, 200, 100))

    assert(k.shows(Rect(0, 150, 20, 20)), "inside")
    assert(k.shows(Rect(0, 90, 20, 20)), "straddling the top edge")
    assert(!k.shows(Rect(0, 0, 20, 20)), "well above it")
    assert(!k.shows(Rect(0, 200, 20, 20)), "and touching the bottom edge is not overlapping it")
end a_clip_hides_what_falls_outside_it

// **A nested clip is intersected with the one below it as it is pushed**, so the innermost entry is
// the whole answer and nothing has to walk the stack.
@test
private a_nested_clip_is_the_intersection()
    var k = clips()

    k.push(Rect(0, 0, 200, 200))
    k.push(Rect(100, 0, 200, 200))

    assert(!k.shows(Rect(0, 0, 50, 50)), "the left half is outside the inner clip")
    assert(k.shows(Rect(120, 0, 50, 50)), "and the part both of them hold is not")

    k.pop()

    assert(k.shows(Rect(0, 0, 50, 50)), "and popping the inner one brings it back")
    assert(k.depth() == 1)
end a_nested_clip_is_the_intersection

// Two clips that do not touch leave nothing, which needs no special case: an empty rectangle
// overlaps nothing at all.
@test
private clips_that_do_not_touch_show_nothing()
    var k = clips()

    k.push(Rect(0, 0, 50, 50))
    k.push(Rect(100, 100, 50, 50))

    assert(!k.shows(Rect(0, 0, 50, 50)))
    assert(!k.shows(Rect(100, 100, 50, 50)), "not even what the inner one names")
end clips_that_do_not_touch_show_nothing

// ## Pictures
//
// **A picture is the fourth thing a canvas can draw**, and the three fits are where the interesting
// mistakes are: the two that keep the aspect differ by a single comparison, and getting it the wrong
// way round produces a plausible picture in the wrong place rather than a crash.

// A four-by-two picture, which is the shape that makes every fit below come out a different size.
private wide_picture() -> &Image = Image(plutovg.surface(4, 2).unwrap())

@test
private a_picture_measures_to_its_own_pixels()
    val img = wide_picture()

    assert(measured(image(img), Size(500, 500)) == Size(4, 2), "its natural size is its pixel size")
    assert(measured(image_sized(img, 60, 40), Size(500, 500)) == Size(60, 40), "or the caller's")
end a_picture_measures_to_its_own_pixels

// Stretch fills the rectangle exactly, aspect and all.
@test
private stretch_fills_the_rectangle()
    assert_paints(image(wide_picture(), Fit.Stretch), Size(200, 200), Rect(0, 0, 100, 100),
                  "image 0,0 100x100 of 4x2\n")
end stretch_fills_the_rectangle

// **Contain keeps the aspect and leaves a gap**, centred in what it was given: a picture twice as
// wide as it is tall, in a square, is bound by the width and half as tall as the box.
@test
private contain_keeps_the_aspect_and_centres_the_gap()
    assert_paints(image(wide_picture(), Fit.Contain), Size(200, 200), Rect(0, 0, 100, 100),
                  "image 0,25 100x50 of 4x2\n")
end contain_keeps_the_aspect_and_centres_the_gap

// **Cover is the same comparison the other way round**, so the same picture in the same square is
// bound by the height, twice as wide as the box, and clipped to it.
@test
private cover_keeps_the_aspect_and_crops()
    assert_paints(image(wide_picture(), Fit.Cover), Size(200, 200), Rect(0, 0, 100, 100),
                  "clip 0,0 100x100\n" +
                  "image -50,0 200x100 of 4x2\n" +
                  "unclip\n")
end cover_keeps_the_aspect_and_crops

// **Only `Cover` clips**, because it is the only fit that puts pixels outside the rectangle it was
// given -- and a picture bleeding over its neighbours is the failure a person dislikes most.
@test
private the_other_two_fits_do_not_clip()
    var c = recorder()

    image(wide_picture(), Fit.Contain).paint(&c, Rect(0, 0, 100, 100))
    image(wide_picture(), Fit.Stretch).paint(&c, Rect(0, 0, 100, 100))

    assert(!c.dump().contains("clip"), s"nothing was clipped:\n${c.dump()}")
end the_other_two_fits_do_not_clip

// A tall box is the other side of both comparisons, which is what says the arithmetic is not simply
// agreeing with itself.
@test
private a_tall_box_binds_the_other_way()
    assert_paints(image(wide_picture(), Fit.Contain), Size(200, 200), Rect(0, 0, 40, 100),
                  "image 0,40 40x20 of 4x2\n")
    assert_paints(image(wide_picture(), Fit.Cover), Size(200, 200), Rect(0, 0, 40, 100),
                  "clip 0,0 40x100\n" +
                  "image -80,0 200x100 of 4x2\n" +
                  "unclip\n")
end a_tall_box_binds_the_other_way

// Rounded corners reach the backend, which is what makes an avatar a parameter rather than a feature.
@test
private a_picture_can_have_rounded_corners()
    assert_paints(image_sized(wide_picture(), 40, 40, Fit.Stretch, 8), Size(200, 200),
                  Rect(0, 0, 40, 40), "image 0,0 40x40 of 4x2 r8\n")
end a_picture_can_have_rounded_corners

// A picture that could not be read is a `None` rather than a handle to nothing, and every way of
// failing answers the same way -- there is nothing a caller would do differently between them.
@test
private a_picture_that_is_not_there_is_none()
    assert(load_image("no-such-picture.png").is_none())

    var rubbish: [8]u8

    for i in 0..<8 do rubbish[i] = u8(i)

    assert(image_from_data(rubbish[..]).is_none(), "and bytes that are not an image")
end a_picture_that_is_not_there_is_none

// -- text sizes --------------------------------------------------------------------------------------

// The recorder's font is eight by sixteen at a size of sixteen, so doubling the size doubles both.
@test
private a_sized_run_measures_in_proportion()
    assert(measured(text("E2"), Size(200, 200)) == Size(16, 16), "the base: eight a byte, sixteen tall")
    assert(measured(text("E2").font_size(32.0), Size(200, 200)) == Size(32, 32), "twice the size")
    assert(measured(text("E2").font_size(64.0), Size(200, 200)) == Size(64, 64), "four times")
end a_sized_run_measures_in_proportion

// **Innermost wins, and a sibling after the subtree is back at the base** -- the two halves of a
// stack, and the second is the one a missing pop breaks.
@test
private a_nested_size_wins_and_the_next_sibling_is_back_at_the_base()
    assert(measured(text("a").font_size(32.0).font_size(8.0), Size(200, 200)) == Size(16, 32),
           "the inner 32 rather than the outer 8")

    var c = recorder()

    column([text("big").font_size(32.0), text("b")]).paint(&c, Rect(0, 0, 200, 200))

    val d = c.dump()

    assert(d.contains("'big' @32"), s"the run inside is drawn at its size:\n${d}")
    assert(d.contains("'b'\n"), s"the sibling after it is drawn at the base:\n${d}")
end a_nested_size_wins_and_the_next_sibling_is_back_at_the_base

// **A size changes where things go, so it has to reach `measure` as well as `paint`.** A big note
// name beside a unit: the row is as tall as the big one, and the unit starts where the big one's
// sized width ends and sits centred on its height. Measured at the base and painted at the size,
// the unit would overlap the note.
@test
private a_sized_subtree_is_laid_out_by_the_size_it_is_painted_at()
    val v = row([text("E").font_size(64.0), text("Hz")])

    assert(measured(v, Size(200, 200)) == Size(48, 64), "thirty-two wide and sixty-four tall, plus two bytes")

    var c = recorder()

    v.paint(&c, Rect(0, 0, 48, 64))

    val d = c.dump()

    assert(d.contains("text 0,0 32x64 'E' @64\n"), s"the note, at its own metrics:\n${d}")
    assert(d.contains("text 32,24 16x16 'Hz'\n"), s"the unit after it, centred, at the base:\n${d}")
end a_sized_subtree_is_laid_out_by_the_size_it_is_painted_at

// A named style is the theme's multiple of the canvas's base, resolved while the tree is drawn.
@test
private a_text_style_is_the_themes_multiple_of_the_base()
    assert(measured(text("ab").text_style(.Display), Size(200, 200)) == Size(40, 40), "two and a half")
    assert(measured(text("ab").text_style(.Title), Size(200, 200)) == Size(24, 24), "one and a half")
    assert(measured(text("ab").text_style(.Body), Size(200, 200)) == Size(16, 16), "the base itself")
    assert(measured(text("ab").text_style(.Caption), Size(200, 200)) == Size(12, 13), "four fifths")

    var c = recorder(size = 20.0)

    text("T").text_style(.Title).paint(&c, Rect(0, 0, 100, 100))

    assert(c.dump().contains("'T' @30"), s"a title over a base of twenty is thirty:\n${c.dump()}")
end a_text_style_is_the_themes_multiple_of_the_base

// **The style names a role and the theme decides its size**, so a restyle moves it -- which is the
// whole difference from `font_size`.
@test
private a_text_style_follows_a_theme_change()
    val v = text("ab").text_style(.Title).restyle(t -> t with { text = t.text with { title = 2.0 } })

    assert(measured(v, Size(200, 200)) == Size(32, 32), "the restyled title is twice the base")
end a_text_style_follows_a_theme_change

// **A tree that never asks for a size records exactly as it did before there were sizes**, and so
// does one that asks for the size already in force.
@test
private a_default_sized_tree_records_as_it_always_did()
    val plain = column([text("one"), row([text("two"), text("three")], 4)], 2)

    assert_paints(plain, Size(200, 200), Rect(0, 0, 200, 200),
                  "text 0,0 200x16 'one'\ntext 0,18 24x16 'two'\ntext 28,18 40x16 'three'\n")
    assert_paints(plain.font_size(16.0), Size(200, 200), Rect(0, 0, 200, 200),
                  "text 0,0 200x16 'one'\ntext 0,18 24x16 'two'\ntext 28,18 40x16 'three'\n")
    assert_paints(plain.text_style(.Body), Size(200, 200), Rect(0, 0, 200, 200),
                  "text 0,0 200x16 'one'\ntext 0,18 24x16 'two'\ntext 28,18 40x16 'three'\n")
end a_default_sized_tree_records_as_it_always_did

// **An overlay is painted at the size in force where it was raised**, the third piece of styling an
// overlay carries -- painted after the tree, it would otherwise come out at the root's size.
@test
private an_overlay_keeps_the_size_it_was_raised_at()
    val open = signal(true)
    var c = recorder()

    render(text("menu").popover(open, text("one")).font_size(32.0), &c, Rect(0, 0, 200, 200))

    assert(c.dump().contains("'one' @32"), s"the menu is drawn at its anchor's size:\n${c.dump()}")
end an_overlay_keeps_the_size_it_was_raised_at

// **The real backend remembers a run's width per size, and this is the test that says so.** Its
// cache was keyed on the string alone while a canvas had one size; keyed that way still, the word
// measured at sixty would answer for the same word at fifteen, and the other way round.
//
// **It needs a real face, which is the one thing every other test here avoids**, so it takes the
// first of the fonts the demo looks for -- and fails rather than passing over nothing when the
// machine has none of them.
@test
private the_real_backend_measures_each_size_by_its_own_metrics()
    val found = ["/System/Library/Fonts/Supplemental/Arial.ttf",
                 "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf"]
    var face: Option[&plutovg.Font] = None

    for i in 0..<found.len
        if face.is_none() then face = plutovg.font(found[i])

    assert(face.is_some(), "a face to measure with")

    var c = pluto_canvas(plutovg.canvas(plutovg.surface(64, 64).unwrap()).unwrap(), face.unwrap(), 15.0)

    val small = c.text_size("E2")

    c.push_font_size(60.0)

    val big = c.text_size("E2")

    assert(c.font_size() == 60.0 && c.base_font_size() == 15.0, "the size in force and the base")
    assert(c.text_x("E2", 2) == big.w, "the caret agrees with the measurement at the size in force")
    assert(big.w >= 3 * small.w && big.h >= 3 * small.h,
           s"four times the size is far bigger: ${small.w}x${small.h} against ${big.w}x${big.h}")

    c.pop_font_size()

    assert(c.text_size("E2") == small, "back at the base, the base's own width answers")
    assert(c.font_size() == 15.0, "and the base is in force again")
end the_real_backend_measures_each_size_by_its_own_metrics
